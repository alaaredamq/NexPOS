<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Cloud</RootNamespace>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sync\Sync.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <!--
        Server settings (admin login, public address, database connection) travel with every publish, from Cloud/deploy/cloud.settings.json,
        which you create from cloud.settings.json.example and which git ignores. It is published to the site root as cloud.settings.json.
        It is deliberately NOT in the project folder itself, so dotnet run and the tests never pick it up and cannot touch your real database.
    -->
    <ItemGroup>
        <Content Remove="deploy\**" />
        <None Remove="deploy\**" />
        <Content Include="deploy\cloud.settings.json" Condition="Exists('deploy\cloud.settings.json')"
                 Link="cloud.settings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
        Stop a publish to the server (any publish profile: Web Deploy, FTP, folder) when the settings file is missing.
        Without it the site starts on an empty SQLite database and the owner sign-in breaks.
        Plain "dotnet publish" (Docker) has no profile and is not stopped. Pass -p:AllowMissingCloudSettings=true to publish anyway.
    -->
    <Target Name="RequireCloudSettings" BeforeTargets="PrepareForPublish"
            Condition="'$(PublishProfile)' != '' And '$(PublishProfile)' != 'Default' And '$(AllowMissingCloudSettings)' != 'true' And !Exists('$(MSBuildProjectDirectory)\deploy\cloud.settings.json')">
        <Error Text="Cloud\deploy\cloud.settings.json is missing, so this publish would ship without the database connection and admin login. Copy Cloud\deploy\cloud.settings.json.example to Cloud\deploy\cloud.settings.json, fill it in, and publish again." />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>

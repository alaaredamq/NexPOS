<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Cloud</RootNamespace>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sync\Sync.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <!--
        Server settings (admin login, public address, database connection) live in cloud.settings.json in each server's site root, and
        each server has its own (coduos.com is live, nexpos.tryasp.net is the test site). A publish NEVER contains one, so it can never
        overwrite a server's settings with another server's. Make it once on a new server from Cloud/deploy/cloud.settings.json.example;
        https://<site>/healthz then says settingsFileFound: true.
    -->
    <ItemGroup>
        <Content Remove="deploy\**" />
        <None Remove="deploy\**" />
        <Content Remove="cloud.settings.json" />
        <None Remove="cloud.settings.json" />
    </ItemGroup>
    <!-- Web Deploy: leave the server's cloud.settings.json alone even if "remove additional files" is ever switched on. -->
    <ItemGroup>
        <MsDeploySkipRules Include="KeepServerCloudSettings">
            <ObjectName>filePath</ObjectName>
            <AbsolutePath>\\cloud\.settings\.json$</AbsolutePath>
        </MsDeploySkipRules>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>

@{
    var bare = ViewData["Bare"] as bool? == true;
    var nav = ViewData["Nav"] as string;
    var flash = ViewContext.TempData["Flash"] as string;
    var user = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Coduo POS Cloud</title>
    <link rel="icon" href="~/cloud-icon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/cloud.css" asp-append-version="true" />
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    @* The Coduo Cloud mark, "for dark" colours from coduo-cloud-brand-kit/mark/svg. *@
    <symbol id="i-mark" viewBox="-138 -146 276 276"><g transform="scale(3)"><g transform="translate(-1.12 5) scale(1.12)"><path d="M-20 18A14 14 0 0 1 -20.97 -9.97A19 19 0 0 1 16.43 -13.6A16 16 0 0 1 20 18Z" fill="none" stroke="#6D8DF0" stroke-width="7.143" stroke-linejoin="round"/></g><circle cx="-9.5" cy="1.64" r="5.5" fill="#3DDBCB"/><circle cx="9.5" cy="1.64" r="5.5" fill="#3DDBCB"/></g></symbol>
    <symbol id="i-store" viewBox="0 0 24 24"><path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-out" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></symbol>
    <symbol id="i-chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></symbol>
    <symbol id="i-back" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></symbol>
    <symbol id="i-link" viewBox="0 0 24 24"><path d="M10 13a5 5 0 007.5.5l3-3a5 5 0 00-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 00-7.5-.5l-3 3a5 5 0 007 7l1.7-1.7"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 4L2.8 19.5h18.4z"/><path d="M12 10v4.5M12 17.2v.1"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></symbol>
    <symbol id="i-key" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3L21 2M17 6l3 3M14 9l2.5 2.5"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
</svg>

@if (bare)
{
    @RenderBody()
}
else
{
    <div class="shell">
        <aside class="rail">
            <a class="brand" href="/admin" aria-label="Coduo Cloud, clients">
                <svg class="mark" aria-hidden="true"><use href="#i-mark"/></svg>
                <span><b>Coduo</b><span>Cloud</span></span>
            </a>
            <nav aria-label="Main">
                <a href="/admin" aria-current="@(nav == "clients" ? "page" : null)"><svg class="icon"><use href="#i-store"/></svg><span class="t">Clients</span></a>
                <a href="/admin/Licenses" aria-current="@(nav == "licences" ? "page" : null)"><svg class="icon"><use href="#i-key"/></svg><span class="t">Licences</span></a>
                <a href="/admin/Finance" aria-current="@(nav == "finance" ? "page" : null)"><svg class="icon"><use href="#i-chart"/></svg><span class="t">Finance</span></a>
                <a href="/admin/Clients/Create" aria-current="@(nav == "new" ? "page" : null)"><svg class="icon"><use href="#i-plus"/></svg><span class="t">New client</span></a>
            </nav>
            <a class="ext" href="/owner" target="_blank" rel="noopener"><svg class="icon"><use href="#i-link"/></svg><span class="t">Owner website</span></a>
            <div class="who">
                <span class="avatar" aria-hidden="true">@(user.Length > 0 ? user[..1] : "?")</span>
                <span class="who-name">@user<small>Provider</small></span>
                <form method="post" asp-page="/Account/Login" asp-page-handler="Logout">
                    <button type="submit" aria-label="Sign out" title="Sign out"><svg class="icon"><use href="#i-out"/></svg></button>
                </form>
            </div>
        </aside>
        <main id="main">
            @RenderBody()
        </main>
    </div>
}

<div class="toasts" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(flash))
    {
        <div class="toast" data-flash><svg class="icon" style="color:var(--tag)"><use href="#i-check"/></svg><span>@flash</span></div>
    }
</div>

<dialog class="confirm" id="confirm" aria-labelledby="confirm-title">
    <h3 id="confirm-title">Are you sure?</h3>
    <p id="confirm-text" class="muted"></p>
    <div class="row">
        <button type="button" class="btn secondary" data-no>Cancel</button>
        <button type="button" class="btn danger" data-yes>Confirm</button>
    </div>
</dialog>

<script src="~/cloud.js" asp-append-version="true"></script>
</body>
</html>

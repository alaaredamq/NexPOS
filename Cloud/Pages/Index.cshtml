@page
@model IndexModel
@{
    ViewData["Title"] = "Clients";
    ViewData["Nav"] = "clients";
}

<div class="page-head">
    <div>
        <h1>Clients</h1>
        <p class="sub">@Model.Summary</p>
    </div>
    <a class="btn" href="/Clients/Create"><svg class="icon"><use href="#i-plus"/></svg>New client</a>
</div>

@if (Model.Rows.Count > 0)
{
    var cells = Model.Overall.Cells;
    var maxContacts = cells.Max(c => c.Contacts);
    var top = maxContacts <= 4 ? 4 : (int)Math.Ceiling(maxContacts / 4.0) * 4;
    var planTotal = Math.Max(1, Model.Rows.Count);
    <div class="g">
        <section class="card s8" aria-labelledby="h-contact">
            <div class="ph">
                <h2 id="h-contact">Shops in contact</h2>
                <span class="pill @(Model.Connected == Model.Rows.Count ? "ok" : "warn")">@Model.Overall.LitHours of the last 24 hours had contact</span>
            </div>
            <div class="big">@Model.Connected <span class="of">of @Model.Rows.Count clients</span></div>
            <p class="muted" style="margin:6px 0 0">have a shop PC connected and sending data.</p>
            <div class="chart" dir="ltr" role="img" aria-label="Contacts from all shops in each of the last 24 hours">
                <div class="yax">
                    @foreach (var v in new[] { 0, top / 2, top }) { <span style="bottom:@((v * 100.0 / top).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">@v</span> }
                </div>
                <div class="plot">
                    @foreach (var v in new[] { 0, top / 2, top }) { <div class="gl" style="bottom:@((v * 100.0 / top).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div> }
                    <div class="cols">
                        @for (var i = 0; i < cells.Count; i++)
                        {
                            var h = (cells[i].Contacts * 100.0 / top).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                            <div class="col">@if (cells[i].Contacts > 0) { <div class="bar @(i == cells.Count - 1 ? "now" : "")" style="height:@h%"></div> }</div>
                        }
                    </div>
                </div>
                <div class="xl">
                    @for (var i = 0; i < cells.Count; i++) { <span>@(Fmt.Local(cells[i].HourUtc).Hour % 3 == 0 ? Fmt.Local(cells[i].HourUtc).Hour.ToString("00") : "")</span> }
                </div>
            </div>
        </section>
        <section class="card s4" aria-labelledby="h-plans">
            <div class="ph"><h2 id="h-plans">Online plans</h2></div>
            <div class="stack" role="img" aria-label="Plans: @Model.PlansActive active, @Model.PlansEnding ending soon, @Model.PlansEnded ended">
                <i style="width:@((Model.PlansActive * 100.0 / planTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--data)"></i>
                <i style="width:@((Model.PlansEnding * 100.0 / planTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:#e0a526"></i>
                <i style="width:@((Model.PlansEnded * 100.0 / planTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--bad)"></i>
            </div>
            <div>
                <div class="pr"><span class="sw" style="background:var(--data)"></span><span class="nm">Active</span><span class="am">@Model.PlansActive</span></div>
                <div class="pr"><span class="sw" style="background:#e0a526"></span><span class="nm">Ends within 14 days</span><span class="am">@Model.PlansEnding</span></div>
                <div class="pr"><span class="sw" style="background:var(--bad)"></span><span class="nm">Ended or not started</span><span class="am">@Model.PlansEnded</span></div>
            </div>
            <div class="kv">
                <div><b>@Model.ProductsTotal.ToString("N0")</b><span>products held</span></div>
                <div><b>@Model.OrdersTotal.ToString("N0")</b><span>orders held</span></div>
            </div>
        </section>
    </div>

    @if (Model.Attention.Count > 0)
    {
        <section class="card" aria-labelledby="needs">
            <div class="ph"><h2 id="needs">Needs you</h2><span class="pill warn">@Model.Attention.Count</span></div>
            @foreach (var a in Model.Attention)
            {
                <div class="ai">
                    <span class="ico @(a.Severity == AttentionSeverity.Bad ? "bad" : "warn")"><svg class="icon"><use href="#i-alert"/></svg></span>
                    <div class="tx"><b>@a.Client</b><p>@a.Reason</p></div>
                    <a class="btn sm secondary" href="@a.Href">@a.Action</a>
                </div>
            }
        </section>
    }
}

@if (Model.Rows.Count == 0)
{
    <div class="list"><div class="empty">
        <h3>No clients yet</h3>
        <p>Add the first shop. You get a link to send the owner; they paste it on the shop PC and the shop connects.</p>
        <a class="btn" href="/Clients/Create"><svg class="icon"><use href="#i-plus"/></svg>Add the first client</a>
    </div></div>
}
else
{
    <div class="toolbar">
        <div class="search">
            <svg class="icon"><use href="#i-search"/></svg>
            <input type="text" data-search placeholder="Search clients" aria-label="Search clients" autocomplete="off" />
        </div>
        <div class="chips" role="group" aria-label="Filter clients">
            <button type="button" class="chip" data-chip="all" aria-pressed="true">All<span class="n">@Model.Rows.Count</span></button>
            <button type="button" class="chip" data-chip="connected" aria-pressed="false">Connected<span class="n">@Model.Rows.Count(r => r.Tags.Contains("connected"))</span></button>
            <button type="button" class="chip" data-chip="waiting" aria-pressed="false">Waiting for a link<span class="n">@Model.Rows.Count(r => r.Tags.Contains("waiting"))</span></button>
            <button type="button" class="chip" data-chip="attention" aria-pressed="false">Needs you<span class="n">@Model.Rows.Count(r => r.Tags.Contains("attention"))</span></button>
        </div>
    </div>

    <div class="list" data-list>
        <div class="list-head"><span>Client</span><span>Online plan</span><span>Data</span><span>Last 24 hours</span><span>Last contact</span><span></span></div>
        @foreach (var r in Model.Rows)
        {
            var (tone, label) = Pills.Plan(r.State);
            <a class="item" href="/Clients/Details/@r.Id" data-row data-name="@r.Name.ToLowerInvariant()" data-tags="@string.Join(' ', r.Tags)">
                <span>
                    <span class="name">@r.Name @if (!r.IsActive) { <span class="pill none plain">inactive</span> }</span>
                    <span class="sub">@r.Sub</span>
                </span>
                <span class="plan">
                    <span class="pill @tone">@label</span>
                    <small>@r.PlanNote</small>
                </span>
                <span class="data">
                    @if (r.Products is null)
                    {
                        <small>No data yet</small>
                    }
                    else
                    {
                        <span><b>@r.Products.Value.ToString("N0")</b> products</span>
                        <span><b>@r.Orders!.Value.ToString("N0")</b> orders</span>
                    }
                </span>
                <partial name="_Pulse" model="@(new PulseView(r.Pulse, false, Fmt))" />
                <span class="seen">@r.Seen</span>
                <svg class="icon chev" aria-hidden="true"><use href="#i-chev"/></svg>
            </a>
        }
        <div class="empty" data-none hidden><h3>No match</h3><p>No client matches that search and filter.</p></div>
    </div>
}

@functions {
    public sealed record ClientRow(
        int Id, string Name, bool IsActive, string Sub, SubscriptionState State, string PlanNote,
        PulseData Pulse, string Seen, string[] Tags, long? Products, long? Orders, bool EndingSoon);

    public class IndexModel(ControlDbContext db, MirrorStore mirrors, PortalFormat fmt) : PageModel
    {
        private static readonly string[] CountTables = ["Products", "Orders"];

        public List<ClientRow> Rows { get; private set; } = [];
        public List<AttentionItem> Attention { get; private set; } = [];
        public string Summary { get; private set; } = "";
        public PulseData Overall { get; private set; } = new([]);
        public int Connected { get; private set; }
        public int PlansActive { get; private set; }
        public int PlansEnding { get; private set; }
        public int PlansEnded { get; private set; }
        public long ProductsTotal { get; private set; }
        public long OrdersTotal { get; private set; }

        public async Task OnGetAsync()
        {
            var now = fmt.Now;
            var clients = await db.Clients.AsNoTracking()
                .Include(c => c.Subscription)
                .Include(c => c.Sites).ThenInclude(s => s.Tokens)
                .Include(c => c.Sites).ThenInclude(s => s.EnrollmentCodes)
                .OrderBy(c => c.Name).ToListAsync();

            var since = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0, DateTimeKind.Utc).AddHours(-23);
            var beats = (await db.SiteHeartbeats.AsNoTracking().Where(h => h.Hour >= since).ToListAsync())
                .ToLookup(h => h.SiteId);

            var attention = new List<(AttentionItem Item, int ClientId)>();
            Rows = clients.Select(c =>
            {
                var items = AttentionRules.For(c, now, fmt);
                attention.AddRange(items.Select(i => (i, c.Id)));

                var states = c.Sites.Where(s => !s.IsDisabled).Select(s => SiteInsight.Connection(s, now)).ToList();
                var tags = new List<string>();
                if (states.Contains(ConnectionState.Connected)) tags.Add("connected");
                if (states.Any(s => s is ConnectionState.WaitingForShop or ConnectionState.LinkExpired or ConnectionState.NotLinked) || c.Sites.Count == 0) tags.Add("waiting");
                if (items.Count > 0) tags.Add("attention");

                // A client with several branches is one strip: an hour is lit when any of its branches was heard from.
                var pulse = PulseData.Build(c.Sites.SelectMany(s => beats[s.Id]), now);
                var seenAt = c.Sites.Where(s => s.LastSeenAt != null).Select(s => s.LastSeenAt).DefaultIfEmpty().Max();
                var state = SubscriptionRules.Evaluate(c.Subscription, now);

                // What the cloud holds for the client, summed over its branches. Null until some branch has uploaded.
                long? products = null, orders = null;
                foreach (var s in c.Sites.Where(s => mirrors.Exists(s.Id)))
                {
                    var counts = mirrors.CountRows(s.Id, CountTables);
                    products = (products ?? 0) + counts["Products"];
                    orders = (orders ?? 0) + counts["Orders"];
                }

                var sub = c.Sites.Count switch { 0 => "No branch yet", 1 => "1 branch", var n => $"{n} branches" };
                if (!string.IsNullOrWhiteSpace(c.Phone)) sub += " · " + c.Phone;

                return new ClientRow(c.Id, c.Name, c.IsActive, sub, state,
                    c.Subscription is null ? "" : state is SubscriptionState.Active or SubscriptionState.Grace
                        ? $"ends {fmt.Until(c.Subscription.ExpiresAt)} · {fmt.Day(c.Subscription.ExpiresAt)}"
                        : $"ended {fmt.Day(c.Subscription.ExpiresAt)}",
                    pulse,
                    seenAt is null ? (c.Sites.Count == 0 ? "No branch yet" : "Not connected yet") : fmt.Ago(seenAt),
                    tags.ToArray(), products, orders,
                    state == SubscriptionState.Active && c.Subscription is not null && c.Subscription.ExpiresAt - now < TimeSpan.FromDays(14));
            }).ToList();

            Attention = attention.OrderByDescending(a => a.Item.Severity).ThenBy(a => a.Item.Client).Select(a => a.Item).ToList();
            var connected = Rows.Count(r => r.Tags.Contains("connected"));
            Connected = connected;
            Overall = PulseData.Build(clients.SelectMany(c => c.Sites).SelectMany(x => beats[x.Id]), now);
            PlansEnding = Rows.Count(r => r.State == SubscriptionState.Active && r.EndingSoon);
            PlansActive = Rows.Count(r => r.State is SubscriptionState.Active or SubscriptionState.Grace) - PlansEnding;
            PlansEnded = Rows.Count - PlansActive - PlansEnding;
            ProductsTotal = Rows.Sum(r => r.Products ?? 0);
            OrdersTotal = Rows.Sum(r => r.Orders ?? 0);
            Summary = Rows.Count == 0 ? "Nobody yet."
                : $"{Rows.Count} client{(Rows.Count == 1 ? "" : "s")} · {connected} connected" + (Attention.Count > 0 ? $" · {Attention.Count} need{(Attention.Count == 1 ? "s" : "")} you" : "");
        }
    }
}

@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Client?.Name ?? "Client";
    ViewData["Nav"] = "clients";
}

@if (Model.Client is null)
{
    <div class="list"><div class="empty"><h3>Client not found</h3><a class="btn secondary" href="/admin">Back to clients</a></div></div>
    return;
}

@{
    var sub = Model.Client.Subscription;
    var (planTone, planLabel) = Pills.Plan(Model.State);
    var contact = string.Join(" · ", new[] { Model.Client.Phone, Model.Client.Email }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<div class="page-head">
    <div>
        <a class="crumb" href="/admin"><svg class="icon"><use href="#i-back"/></svg>Clients</a>
        <h1>@Model.Client.Name @if (!Model.Client.IsActive) { <span class="pill none plain" style="vertical-align:middle">inactive</span> }</h1>
        <p class="sub">@(contact.Length > 0 ? contact : "No contact details")</p>
    </div>
</div>

@if (Model.Client.HasOnline)
{
<div class="g">
<section class="card s5" aria-labelledby="plan">
    <h2 id="plan">Online subscription</h2>
    <div class="row" style="justify-content:space-between;align-items:flex-start;gap:20px">
        <div>
            <p style="margin:0 0 4px"><span class="pill @planTone">@planLabel</span></p>
            @if (sub is not null)
            {
                <p class="num" style="font-size:28px;margin:6px 0 0">Ends <b>@Fmt.Day(sub.ExpiresAt)</b></p>
                <p class="muted" style="margin:2px 0 0">
                    @Fmt.Until(sub.ExpiresAt)
                    @if (Model.State == SubscriptionState.Grace) { <text> · in the grace week: data is still accepted until @Fmt.Day(sub.ExpiresAt.AddDays(SubscriptionRules.GraceDays))</text> }
                </p>
            }
            else
            {
                <p style="margin:6px 0 0">No subscription yet. Their shop cannot send data.</p>
            }
        </div>
        <div>
            <p class="muted" style="margin:0 0 6px;font-size:13px;font-weight:600">Add time</p>
            <div class="row">
                @foreach (var months in new[] { 1, 3, 6, 12 })
                {
                    <form method="post" asp-page-handler="Extend" asp-route-id="@Model.Client.Id" asp-route-months="@months">
                        <button type="submit" class="btn secondary">+@months mo</button>
                    </form>
                }
            </div>
            <p class="help">Renewing early keeps the time left. Renewing late starts today. Got paid? <a href="#payments">Record the payment</a>.</p>
        </div>
    </div>
    @if (sub is not null)
    {
        <form method="post" asp-page-handler="@(sub.IsSuspended ? "Resume" : "Suspend")" asp-route-id="@Model.Client.Id"
              data-confirm="@(sub.IsSuspended ? "Their shop will be allowed to send data again." : "Their shop stops sending data to the cloud. It keeps selling, and sends what it saved when you resume.")"
              data-confirm-title="@(sub.IsSuspended ? "Resume Online?" : "Suspend Online?")" data-confirm-yes="@(sub.IsSuspended ? "Resume" : "Suspend")" style="margin-top:6px">
            <button type="submit" class="btn @(sub.IsSuspended ? "secondary" : "danger") sm">@(sub.IsSuspended ? "Resume" : "Suspend")</button>
        </form>
    }
</section>

<section class="card s7" aria-labelledby="branches">
    <h2 id="branches">Branches <span class="count">@Model.Client.Sites.Count</span></h2>
    @if (Model.Client.Sites.Count == 0)
    {
        <p class="muted">No branch yet. Add one for each separate shop that has its own Coduo POS database. Extra PCs in the same shop do not need one.</p>
    }
    @foreach (var site in Model.Client.Sites.OrderBy(x => x.CreatedAt))
    {
        var state = SiteInsight.Connection(site, Model.Now);
        <div class="site-card">
            <div>
                <b>@site.Name</b>
                <span class="pill @SiteInsight.Tone(state)" style="margin-inline-start:8px">@SiteInsight.Label(state)</span>
                @if (site.IsDisabled) { <span class="pill bad">disabled</span> }
                <div class="muted" style="font-size:13px;margin-top:2px">@(site.LastSeenAt is null ? "Never in contact" : "Last contact " + Fmt.Ago(site.LastSeenAt))@(site.MachineId is null ? "" : " · " + site.MachineId)</div>
                <partial name="_Pulse" model="@(new PulseView(PulseData.Build(Model.Beats[site.Id], Model.Now), false, Fmt))" />
            </div>
            <div class="row">
                <a class="btn secondary" href="/admin/Sites/Details/@site.Id">Open</a>
                <form method="post" asp-page="/admin/Sites/Details" asp-page-handler="Remove" asp-route-id="@site.Id"
                      data-confirm-title="Remove @site.Name?" data-confirm-yes="Remove branch"
                      data-confirm="@(state == ConnectionState.Connected ? "This branch is connected. Its cloud copy of the data is deleted for good and it stops syncing. The shop keeps selling and everything stays on its PC. " : "Its cloud copy of the data is deleted for good. ")This cannot be undone.">
                    <button type="submit" class="btn danger">Remove</button>
                </form>
            </div>
        </div>
    }
    <details class="fold" style="margin-top:14px">
        <summary>Add a branch</summary>
        <form method="post" asp-page-handler="AddSite" asp-route-id="@Model.Client.Id">
            <div class="fields2">
                <div>
                    <label for="siteName">Name</label>
                    <input id="siteName" name="SiteName" placeholder="Second shop" required maxlength="200" />
                </div>
                <div>
                    <label for="machineId">Machine ID <span class="opt">(from the shop's License page)</span></label>
                    <input id="machineId" name="MachineId" placeholder="XXXXX-XXXXX-XXXXX-XXXXX" />
                </div>
            </div>
            <p style="margin-top:14px"><button type="submit" class="btn">Add branch</button></p>
        </form>
    </details>
</section>
</div>
}
else
{
    <section class="card" aria-labelledby="h-type">
        <div class="ph">
            <h2 id="h-type">POS only <span class="pill offline plain">offline</span></h2>
            <form method="post" asp-page-handler="Online" asp-route-id="@Model.Client.Id" asp-route-on="true"
                  data-confirm-title="Turn Online on?" data-confirm-yes="Turn on"
                  data-confirm="@(Model.Client.Sites.Count == 0 ? "Their first branch is added, with a connection link to send them." : "Their branches are followed again.")">
                <button type="submit" class="btn secondary sm">They bought Online</button>
            </form>
        </div>
        <p class="muted" style="margin:0">This shop runs Coduo POS on its own PC without the cloud. There is nothing to connect; the portal follows their licence and payments.</p>
    </section>
}

<section class="card" id="licences" aria-labelledby="h-lic">
    <div class="ph">
        <h2 id="h-lic">POS licences <span class="count">@Model.Licenses.Count(r => r.Status != LicenseStatus.Superseded)</span></h2>
        <a class="btn sm" href="/admin/Licenses?client=@Model.Client.Id#issue"><svg class="icon"><use href="#i-key"/></svg>Issue a key</a>
    </div>
    @if (Model.Licenses.Count == 0)
    {
        <p class="muted">No licence on record. Issue their key here, or add one you issued before on the <a href="/admin/Licenses">Licences</a> page.</p>
    }
    else
    {
        <div class="tscroll">
            <table class="t">
                <thead><tr><th>Machine ID</th><th>Licence</th><th>Ends</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Licenses)
                    {
                        var l = row.License;
                        var (lTone, lLabel) = LicenseRules.Pill(row.Status);
                        <tr>
                            <td><span class="mono">@l.MachineId</span><small class="muted d">serial @l.Serial</small></td>
                            <td>@l.Plan · @l.Kind@(l.Seats > 1 ? $" · {l.Seats} PCs" : "")<small class="muted d">issued @l.IssuedOn.ToString("yyyy-MM-dd")</small></td>
                            <td class="nowrap"><span class="pill @lTone">@lLabel</span><small class="muted d">@(LicenseRules.IsTimeLimited(l) ? "ends" : "updates until") @l.ValidUntil.ToString("yyyy-MM-dd")</small></td>
                            <td class="r nowrap">
                                @if (l.KeyText is not null)
                                {
                                    <span class="sr" id="ckey-@l.Id">@l.KeyText</span>
                                    <button type="button" class="btn ghost sm" data-copy="#ckey-@l.Id"><span class="label">Copy key</span></button>
                                }
                                @if (row.Status != LicenseStatus.Superseded) { <a class="btn ghost sm" href="/admin/Licenses?renew=@l.Id#issue">Renew</a> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card" id="payments" aria-labelledby="h-payments">
    <div class="ph">
        <h2 id="h-payments">Payments <span class="count">@Model.Payments.Count</span></h2>
        <a class="btn ghost sm" href="/admin/Finance">Finance</a>
    </div>
    @if (Model.Payments.Count > 0)
    {
        var lastPay = Model.Payments[0];
        <div class="ledger" style="margin-bottom:14px">
            <div><b>@Fmt.Money(Model.Payments.Sum(x => x.Amount))</b><span>collected in all</span></div>
            <div><b>@Fmt.Money(Model.Payments.Where(x => x.ReceivedOn > Fmt.Today.AddYears(-1)).Sum(x => x.Amount))</b><span>in the last 12 months</span></div>
            <div><b>@lastPay.ReceivedOn.ToString("yyyy-MM-dd")</b><span>last payment, @Fmt.Money(lastPay.Amount)</span></div>
        </div>
        <div class="tscroll">
            <table class="t">
                <thead><tr><th>Day</th><th>For</th><th>Paid by</th><th class="r">Amount</th><th></th></tr></thead>
                <tbody>
                    @foreach (var x in Model.Payments.Take(Model.ShowAllPayments ? int.MaxValue : 10))
                    {
                        <tr>
                            <td class="nowrap">@x.ReceivedOn.ToString("yyyy-MM-dd")</td>
                            <td>@x.Purpose@if (!string.IsNullOrEmpty(x.Note)) { <small class="muted d">@x.Note</small> }</td>
                            <td>@x.Method@if (!string.IsNullOrEmpty(x.Reference)) { <small class="muted d">@x.Reference</small> }</td>
                            <td class="r num nowrap">@Fmt.Money(x.Amount)</td>
                            <td class="r">
                                <form method="post" asp-page-handler="DeletePayment" asp-route-id="@Model.Client.Id" asp-route-paymentId="@x.Id"
                                      data-confirm-title="Delete this payment?" data-confirm-yes="Delete"
                                      data-confirm="@Fmt.Money(x.Amount) on @x.ReceivedOn.ToString("yyyy-MM-dd"). It comes off every total.">
                                    <button type="submit" class="btn ghost sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Payments.Count > 10 && !Model.ShowAllPayments)
        {
            <p class="help"><a href="?all=payments#payments">Show all @Model.Payments.Count payments</a></p>
        }
    }
    else
    {
        <p class="muted">Nothing recorded from @Model.Client.Name yet.</p>
    }
    <details class="fold" style="margin-top:14px" open="@(Model.PaymentError is not null)">
        <summary>Record a payment</summary>
        <form method="post" asp-page-handler="Payment" asp-route-id="@Model.Client.Id">
            <partial name="_PaymentFields" model="@(new PaymentFieldsView(Model.Pay, [], Fmt.Today, Model.Client.Id))" />
            @if (Model.PaymentError is not null) { <p class="error" role="alert">@Model.PaymentError</p> }
            <p style="margin:16px 0 0"><button type="submit" class="btn">Record payment</button></p>
        </form>
    </details>
</section>

@if (Model.NewLoginEmail is not null)
{
    <section class="card" aria-labelledby="newlogin" style="border-color:var(--ok)">
        <h2 id="newlogin">Phone login ready: send it to the owner</h2>
        <p class="muted" style="margin-top:0">The password is shown only now. If it is lost, reset it and a new one is made.</p>
        <div class="link" id="new-login-text" style="white-space:pre-line;user-select:all">Sign in with: @Model.NewLoginEmail
Password: @Model.NewLoginPassword</div>
        <ol class="help" style="margin:12px 0 0;padding-inline-start:20px">
            <li>The owner installs the Coduo POS Owner app and signs in with the name and password above.</li>
            <li>The shop's data is encrypted, so the app then asks for the <b>recovery code</b>. The owner finds it on the shop PC: Coduo POS &gt; Settings &gt; Online &gt; Show recovery code.</li>
            <li>They type or paste it once. You never see it and cannot recover it for them.</li>
        </ol>
        <div class="row" style="margin-top:12px">
            <button type="button" class="btn" data-copy="#new-login-text"><svg class="icon"><use href="#i-copy"/></svg><span class="label">Copy</span></button>
            <a class="btn secondary" target="_blank" rel="noopener" href="@Model.NewLoginWhatsApp"><svg class="icon"><use href="#i-send"/></svg>Send on WhatsApp</a>
        </div>
    </section>
}

<section class="card" aria-labelledby="menu">
    <h2 id="menu">Online menu</h2>
    <p class="help">A public page with this shop's products, pictures and prices, shared by link or QR code. Fill it by hand, or link it to a branch so it follows the POS.</p>
    <p><a class="btn secondary" href="/owner/menu.html?client=@Model.Client.Id">Open the menu editor</a></p>
</section>

<section class="card" aria-labelledby="phone">
    <h2 id="phone">Phone logins <span class="count">@Model.Owners.Count</span></h2>
    <p class="muted" style="margin-top:0">What the shop owner types in the Coduo POS phone app or on the owner website (this site, /owner). It is not the till PIN, and it only ever opens this shop. Sales, stock and debts also need the shop's recovery code, typed once on the phone (see the Till page).</p>
    @if (Model.Owners.Count == 0)
    {
        <p class="muted">No phone login yet.</p>
    }
    @foreach (var owner in Model.Owners)
    {
        <div class="site-card">
            <div>
                <b>@owner.Email</b>
                <span class="pill @(owner.IsActive ? "ok" : "none")" style="margin-inline-start:8px">@(owner.IsActive ? "active" : "disabled")</span>
                <span class="pill @(OwnerRoles.NameOf(owner.Can) == "owner" ? "ok" : "none")" style="margin-inline-start:4px" title="@Model.RoleHelp(owner)">@Model.RoleLabel(owner)</span>
                <div class="muted" style="font-size:13px;margin-top:2px">@owner.DisplayName · @(owner.LastSignInAt is null ? "Never signed in" : "Last sign-in " + Fmt.Ago(owner.LastSignInAt))</div>
            </div>
            <div class="row">
                <form method="post" asp-page-handler="SetRole" asp-route-id="@Model.Client.Id" asp-route-ownerId="@owner.Id" class="row"
                      data-confirm="Their phone is signed out so the new limits apply straight away. They sign in again with the same password."
                      data-confirm-title="Change what this login can do?" data-confirm-yes="Change">
                    <select id="role-@owner.Id" name="role" aria-label="Role for @owner.Email" style="width:auto">
                        <option value="owner" selected="@(OwnerRoles.NameOf(owner.Can) == "owner")">Owner</option>
                        <option value="manager" selected="@(OwnerRoles.NameOf(owner.Can) == "manager")">Manager</option>
                        <option value="staff" selected="@(OwnerRoles.NameOf(owner.Can) == "staff")">Staff</option>
                    </select>
                    <button type="submit" class="btn secondary sm">Set role</button>
                </form>
                <form method="post" asp-page-handler="ResetOwner" asp-route-id="@Model.Client.Id" asp-route-ownerId="@owner.Id"
                      data-confirm="A new password is made and the old one stops working. Their phone is signed out."
                      data-confirm-title="Reset this password?" data-confirm-yes="Reset">
                    <button type="submit" class="btn secondary sm">Reset password</button>
                </form>
                <form method="post" asp-page-handler="ToggleOwner" asp-route-id="@Model.Client.Id" asp-route-ownerId="@owner.Id"
                      data-confirm="@(owner.IsActive ? "They can no longer sign in on the phone, and their phone is signed out. The shop is not affected." : "They can sign in on the phone again.")"
                      data-confirm-title="@(owner.IsActive ? "Disable this login?" : "Enable this login?")" data-confirm-yes="@(owner.IsActive ? "Disable" : "Enable")">
                    <button type="submit" class="btn sm @(owner.IsActive ? "danger" : "secondary")">@(owner.IsActive ? "Disable" : "Enable")</button>
                </form>
                <form method="post" asp-page-handler="RemoveOwner" asp-route-id="@Model.Client.Id" asp-route-ownerId="@owner.Id"
                      data-confirm-title="Remove @owner.Email?" data-confirm-yes="Remove login"
                      data-confirm="@owner.Email is signed out of the phone app and can no longer sign in. The shop's data is not touched.">
                    <button type="submit" class="btn sm danger">Remove</button>
                </form>
            </div>
        </div>
    }
    <details class="fold" style="margin-top:14px" open="@(Model.Owners.Count == 0)">
        <summary>Add a phone login</summary>
        <form method="post" asp-page-handler="AddOwner" asp-route-id="@Model.Client.Id">
            <div class="fields2">
                <div>
                    <label for="ownerEmail">Sign-in name <span class="opt">(email, phone number or username)</span></label>
                    <input id="ownerEmail" name="Email" type="text" placeholder="owner@example.com, 03 123 456 or hassan" required maxlength="255"
                           autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="ownerEmailHelp" />
                    <div id="ownerEmailHelp" class="help" style="margin-top:4px">A phone number works with or without the country code.</div>
                </div>
                <div>
                    <label for="ownerName">Name <span class="opt">(shown in the app)</span></label>
                    <input id="ownerName" name="DisplayName" placeholder="Hassan" maxlength="100" autocomplete="off" />
                </div>
            </div>
            <label for="ownerRole">What can they do?</label>
            <select id="ownerRole" name="Role">
                <option value="owner">Owner: everything, including profit and the cash drawer</option>
                <option value="manager">Manager: sales, stock, customers and debts; can add and edit; no profit or cash drawer</option>
                <option value="staff">Staff: sales and stock only, nothing can be changed</option>
            </select>
            <p class="help">Limits are enforced by the cloud: a table a login may not read is never sent, and a change it may not make is never queued. Cost prices live inside the stock data, so only the app hides them from a Manager or Staff login.</p>
            <label for="ownerPassword">Password <span class="opt">(leave empty to make a strong one)</span></label>
            <input id="ownerPassword" name="Password" type="text" minlength="8" maxlength="100" autocomplete="off" />
            <p class="help">At least 8 characters. Shown once after you press Add, so you can send it.</p>
            <p style="margin-top:14px"><button type="submit" class="btn">Add phone login</button></p>
        </form>
    </details>
</section>

<div class="grid2">
    <section class="card" aria-labelledby="details">
        <h2 id="details">Details</h2>
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.Client.Id">
            <label for="name" style="margin-top:0">Shop name</label>
            <input id="name" name="Name" value="@Model.Client.Name" required maxlength="200" />
            <label for="phone">Phone</label>
            <input id="phone" name="Phone" value="@Model.Client.Phone" />
            <label for="email">Email</label>
            <input id="email" name="Email" type="email" value="@Model.Client.Email" />
            <label for="notes">Notes</label>
            <textarea id="notes" name="Notes">@Model.Client.Notes</textarea>
            <p style="margin:16px 0 0"><button type="submit" class="btn">Save changes</button></p>
        </form>
        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@Model.Client.Id" style="margin-top:14px"
              data-confirm="@(Model.Client.IsActive ? "All their branches are blocked from the cloud. Their shop keeps selling." : "Their branches can connect again.")"
              data-confirm-title="@(Model.Client.IsActive ? "Deactivate this client?" : "Reactivate this client?")" data-confirm-yes="@(Model.Client.IsActive ? "Deactivate" : "Reactivate")">
            <button type="submit" class="btn sm @(Model.Client.IsActive ? "danger" : "secondary")">@(Model.Client.IsActive ? "Deactivate client" : "Reactivate client")</button>
        </form>
        @if (Model.Client.HasOnline)
        {
            <form method="post" asp-page-handler="Online" asp-route-id="@Model.Client.Id" asp-route-on="false" style="margin-top:10px"
                  data-confirm-title="Make this client POS only?" data-confirm-yes="POS only"
                  data-confirm="For a shop that stopped using Online. Its branches and cloud data stay; the portal just stops asking about them and its Online plan.">
                <button type="submit" class="btn sm secondary">Make POS only (no Online)</button>
            </form>
        }
        <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Client.Id" style="margin-top:10px"
              data-confirm-title="Remove @Model.Client.Name?" data-confirm-yes="Remove client"
              data-confirm="@(Model.Client.Sites.Count == 0 ? "" : $"This also removes its {Model.Client.Sites.Count} branch{(Model.Client.Sites.Count == 1 ? "" : "es")} and deletes their cloud copy of the data for good. ")The subscription and history go too; its payments stay in Finance. Nothing is deleted at the shop, and it keeps selling. This cannot be undone.">
            <button type="submit" class="btn sm danger">Remove client</button>
        </form>
    </section>

    <section class="card" aria-labelledby="history">
        <h2 id="history">History</h2>
        <ul class="timeline">
            @foreach (var e in Model.Client.Events.OrderByDescending(x => x.At).Take(30))
            {
                <li><time>@Fmt.Clock(e.At)</time><span>@e.Text</span></li>
            }
        </ul>
    </section>
</div>

@functions {
    public class DetailsModel(ControlDbContext db, AdminOperations ops, PortalFormat fmt, FinanceBook book, LicenseBook licenses) : PageModel
    {
        /// <summary>Newest first.</summary>
        public List<Payment> Payments { get; private set; } = [];
        public List<LicenseRow> Licenses { get; private set; } = [];
        public bool ShowAllPayments { get; private set; }
        [BindProperty] public PaymentInput Pay { get; set; } = new();
        public string? PaymentError { get; private set; }

        public Client? Client { get; private set; }
        public SubscriptionState State { get; private set; }
        public DateTime Now => fmt.Now;
        public ILookup<Guid, SiteHeartbeat> Beats { get; private set; } = Array.Empty<SiteHeartbeat>().ToLookup(h => h.SiteId);
        public List<OwnerUser> Owners { get; private set; } = [];

        // A login made a moment ago, handed over once (TempData lives for one request).
        public string? NewLoginEmail { get; private set; }
        public string? NewLoginPassword { get; private set; }
        public string NewLoginWhatsApp => "https://wa.me/?text=" + Uri.EscapeDataString(
            $"Coduo POS app login\nSign in with: {NewLoginEmail}\nPassword: {NewLoginPassword}\n\n" +
            "After signing in the app asks for the recovery code. Find it on the shop PC: Coduo POS > Settings > Online > Show recovery code.\n" +
            "بعد تسجيل الدخول سيطلب التطبيق رمز الاسترداد. تجده على جهاز المحل: Coduo POS > الإعدادات > Online > إظهار رمز الاسترداد.");

        private async Task LoadAsync(int id)
        {
            Client = await db.Clients.Include(c => c.Subscription)
                .Include(c => c.Sites).ThenInclude(s => s.Tokens)
                .Include(c => c.Sites).ThenInclude(s => s.EnrollmentCodes)
                .Include(c => c.Events)
                .FirstOrDefaultAsync(c => c.Id == id);
            State = SubscriptionRules.Evaluate(Client?.Subscription, Now);
            Owners = await db.OwnerUsers.AsNoTracking().Where(o => o.ClientId == id).OrderBy(o => o.CreatedAt).ToListAsync();
            Payments = (await db.Payments.AsNoTracking().Where(p => p.ClientId == id).ToListAsync())
                .OrderByDescending(p => p.ReceivedOn).ThenByDescending(p => p.Id).ToList();
            ShowAllPayments = Request.Query["all"] == "payments";
            Licenses = await licenses.ForClientAsync(id);
            NewLoginEmail = TempData["NewLoginEmail"] as string;
            NewLoginPassword = TempData["NewLoginPassword"] as string;

            var since = new DateTime(Now.Year, Now.Month, Now.Day, Now.Hour, 0, 0, DateTimeKind.Utc).AddHours(-23);
            var ids = Client?.Sites.Select(s => s.Id).ToList() ?? [];
            Beats = (await db.SiteHeartbeats.AsNoTracking().Where(h => ids.Contains(h.SiteId) && h.Hour >= since).ToListAsync()).ToLookup(h => h.SiteId);
        }

        public async Task<IActionResult> OnGetAsync(int id)
        {
            await LoadAsync(id);
            return Client is null ? NotFound() : Page();
        }

        public async Task<IActionResult> OnPostPaymentAsync(int id)
        {
            Pay.ClientId = id;
            var (payment, error) = await book.RecordPaymentAsync(Pay, User.Identity?.Name ?? "");
            if (payment is null)
            {
                PaymentError = error;
                await LoadAsync(id);
                return Client is null ? NotFound() : Page();
            }
            this.Flash($"Payment of {fmt.Money(payment.Amount)} recorded");
            return Redirect($"/admin/Clients/Details/{id}#payments");
        }

        public async Task<IActionResult> OnPostDeletePaymentAsync(int id, int paymentId)
        {
            // Only this client's payment: the id in the address names whose page this is.
            if (await db.Payments.AnyAsync(p => p.Id == paymentId && p.ClientId == id) && await book.DeletePaymentAsync(paymentId) is not null)
                this.Flash("Payment deleted");
            return Redirect($"/admin/Clients/Details/{id}#payments");
        }

        /// <summary>Runs a change, turning a refused request into the toast it would show, and comes back to this page.</summary>
        private async Task<IActionResult> DoAsync(int id, Func<Task<object?>> work, string done)
        {
            try
            {
                if (await work() is null) return NotFound();
                this.Flash(done);
            }
            catch (AdminRuleException refused)
            {
                this.Flash(refused.Message.TrimEnd('.'));
            }
            return RedirectToPage(new { id });
        }

        public Task<IActionResult> OnPostSaveAsync(int id, string name, string? phone, string? email, string? notes)
            => DoAsync(id, async () => await ops.UpdateClientAsync(id, name, phone, email, notes), "Changes saved");

        public async Task<IActionResult> OnPostToggleActiveAsync(int id)
        {
            var active = await db.Clients.Where(c => c.Id == id).Select(c => (bool?)c.IsActive).FirstOrDefaultAsync();
            if (active is null) return NotFound();
            return await DoAsync(id, async () => await ops.SetClientActiveAsync(id, !active.Value), active.Value ? "Client deactivated" : "Client reactivated");
        }

        public async Task<IActionResult> OnPostOnlineAsync(int id, bool on)
        {
            var result = await ops.SetOnlineAsync(id, on, ops.BaseUrl(Request));
            if (result is null) return NotFound();
            if (result.Value.Link is { } link)
            {
                // A new branch with its link: the branch page shows it, ready to send.
                TempData["NewLink"] = link.Url;
                TempData["NewLinkExpires"] = link.ExpiresAt.ToString("yyyy-MM-dd");
                this.Flash("Online turned on. Send them the link");
                var siteId = await db.Sites.Where(s => s.ClientId == id).OrderBy(s => s.CreatedAt).Select(s => s.Id).FirstAsync();
                return Redirect($"/admin/Sites/Details/{siteId}");
            }
            this.Flash(on ? "Online turned on" : "Now POS only");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostRemoveAsync(int id)
        {
            var name = await ops.RemoveClientAsync(id);
            if (name is null) return NotFound();
            this.Flash($"{name} removed");
            return Redirect("/admin");
        }

        public async Task<IActionResult> OnPostExtendAsync(int id, int months)
        {
            if (months is < 1 or > AdminOperations.MaxMonths) return RedirectToPage(new { id });
            var sub = await ops.ExtendAsync(id, months);
            if (sub is null) return NotFound();
            this.Flash($"Added {months} month{(months == 1 ? "" : "s")}. Online now ends {sub.ExpiresAt:yyyy-MM-dd}");
            return RedirectToPage(new { id });
        }

        public Task<IActionResult> OnPostSuspendAsync(int id) => DoAsync(id, async () => await ops.SetSuspendedAsync(id, true), "Online suspended");
        public Task<IActionResult> OnPostResumeAsync(int id) => DoAsync(id, async () => await ops.SetSuspendedAsync(id, false), "Online resumed");

        // ---- phone logins (the owner's sign-in to the phone app) ----

        public const int MinOwnerPasswordLength = AdminOperations.MinOwnerPasswordLength;

        private void HandOver(OwnerHandOver handOver)
        {
            TempData["NewLoginEmail"] = handOver.Owner.Email;
            TempData["NewLoginPassword"] = handOver.Password;
        }

        public async Task<IActionResult> OnPostAddOwnerAsync(int id, string? email, string? displayName, string? password, string? role)
        {
            try
            {
                var added = await ops.AddOwnerAsync(id, email, displayName, password, role);
                if (added is null) return NotFound();
                HandOver(added);
                this.Flash("Phone login added");
            }
            catch (AdminRuleException refused)
            {
                this.Flash(refused.Message.TrimEnd('.'));
            }
            return RedirectToPage(new { id });
        }

        public string RoleLabel(OwnerUser owner) => OwnerRoles.NameOf(owner.Can) switch
        {
            "owner" => "Owner",
            "manager" => "Manager",
            "staff" => "Staff",
            _ => "Custom",
        };

        public string RoleHelp(OwnerUser owner) => OwnerRoles.NameOf(owner.Can) switch
        {
            "owner" => "Everything, including profit and the cash drawer",
            "manager" => "Sales, stock, customers and debts; can add and edit; no profit or cash drawer",
            "staff" => "Sales and stock only; nothing can be changed",
            _ => "A custom set of permissions",
        };

        public Task<IActionResult> OnPostSetRoleAsync(int id, int ownerId, string? role)
            => DoAsync(id, async () => await ops.SetOwnerRoleAsync(id, ownerId, role), "Role updated");

        public async Task<IActionResult> OnPostResetOwnerAsync(int id, int ownerId)
        {
            var reset = await ops.ResetOwnerPasswordAsync(id, ownerId);
            if (reset is null) return NotFound();
            HandOver(reset);
            this.Flash("Password reset");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostToggleOwnerAsync(int id, int ownerId)
        {
            var active = await db.OwnerUsers.Where(o => o.Id == ownerId && o.ClientId == id).Select(o => (bool?)o.IsActive).FirstOrDefaultAsync();
            if (active is null) return NotFound();
            return await DoAsync(id, async () => await ops.SetOwnerActiveAsync(id, ownerId, !active.Value),
                active.Value ? "Phone login disabled" : "Phone login enabled");
        }

        public async Task<IActionResult> OnPostRemoveOwnerAsync(int id, int ownerId)
        {
            if (!await ops.RemoveOwnerAsync(id, ownerId)) return NotFound();
            this.Flash("Sign-in removed");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostAddSiteAsync(int id, string siteName, string? machineId)
        {
            if (string.IsNullOrWhiteSpace(siteName)) return RedirectToPage(new { id });
            var site = await ops.AddSiteAsync(id, siteName, machineId);
            if (site is null) return NotFound();
            this.Flash("Branch added. Create its connection link below");
            return Redirect($"/admin/Sites/Details/{site.Id}");
        }
    }
}

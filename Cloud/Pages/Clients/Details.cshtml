@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Client?.Name ?? "Client";
    ViewData["Nav"] = "clients";
}

@if (Model.Client is null)
{
    <div class="list"><div class="empty"><h3>Client not found</h3><a class="btn secondary" href="/">Back to clients</a></div></div>
    return;
}

@{
    var sub = Model.Client.Subscription;
    var (planTone, planLabel) = Pills.Plan(Model.State);
    var contact = string.Join(" · ", new[] { Model.Client.Phone, Model.Client.Email }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<div class="page-head">
    <div>
        <a class="crumb" href="/"><svg class="icon"><use href="#i-back"/></svg>Clients</a>
        <h1>@Model.Client.Name @if (!Model.Client.IsActive) { <span class="pill none plain" style="vertical-align:middle">inactive</span> }</h1>
        <p class="sub">@(contact.Length > 0 ? contact : "No contact details")</p>
    </div>
</div>

<section class="card" aria-labelledby="plan">
    <h2 id="plan">Online subscription</h2>
    <div class="row" style="justify-content:space-between;align-items:flex-start;gap:20px">
        <div>
            <p style="margin:0 0 4px"><span class="pill @planTone">@planLabel</span></p>
            @if (sub is not null)
            {
                <p class="num" style="font-size:28px;margin:6px 0 0">Ends <b>@Fmt.Day(sub.ExpiresAt)</b></p>
                <p class="muted" style="margin:2px 0 0">
                    @Fmt.Until(sub.ExpiresAt)
                    @if (Model.State == SubscriptionState.Grace) { <text> · in the grace week: data is still accepted until @Fmt.Day(sub.ExpiresAt.AddDays(SubscriptionRules.GraceDays))</text> }
                </p>
            }
            else
            {
                <p style="margin:6px 0 0">No subscription yet. Their till cannot send data.</p>
            }
        </div>
        <div>
            <p class="muted" style="margin:0 0 6px;font-size:13px;font-weight:600">Add time</p>
            <div class="row">
                @foreach (var months in new[] { 1, 3, 6, 12 })
                {
                    <form method="post" asp-page-handler="Extend" asp-route-id="@Model.Client.Id" asp-route-months="@months">
                        <button type="submit" class="btn secondary">+@months mo</button>
                    </form>
                }
            </div>
            <p class="help">Renewing early keeps the time left. Renewing late starts today.</p>
        </div>
    </div>
    @if (sub is not null)
    {
        <form method="post" asp-page-handler="@(sub.IsSuspended ? "Resume" : "Suspend")" asp-route-id="@Model.Client.Id"
              data-confirm="@(sub.IsSuspended ? "Their till will be allowed to send data again." : "Their till stops sending data to the cloud. It keeps selling, and sends what it saved when you resume.")"
              data-confirm-title="@(sub.IsSuspended ? "Resume Online?" : "Suspend Online?")" data-confirm-yes="@(sub.IsSuspended ? "Resume" : "Suspend")" style="margin-top:6px">
            <button type="submit" class="btn @(sub.IsSuspended ? "secondary" : "danger") sm">@(sub.IsSuspended ? "Resume" : "Suspend")</button>
        </form>
    }
</section>

<section class="card" aria-labelledby="tills">
    <h2 id="tills">Tills <span class="count">@Model.Client.Sites.Count</span></h2>
    @if (Model.Client.Sites.Count == 0)
    {
        <p class="muted">No till yet. Add one for each shop PC that should connect.</p>
    }
    @foreach (var site in Model.Client.Sites.OrderBy(x => x.CreatedAt))
    {
        var state = SiteInsight.Connection(site, Model.Now);
        <div class="site-card">
            <div>
                <b>@site.Name</b>
                <span class="pill @SiteInsight.Tone(state)" style="margin-inline-start:8px">@SiteInsight.Label(state)</span>
                @if (site.IsDisabled) { <span class="pill bad">disabled</span> }
                <div class="muted" style="font-size:13px;margin-top:2px">@(site.LastSeenAt is null ? "Never in contact" : "Last contact " + Fmt.Ago(site.LastSeenAt))@(site.MachineId is null ? "" : " · " + site.MachineId)</div>
                <partial name="_Pulse" model="@(new PulseView(PulseData.Build(Model.Beats[site.Id], Model.Now), false, Fmt))" />
            </div>
            <a class="btn secondary" href="/Sites/Details/@site.Id">Open</a>
        </div>
    }
    <details class="fold" style="margin-top:14px">
        <summary>Add a till</summary>
        <form method="post" asp-page-handler="AddSite" asp-route-id="@Model.Client.Id">
            <div class="fields2">
                <div>
                    <label for="siteName">Name</label>
                    <input id="siteName" name="SiteName" placeholder="Back till" required maxlength="200" />
                </div>
                <div>
                    <label for="machineId">Machine ID <span class="opt">(from the till's License page)</span></label>
                    <input id="machineId" name="MachineId" placeholder="XXXXX-XXXXX-XXXXX-XXXXX" />
                </div>
            </div>
            <p style="margin-top:14px"><button type="submit" class="btn">Add till</button></p>
        </form>
    </details>
</section>

<div class="grid2">
    <section class="card" aria-labelledby="details">
        <h2 id="details">Details</h2>
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.Client.Id">
            <label for="name" style="margin-top:0">Shop name</label>
            <input id="name" name="Name" value="@Model.Client.Name" required maxlength="200" />
            <label for="phone">Phone</label>
            <input id="phone" name="Phone" value="@Model.Client.Phone" />
            <label for="email">Email</label>
            <input id="email" name="Email" type="email" value="@Model.Client.Email" />
            <label for="notes">Notes</label>
            <textarea id="notes" name="Notes">@Model.Client.Notes</textarea>
            <p style="margin:16px 0 0"><button type="submit" class="btn">Save changes</button></p>
        </form>
        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@Model.Client.Id" style="margin-top:14px"
              data-confirm="@(Model.Client.IsActive ? "All their tills are blocked from the cloud. Their shop keeps selling." : "Their tills can connect again.")"
              data-confirm-title="@(Model.Client.IsActive ? "Deactivate this client?" : "Reactivate this client?")" data-confirm-yes="@(Model.Client.IsActive ? "Deactivate" : "Reactivate")">
            <button type="submit" class="btn sm @(Model.Client.IsActive ? "danger" : "secondary")">@(Model.Client.IsActive ? "Deactivate client" : "Reactivate client")</button>
        </form>
    </section>

    <section class="card" aria-labelledby="history">
        <h2 id="history">History</h2>
        <ul class="timeline">
            @foreach (var e in Model.Client.Events.OrderByDescending(x => x.At).Take(30))
            {
                <li><time>@Fmt.Clock(e.At)</time><span>@e.Text</span></li>
            }
        </ul>
    </section>
</div>

@functions {
    public class DetailsModel(ControlDbContext db, PortalFormat fmt, TimeProvider time) : PageModel
    {
        public Client? Client { get; private set; }
        public SubscriptionState State { get; private set; }
        public DateTime Now => fmt.Now;
        public ILookup<Guid, SiteHeartbeat> Beats { get; private set; } = Array.Empty<SiteHeartbeat>().ToLookup(h => h.SiteId);

        private async Task LoadAsync(int id)
        {
            Client = await db.Clients.Include(c => c.Subscription)
                .Include(c => c.Sites).ThenInclude(s => s.Tokens)
                .Include(c => c.Sites).ThenInclude(s => s.EnrollmentCodes)
                .Include(c => c.Events)
                .FirstOrDefaultAsync(c => c.Id == id);
            State = SubscriptionRules.Evaluate(Client?.Subscription, Now);

            var since = new DateTime(Now.Year, Now.Month, Now.Day, Now.Hour, 0, 0, DateTimeKind.Utc).AddHours(-23);
            var ids = Client?.Sites.Select(s => s.Id).ToList() ?? [];
            Beats = (await db.SiteHeartbeats.AsNoTracking().Where(h => ids.Contains(h.SiteId) && h.Hour >= since).ToListAsync()).ToLookup(h => h.SiteId);
        }

        public async Task<IActionResult> OnGetAsync(int id)
        {
            await LoadAsync(id);
            return Client is null ? NotFound() : Page();
        }

        private async Task<Client?> TrackedAsync(int id)
            => await db.Clients.Include(c => c.Subscription).FirstOrDefaultAsync(c => c.Id == id);

        private void Log(Client client, string text)
            => client.Events.Add(new ClientEvent { At = time.GetUtcNow().UtcDateTime, Text = text });

        public async Task<IActionResult> OnPostSaveAsync(int id, string name, string? phone, string? email, string? notes)
        {
            var client = await TrackedAsync(id);
            if (client is null) return NotFound();
            if (string.IsNullOrWhiteSpace(name)) return RedirectToPage(new { id });
            client.Name = name.Trim(); client.Phone = phone?.Trim(); client.Email = email?.Trim(); client.Notes = notes?.Trim();
            await db.SaveChangesAsync();
            this.Flash("Changes saved");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostToggleActiveAsync(int id)
        {
            var client = await TrackedAsync(id);
            if (client is null) return NotFound();
            client.IsActive = !client.IsActive;
            Log(client, client.IsActive ? "Client reactivated." : "Client deactivated.");
            await db.SaveChangesAsync();
            this.Flash(client.IsActive ? "Client reactivated" : "Client deactivated");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostExtendAsync(int id, int months)
        {
            var client = await TrackedAsync(id);
            if (client is null) return NotFound();
            if (months is < 1 or > 60) return RedirectToPage(new { id });

            var now = time.GetUtcNow().UtcDateTime;
            if (client.Subscription is null)
            {
                client.Subscription = new Subscription { StartsAt = now, ExpiresAt = now.AddMonths(months) };
            }
            else
            {
                client.Subscription.ExpiresAt = SubscriptionRules.ExtendedExpiry(client.Subscription, months, now);
                client.Subscription.IsSuspended = false;
            }
            Log(client, $"Online extended by {months} month(s), now until {client.Subscription.ExpiresAt:yyyy-MM-dd}.");
            await db.SaveChangesAsync();
            this.Flash($"Added {months} month{(months == 1 ? "" : "s")}. Online now ends {client.Subscription.ExpiresAt:yyyy-MM-dd}");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostSuspendAsync(int id) => await SetSuspendedAsync(id, true);
        public async Task<IActionResult> OnPostResumeAsync(int id) => await SetSuspendedAsync(id, false);

        private async Task<IActionResult> SetSuspendedAsync(int id, bool suspended)
        {
            var client = await TrackedAsync(id);
            if (client?.Subscription is null) return NotFound();
            client.Subscription.IsSuspended = suspended;
            Log(client, suspended ? "Online suspended." : "Online resumed.");
            await db.SaveChangesAsync();
            this.Flash(suspended ? "Online suspended" : "Online resumed");
            return RedirectToPage(new { id });
        }

        public async Task<IActionResult> OnPostAddSiteAsync(int id, string siteName, string? machineId)
        {
            var client = await TrackedAsync(id);
            if (client is null) return NotFound();
            if (string.IsNullOrWhiteSpace(siteName)) return RedirectToPage(new { id });

            var site = new Site
            {
                Id = Guid.NewGuid(), ClientId = id, Name = siteName.Trim(),
                MachineId = string.IsNullOrWhiteSpace(machineId) ? null : machineId.Trim(),
                CreatedAt = time.GetUtcNow().UtcDateTime,
            };
            db.Sites.Add(site);
            Log(client, $"Installation '{site.Name}' added.");
            await db.SaveChangesAsync();
            this.Flash("Till added. Create its connection link below");
            return Redirect($"/Sites/Details/{site.Id}");
        }
    }
}

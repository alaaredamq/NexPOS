@page
@model CreateModel
@{
    ViewData["Title"] = "New client";
    ViewData["Nav"] = "new";
}

<div class="page-head">
    <div>
        <a class="crumb" href="/admin"><svg class="icon"><use href="#i-back"/></svg>Clients</a>
        <h1>New client</h1>
        <p class="sub">One form. For POS + Online you get their first branch and the link to send the owner; for POS only, issue their licence key next; for the online menu only, add their phone login next.</p>
    </div>
</div>

<form method="post" class="card" style="max-width:720px">
    <label for="name" style="margin-top:0">Shop name</label>
    <input id="name" name="Name" value="@Model.Name" required maxlength="200" autofocus />
    <div class="fields2">
        <div>
            <label for="phone">Phone <span class="opt">(optional)</span></label>
            <input id="phone" name="Phone" value="@Model.Phone" />
        </div>
        <div>
            <label for="email">Email <span class="opt">(optional)</span></label>
            <input id="email" name="Email" type="email" value="@Model.Email" />
        </div>
    </div>
    <label for="notes">Notes <span class="opt">(optional)</span></label>
    <textarea id="notes" name="Notes">@Model.Notes</textarea>

    <fieldset style="border:0;padding:0;margin:0">
        <legend style="font-size:13px;font-weight:600;color:var(--ink-2);margin:18px 0 5px;padding:0">What they bought</legend>
        <div class="plans three">
            <label>
                <input type="radio" name="Type" value="pos" checked="@(Model.Type == ClientKinds.Pos)" data-type-toggle />
                <span>POS only<small>offline: a licence, nothing to connect</small></span>
            </label>
            <label>
                <input type="radio" name="Type" value="online" checked="@(Model.Type is not (ClientKinds.Pos or ClientKinds.Menu))" data-type-toggle />
                <span>POS + Online<small>a licence, plus cloud copy, phone app and online menu</small></span>
            </label>
            <label>
                <input type="radio" name="Type" value="menu" checked="@(Model.Type == ClientKinds.Menu)" data-type-toggle />
                <span>Online menu only<small>no POS, no licence: just their menu</small></span>
            </label>
        </div>
    </fieldset>

    <fieldset style="border:0;padding:0;margin:14px 0 0" data-online-only>
        <legend style="font-size:13px;font-weight:600;color:var(--ink-2);margin:18px 0 5px;padding:0">Months of Online, from today</legend>
        <div class="plans">
            @foreach (var (months, text) in new[] { (0, "None yet"), (1, "month"), (3, "months"), (6, "months"), (12, "months") })
            {
                <label data-none-yet="@(months == 0 ? "1" : null)">
                    <input type="radio" name="Months" value="@months" checked="@(Model.Months == months)" />
                    <span>@(months == 0 ? "0" : months.ToString())<small>@text</small></span>
                </label>
            }
        </div>
        <p class="help">What they paid for: one Online subscription covers the cloud copy, the phone app and the online menu. When the months run out (plus a grace week) all of it stops, the menu included, until you add more. You can add months any time. With none, nothing works yet.</p>
    </fieldset>

    @if (Model.Error is not null)
    {
        <p class="error" role="alert">@Model.Error</p>
    }
    <p style="margin:22px 0 0"><button type="submit" class="btn" style="min-height:44px;padding:0 22px">Create client</button></p>
</form>

@functions {
    public class CreateModel(AdminOperations ops) : PageModel
    {
        [BindProperty] public string Name { get; set; } = "";
        [BindProperty] public string? Phone { get; set; }
        [BindProperty] public string? Email { get; set; }
        [BindProperty] public string? Notes { get; set; }
        [BindProperty] public int Months { get; set; } = 1;
        /// <summary>One of <see cref="ClientKinds"/>: "online" (POS + Online), "pos" (POS only) or "menu" (online menu only).</summary>
        [BindProperty] public string Type { get; set; } = ClientKinds.Online;
        public string? Error { get; private set; }

        public async Task<IActionResult> OnPostAsync()
        {
            try
            {
                var created = await ops.CreateClientAsync(Name, Phone, Email, Notes, Months, ops.BaseUrl(Request), Type);
                this.Flash("Client created");
                // POS only: their licence key comes next. Online menu only: their phone login, to edit the menu.
                if (created.Site is null) return Redirect($"/admin/Clients/Details/{created.Client.Id}" + (Type == ClientKinds.Menu ? "#phone" : "#licences"));
                TempData["NewLink"] = created.Link;
                TempData["NewLinkExpires"] = created.LinkExpiresAt!.Value.ToString("yyyy-MM-dd");
                return Redirect($"/admin/Sites/Details/{created.Site.Id}");
            }
            catch (AdminRuleException refused)
            {
                Error = refused.Message;
                return Page();
            }
        }
    }
}

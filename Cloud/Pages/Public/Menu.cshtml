@page "/m/{slug}"
@model Cloud.Pages.Public.MenuModel
@using Cloud.Pages.Public
@{
    Layout = null;
    var m = Model.Menu;
    var canonical = $"{Model.Origin}/m/{m.Slug}";
}
<!DOCTYPE html>
<html lang="@(Model.Arabic ? "ar" : "en")" dir="@(Model.Arabic ? "rtl" : "ltr")">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@m.Title · @Model.T("Menu", "القائمة")</title>
<meta name="description" content="@Model.Description">
@if (Model.IsPreview)
{
<meta name="robots" content="noindex">
}
else
{
<link rel="canonical" href="@canonical">
}
<meta property="og:type" content="website">
<meta property="og:title" content="@m.Title">
<meta property="og:description" content="@Model.Description">
<meta property="og:url" content="@canonical">
@if (Model.ShareImage is { } img)
{
<meta property="og:image" content="@img">
}
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#F6F4EF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;600;700;800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@500&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/menu/menu.css" asp-append-version="true">
</head>
<body class="style-@Model.Style" data-items="/m/@m.Slug/items" data-preview="@Model.PreviewKey" data-sold-out="@Model.T("Sold out", "نفد")" data-error="@Model.T("Could not load more. Tap to try again.", "تعذّر تحميل المزيد. اضغط للمحاولة مجدداً.")">
@if (Model.IsPreview)
{
<div class="preview">@Model.T("Preview: only people with this link can see the menu until it is published.", "معاينة: لا يرى القائمة إلا من لديه هذا الرابط حتى تُنشر.")</div>
}
<header class="top">
  <div class="wrap">
    @if (m.LogoFile is not null)
    {
    <img class="logo" src="/m/img/@m.LogoFile" alt="" width="72" height="72">
    }
    <h1 dir="auto">@m.Title</h1>
    @if (m.Tagline is not null)
    {
    <p class="tag" dir="auto">@m.Tagline</p>
    }
  </div>
</header>

@if (Model.Groups.Count == 0)
{
<main class="wrap empty"><p>@Model.T("The menu is being prepared. Please check back soon.", "القائمة قيد التحضير. عُد قريباً.")</p></main>
}
else
{
<nav class="cats" aria-label="@Model.T("Sections", "الأقسام")">
  <div class="wrap">
    <label class="find">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m20 20-4.2-4.2"/></svg>
      <input type="search" id="q" placeholder="@Model.T("Search the menu", "ابحث في القائمة")" autocomplete="off" aria-label="@Model.T("Search the menu", "ابحث في القائمة")">
    </label>
    @if (Model.Groups.Count > 1)
    {
    <div class="chips" id="chips">
      @foreach (var g in Model.Groups)
      {
      <a href="#s@(g.Key)" dir="auto">@(g.Section?.Name ?? Model.T("More", "المزيد"))</a>
      }
    </div>
    }
  </div>
</nav>

<main class="wrap" id="menu">
  @foreach (var g in Model.Groups)
  {
  <section class="sec" id="s@(g.Key)" aria-labelledby="h@(g.Key)">
    <h2 id="h@(g.Key)" dir="auto">@(g.Section?.Name ?? Model.T("More", "المزيد"))</h2>
    <ul>
      @foreach (var i in g.Items)
      {
      var desc = i.Description ?? i.PosDescription;
      <li class="item@(i.IsSoldOut ? " out" : "")">
        @if (i.ImageFile is not null)
        {
        <img class="pic" src="/m/img/@i.ImageFile" alt="" loading="lazy" decoding="async" width="300" height="300">
        }
        else
        {
        <span class="pic blank" aria-hidden="true">@MenuModel.Initial(i.Name)</span>
        }
        <div class="txt">
          <h3 dir="auto">@i.Name</h3>
          @if (desc is not null)
          {
          <p dir="auto">@desc</p>
          }
          <div class="price"><span dir="ltr">@Model.PriceOf(i)</span>@if (i.IsSoldOut)
          {<em>@Model.T("Sold out", "نفد")</em>}</div>
        </div>
      </li>
      }
      @if (g.Remaining > 0)
      {
      @* Sized for what is still to come, so the page length and the section chips are right before it loads. *@
      <li class="more" data-more data-section="@g.Key" data-skip="@g.Items.Count" style="--n:@g.Remaining" aria-hidden="true"></li>
      }
    </ul>
  </section>
  }
  <section class="sec" id="results" hidden aria-live="polite">
    <ul></ul>
    <p class="none" id="none" hidden>@Model.T("Nothing matches that.", "لا شيء يطابق بحثك.")</p>
  </section>
</main>
}

<footer class="foot">
  <div class="wrap">
    @if (m.Note is not null)
    {
    <p class="note" dir="auto">@m.Note</p>
    }
    @* "Coduo", not "Coduo POS": a shop can run its menu without our POS (items added by hand). *@
    <p class="by"><a href="/">@Model.T("Menu by Coduo", "القائمة من Coduo")</a></p>
  </div>
</footer>
<script src="/menu/menu-page.js" asp-append-version="true" defer></script>
</body>
</html>

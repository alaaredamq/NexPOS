<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>LicenseIssuer</AssemblyName>
        <RootNamespace>LicenseIssuer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Common\Common.csproj" />
    </ItemGroup>

    <!-- Records each signed key in the cloud (shared with the other issuer tool). -->
    <ItemGroup>
        <Compile Include="..\Shared\CloudLicenseLog.cs" Link="Shared\CloudLicenseLog.cs" />
    </ItemGroup>

</Project>

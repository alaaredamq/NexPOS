{
  "name": "nexpos-desktop-app",
  "version": "1.1.0",
  "description": "NexPos Desktop Application",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win-portable": "electron-builder --win portable",
    "build:win-installer": "electron-builder --win nsis --x64",
    "publish": "electron-builder --publish=always"
  },
  "keywords": [
    "electron",
    "desktop",
    "pos",
    "nexpos"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.nexpos.desktop",
    "productName": "NexPos",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "assets/**/*"
    ],
    "electronLanguages": ["en-US", "ar"],
    "extraFiles": [
      {
        "from": "publish/app",
        "to": "app",
        "filter": [
          "**/*",
          "!lib*.pdb",
          "!appsettings.Development.json",
          "!libman.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexPos"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}

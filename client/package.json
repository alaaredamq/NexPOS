{
  "name": "nexpos-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "lint": "oxlint && node scripts/check-logical-css.mjs && node scripts/check-i18n-keys.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "node scripts/api-types.mjs",
    "i18n:export": "node scripts/export-locales.mjs",
    "i18n:lint": "node scripts/check-i18n-keys.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3.14.24",
    "i18next": "^26",
    "jsbarcode": "^3.12.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-i18next": "^17",
    "react-router-dom": "^7",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^4"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web [http]",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Web/bin/Debug/net9.0/Web.dll",
      "cwd": "${workspaceFolder}/Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "launchSettingsProfile": "http",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Web [Electron]",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Web/bin/Debug/net9.0/Web.dll",
      "cwd": "${workspaceFolder}/Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ELECTRON_MODE": "true"
      },
      "launchSettingsProfile": "Electron"
    },
    {
      "name": "Cloud",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cloud",
      "program": "${workspaceFolder}/Cloud/bin/Debug/net9.0/Cloud.dll",
      "cwd": "${workspaceFolder}/Cloud",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Cloud__AdminUser": "owner",
        "Cloud__AdminPassword": "dev-password-123"
      },
      "launchSettingsProfile": "Cloud",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(http://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Web + Cloud",
      "configurations": ["Web [http]", "Cloud"],
      "stopAll": true
    }
  ]
}

@model Application.DTOs.Products.CreateProductCategoryRequest

@{
    ViewData["Title"] = "Create Category";
    ViewData["Subtitle"] = "Add a new product category";
}

<!-- Create Category Header -->
<div class="d-flex justify-content-end mb-4">
    <a href="@Url.Action("Index", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Categories
    </a>
</div>

<!-- Create Category Form -->
<div class="row">
    <div class="col-lg-8">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit me-2"></i>
                    Category Information
                </h5>
            </div>
            <div class="products-card-body">
                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Category Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Color" class="form-label">Category Color</label>
                            <input asp-for="Color" type="color" class="form-control form-control-color" value="#0a7b85" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter category description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                            <input asp-for="DisplayOrder" class="form-control" placeholder="0" min="0" />
                            <small class="form-text text-muted">Lower numbers appear first</small>
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label">
                                Category is active
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <a href="@Url.Action("Index", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-teal">
                            <i class="fas fa-save me-2"></i>Create Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Category Guidelines
                </h5>
            </div>
            <div class="products-card-body">
                <div class="guidelines">
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>Use clear, descriptive category names</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>Choose colors that represent the category</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>Set display order for consistent sorting</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>Add descriptions to help users understand</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>Use images to make categories more visual</span>
                    </div>
                </div>

                <hr>

                <div class="category-preview">
                    <h6 class="text-muted mb-3">Category Preview</h6>
                    <div class="preview-category" id="categoryPreview">
                        <div class="preview-color" style="background-color: #0a7b85;"></div>
                        <div class="preview-content">
                            <div class="preview-name" id="previewName">Category Name</div>
                            <div class="preview-description" id="previewDescription">Category description will appear here</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Update category preview in real-time
            function updateCategoryPreview() {
                const name = $('#Name').val() || 'Category Name';
                const description = $('#Description').val() || 'Category description will appear here';
                const color = $('#Color').val() || '#0a7b85';

                $('#previewName').text(name);
                $('#previewDescription').text(description);
                $('#categoryPreview .preview-color').css('background-color', color);
            }

            $('#Name, #Description, #Color').on('input', updateCategoryPreview);

            // Form validation
            $('form').on('submit', function(e) {
                const name = $('#Name').val().trim();
                
                if (!name) {
                    e.preventDefault();
                    appAlert('Category name is required!', 'warning');
                    $('#Name').focus();
                }
            });
        });
    </script>

    <style>
        .guidelines {
            margin-bottom: 20px;
        }

        .guideline-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
            color: var(--gray-600);
        }

        .category-preview {
            background: var(--teal-lighter);
            padding: 16px;
            border-radius: 8px;
        }

        .preview-category {
            display: flex;
            align-items: center;
            background: white;
            border-radius: 8px;
            padding: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .preview-color {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            margin-right: 12px;
            border: 2px solid var(--gray-300);
        }

        .preview-content {
            flex: 1;
        }

        .preview-name {
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 4px;
        }

        .preview-description {
            font-size: 12px;
            color: var(--gray-600);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal-primary);
            box-shadow: 0 0 0 0.2rem rgba(10, 123, 133, 0.25);
        }

        .form-label {
            font-weight: 600;
            color: var(--gray-700);
            margin-bottom: 8px;
        }

        .form-control-color {
            width: 60px;
            height: 38px;
            padding: 4px;
        }
    </style>
}

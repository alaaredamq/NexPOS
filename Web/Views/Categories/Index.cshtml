@{
    ViewData["Title"] = Localizer["Categories"].Value;
    ViewData["Subtitle"] = Localizer["ManageProductCategories"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/receipts.css" />
}

<div class="row mb-4">
    <div class="col-12">
        <div class="page-header">
            <div class="page-title">
                <h3><i class="fas fa-tags me-2"></i>@Localizer["CategoriesManagement"]</h3>
                <p class="text-muted">@Localizer["OrganizeYourProductsIntoCategoriesForBetterManagement"]</p>
            </div>
            <div class="page-actions">
                <a href="@Url.Action("Create", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>@Localizer["AddCategory"]
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Categories Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon categories-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0%</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="totalCategories">0</div>
                <div class="stats-label">@Localizer["TotalCategories"]</div>
                <div class="stats-change">@Localizer["Total"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon active-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0%</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="activeCategories">0</div>
                <div class="stats-label">@Localizer["ActiveCategories"]</div>
                <div class="stats-change">@Localizer["Active"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon inactive-icon">
                    <i class="fas fa-ban"></i>
                </div>
                <div class="stats-trend neutral">
                    <i class="fas fa-minus"></i>
                    <span>0</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="inactiveCategories">0</div>
                <div class="stats-label">@Localizer["InactiveCategories"]</div>
                <div class="stats-change">@Localizer["Inactive"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon products-icon">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="totalProducts">0</div>
                <div class="stats-label">@Localizer["TotalProducts"]</div>
                <div class="stats-change">@Localizer["InAllCategories"]</div>
            </div>
        </div>
    </div>
</div>

<!-- Categories Table -->
<div class="row">
    <div class="col-12">
        <div class="card modern-card">
            <div class="card-header modern-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>@Localizer["CategoriesList"]</h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-light" id="refreshTable">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button type="button" class="btn btn-light" id="exportTable">
                            <i class="fas fa-download"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @await Component.InvokeAsync("DataTable", new Web.Models.Shared.DataTableModel
                {
                    Id = "categoriesTable",
                    Class = "table table-hover modern-table",
                    DataSource = Url.Action("GetCategories", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" }),
                    ServerSide = true,
                    Processing = true,
                    Ordering = true,
                    Searching = true,
                    Paging = true,
                    PageLength = 25,
                    PageLengthMenu = new List<int> { 10, 25, 50, 100 },
                    Language = ViewBag.CurrentLanguage?.ToString() ?? "en",
                    Responsive = true,
                    Columns = new List<Web.Models.Shared.DataTableColumn>
                    {
                        new() { Data = "id", Title = Localizer["ID"].Value, Width = 50, ClassName = "text-center" },
                        new() { Data = "name", Title = Localizer["Name"].Value, Render = "function(data, type, row) { return '<strong>' + data + '</strong>'; }" },
                        new() { Data = "description", Title = Localizer["Description"].Value, Render = "function(data, type, row) { return data || window.categoriesLocalizedStrings.noDescription; }" },
                        new() { Data = "productsCount", Title = Localizer["Products"].Value, ClassName = "text-center", Render = "function(data, type, row) { return data ? '<span class=\"badge bg-primary\">' + data + '</span>' : '<span class=\"text-muted\">0</span>'; }" },
                        new() { 
                            Data = "isActive", 
                            Title = Localizer["Status"].Value, 
                            ClassName = "text-center",
                            Render = "function(data, type, row) { var badgeClass = data ? 'bg-success' : 'bg-secondary'; var statusText = data ? window.categoriesLocalizedStrings.active : window.categoriesLocalizedStrings.inactive; return '<span class=\"badge ' + badgeClass + '\">' + statusText + '</span>'; }"
                        },
                        new() { 
                            Data = "actions", 
                            Title = Localizer["Actions"].Value, 
                            Orderable = false, 
                            Searchable = false, 
                            ClassName = "text-center",
                            Width = 120
                        }
                    },
                    AdditionalOptions = new Dictionary<string, object>
                    {
                        ["order"] = "[[1, 'asc']]",
                        ["drawCallback"] = "function(settings) { updateCategoryStats(); }"
                    }
                })
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="erp-alert erp-alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="erp-alert erp-alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <link href="~/lib/datatables/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    
    <script>
        // Pass localized strings and URLs to the external JS file
        window.categoriesLocalizedStrings = {
            noDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NoDescription"].Value)),
            active: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Active"].Value)),
            inactive: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Inactive"].Value)),
            deleteConfirm: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AreYouSureYouWantToDeleteThisCategoryProductsInThisCategoryWillBeMovedToUncategorized"].Value)),
            deleteError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AnErrorOccurredWhileDeletingTheCategory"].Value))
        };
        
        window.categoriesUrls = {
            getCategoriesUrl: '@Url.Action("GetCategories", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            exportUrl: '@Url.Action("ExportCategories", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            detailsUrl: '@Url.Action("Details", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            editUrl: '@Url.Action("Edit", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            deleteUrl: '@Url.Action("Delete", "Categories", new { lang = ViewBag.CurrentLanguage ?? "en" })'
        };
    </script>
    <script src="~/js/Pages/Categories/Index.js"></script>
}

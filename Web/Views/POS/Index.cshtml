@using System.Globalization
@{
    ViewData["Title"] = Localizer["PointOfSale"].Value;
    Layout = null; // No layout as per POS.md requirements
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.AppName</title>
    <link rel="icon" href="~/branding/favicon?v=@Brand.Version" />

    <!-- local Font (Inter) - same face as the management screens -->
    <link href="/css/Fonts.css" rel="stylesheet" />

    <!-- Bootstrap CSS -->
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/lib/select2/css/select2.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="/lib/font-awesome/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Toastr -->
    <link href="/lib/toastr/toastr.min.css" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link href="/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet">
    <!-- jQuery UI -->
    <link rel="stylesheet" href="/lib/jquery-ui/themes/ui-lightness/jquery-ui.min.css">
    <!-- POS Custom CSS: tokens first, then the one POS stylesheet (all POS styling lives there, not inline) -->
    <link href="~/css/colors.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/pos.css" rel="stylesheet" asp-append-version="true" />

    <!-- RTL CSS for Arabic -->
    @if (isRtl)
    {
        <link href="~/css/rtl.css" rel="stylesheet" asp-append-version="true" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="/js/Plugins/JqueryUI.min.js"></script>
</head>
<body class="pos-page">
    <!-- Top Navigation Bar for POS (in the page flow, so the layout below never needs to know its height) -->
    <nav class="navbar navbar-expand-md navbar-dark pos-nav">
        <div class="container-fluid">
            <!-- Brand/Logo -->
            <a class="navbar-brand" href="@Url.ActionWithCurrentLanguage("Index", "Dashboard")">
                <img src="~/branding/logo?variant=light&v=@Brand.Version" alt="@Brand.AppName" />
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#posNavbarNav"
                    aria-controls="posNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation Menu -->
            <div class="collapse navbar-collapse" id="posNavbarNav">
                <!-- Main Navigation Items -->
                <ul class="navbar-nav pos-nav-start">
                    <!-- Management Link -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.ActionWithCurrentLanguage("Index", "Dashboard")" title="@Localizer["GoToManagement"]">
                            <i class="fas fa-cog" aria-hidden="true"></i>@Localizer["Management"]
                        </a>
                    </li>
                </ul>

                <!-- Right Side Actions -->
                <ul class="navbar-nav">
                    <!-- Cart Summary (stacked layout only) -->
                    <li class="nav-item d-md-none">
                        <a class="nav-link" href="#" onclick="scrollToCart()">
                            <i class="fas fa-shopping-cart" aria-hidden="true"></i>
                            <span class="badge bg-danger rounded-pill" id="nav-cart-count">0</span>
                        </a>
                    </li>

                    <!-- Cash Drawer -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "CashDrawer")" title="@SharedLocalizer["CashDrawer"]">
                            <i class="fas fa-cash-register" aria-hidden="true"></i>
                            <span class="d-none d-lg-inline">@SharedLocalizer["CashDrawer"]</span>
                            <span class="badge bg-success" id="drawerStatusBadge" style="display: none;">@SharedLocalizer["Open"]</span>
                        </a>
                    </li>

                    <!-- Clock -->
                    <li class="nav-item">
                        <div class="clock-display">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            <span id="current-time"></span>
                        </div>
                    </li>

                    <!-- Language Switcher -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-globe" aria-hidden="true"></i>
                            @((ViewBag.CurrentLanguage ?? "en").ToUpper())
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item @((ViewBag.CurrentLanguage ?? "en") == "en" ? "active" : "")"
                                   href="@(ViewBag.EnglishUrl ?? $"/en/{ViewContext.RouteData.Values["Controller"]}/{ViewContext.RouteData.Values["Action"]}")">
                                <i class="fas fa-flag-usa" aria-hidden="true"></i>English
                            </a></li>
                            <li><a class="dropdown-item @((ViewBag.CurrentLanguage ?? "en") == "ar" ? "active" : "")"
                                   href="@(ViewBag.ArabicUrl ?? $"/ar/{ViewContext.RouteData.Values["Controller"]}/{ViewContext.RouteData.Values["Action"]}")">
                                <i class="fas fa-flag" aria-hidden="true"></i>العربية
                            </a></li>
                        </ul>
                    </li>

                    <!-- User Menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle" aria-hidden="true"></i>
                            <span class="nav-user">@User.Identity?.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@SharedLocalizer["Account"]</h6></li>
                            <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("Profile", "Account")">
                                <i class="fas fa-user" aria-hidden="true"></i>@SharedLocalizer["Profile"]
                            </a></li>
                            <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("ChangePassword", "Account")">
                                <i class="fas fa-key" aria-hidden="true"></i>@SharedLocalizer["ChangePin"]
                            </a></li>
                            @if (User.HasClaim("Permission", "Settings.Manage"))
                            {
                                <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("Index", "Settings")"><i class="fas fa-cog" aria-hidden="true"></i>@SharedLocalizer["Settings"]</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt" aria-hidden="true"></i>@SharedLocalizer["Logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @* Licence notice: a strip under the top bar (it used to float over the cart's Hold / Clear / Checkout buttons). *@
    @{ ViewData["LicenseBannerFloating"] = true; }
    @await Html.PartialAsync("_LicenseBanner")

    <main class="pos-container">
        <div class="pos-row">
            <!-- Cart Section -->
            <section class="cart-column" aria-label="@Localizer["ShoppingCart"]">
                <div class="pos-card">
                    <!-- Cart Header -->
                    <header class="pos-card-header">
                        <div class="pos-head">
                            <div class="pos-head-main">
                                <span class="pos-head-icon"><i class="fas fa-shopping-cart" aria-hidden="true"></i></span>
                                <div class="pos-head-text">
                                    <h2 class="pos-head-title">@Localizer["ShoppingCart"]</h2>
                                    <small class="pos-head-sub">@Localizer["ScanProductsToAdd"]</small>
                                </div>
                            </div>
                            <span class="cart-count" id="cart-count">0</span>
                        </div>

                        <!-- Barcode Scanner -->
                        <div class="input-group pos-scan">
                            <span class="input-group-text">
                                <i class="fas fa-barcode" aria-hidden="true"></i>
                            </span>
                            <input type="text" id="barcode-input" placeholder="@Localizer["ScanBarcode"]..." class="form-control"
                                   aria-label="@Localizer["ScanBarcode"]" autofocus autocomplete="off">
                            <button type="button" id="add-product-btn" class="btn" aria-label="@Localizer["AddItem"]">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                            </button>
                        </div>
                    </header>

                    <!-- Cart Items -->
                    <div class="pos-card-body">
                        <div class="cart-items-area" id="cart-items">
                            <!-- Empty State -->
                            <div class="empty-state" id="empty-cart">
                                <i class="fas fa-basket-shopping" aria-hidden="true"></i>
                                <h5>@Localizer["CartIsEmpty"]</h5>
                                <p>@Localizer["StartAddingProductsToBegin"]</p>
                            </div>

                            <!-- Cart Items Table -->
                            <div class="cart-grid d-none" id="cart-table-container">
                                <div class="cart-cols" aria-hidden="true">
                                    <span>@Localizer["Product"]</span>
                                    <span class="cc-qty">@Localizer["Qty"]</span>
                                    <span class="cc-price">@Localizer["Price"]</span>
                                    <span class="cc-del">@Localizer["Del"]</span>
                                </div>
                                <div class="cart-rows" id="cart-table-body"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Cart Footer -->
                    <footer class="pos-card-footer">
                        <!-- Totals -->
                        <div class="totals-section">
                            <div class="total-row total-row-primary">
                                <span class="total-label">@Localizer["TotalUSD"]:</span>
                                <span class="total-figure total-figure-primary fit" id="total-usd">USD 0.00</span>
                            </div>
                            <div class="total-discount" id="total-discount" hidden></div>
                            <div class="total-row total-row-secondary">
                                <span class="total-label">@Localizer["TotalLBP"]:</span>
                                <span class="total-figure total-figure-secondary fit" id="total-lbp">LBP 0</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="cart-actions">
                            <button type="button" id="checkoutButton" class="btn btn-checkout" disabled>
                                <i class="fas fa-cash-register" aria-hidden="true"></i><span>@Localizer["Checkout"]</span>
                            </button>
                            <div class="cart-actions-row">
                                <button type="button" id="holdButton" class="btn btn-custom">
                                    <i class="fas fa-pause" aria-hidden="true"></i><span>@Localizer["Hold"]</span>
                                </button>
                                <button type="button" id="clearCartButton" class="btn btn-custom">
                                    <i class="fas fa-trash" aria-hidden="true"></i><span>@Localizer["Clear"]</span>
                                </button>
                            </div>
                        </div>
                    </footer>
                </div>
            </section>

            <!-- Products Section -->
            <section class="products-column" aria-label="@Localizer["ProductCatalog"]">
                <div class="pos-card products-main-card">
                    <!-- Products Header: title and search share one row, so the grid gets the height -->
                    <header class="pos-card-header catalog-head">
                        <div class="pos-head">
                            <span class="pos-head-icon"><i class="fas fa-table-cells-large" aria-hidden="true"></i></span>
                            <div class="pos-head-text">
                                <h2 class="pos-head-title">@Localizer["ProductCatalog"]</h2>
                                <small class="pos-head-sub">@Localizer["BrowseAndAddProducts"]</small>
                            </div>
                        </div>

                        <!-- Search with Autocomplete -->
                        <div class="search-input d-md-none">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input type="text" id="product-search-mobile" placeholder="@Localizer["Search"]..." class="form-control"
                                   aria-label="@Localizer["Search"]" autocomplete="off">
                        </div>

                        <div class="search-input d-none d-md-block">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input type="text" id="product-search" placeholder="@Localizer["Search"]..." class="form-control"
                                   aria-label="@Localizer["Search"]" autocomplete="off">
                        </div>
                    </header>

                    <!-- Products Grid -->
                    <div class="pos-card-body">
                        <div class="products-grid" id="products-grid">
                            @(await Component.InvokeAsync("MainProductsItemComponent"))
                        </div>
                    </div>

                    <!-- Quick Actions Footer -->
                    <footer class="pos-card-footer quick-actions">
                        <button type="button" id="retrieve-held-cart-btn" class="quick-action-btn qa-info" title="@Localizer["RetrieveHeldCart"]">
                            <i class="fas fa-folder-open" aria-hidden="true"></i>
                            <span class="fw-semibold">@Localizer["Retrieve"]</span>
                            <small>@Localizer["HeldCart"]</small>
                        </button>
                        <button type="button" id="add-manual-item-btn" class="quick-action-btn qa-success" title="@Localizer["AddItemManual"]">
                            <i class="fas fa-plus-circle" aria-hidden="true"></i>
                            <span class="fw-semibold">@Localizer["AddItem"]</span>
                            <small>@Localizer["Manual"]</small>
                        </button>
                        <button type="button" id="discount-btn" class="quick-action-btn qa-warning" title="@Localizer["ApplyDiscount"]">
                            <i class="fas fa-percentage" aria-hidden="true"></i>
                            <span class="fw-semibold">@Localizer["Discount"]</span>
                            <small>@Localizer["Apply"]</small>
                        </button>
                        <button type="button" id="price-check-btn" class="quick-action-btn qa-secondary" title="@Localizer["PriceCheck"]">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <span class="fw-semibold">@Localizer["PriceCheck"]</span>
                            <small>@Localizer["Check"]</small>
                        </button>
                    </footer>
                </div>
            </section>
        </div>
    </main>

    <!-- jQuery -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>

    <!-- Localization must load before other scripts that use it -->
    <script src="~/js/localization.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Lets the checkout/hold dialogs offer "+ New customer" only to users who may create one
        window.__canCreateCustomer = @(Web.Helpers.PermissionHelper.HasPermission(User, Web.Helpers.PermissionHelper.Permissions.Customers_Create) ? "true" : "false");
    </script>
    <!-- POS Custom JS -->
    <script src="~/js/Pages/POS/UnitConverter.js" asp-append-version="true"></script>
    <script src="~/js/Pages/POS/CartItem.js" asp-append-version="true"></script>
    <script src="~/js/Pages/POS/PricePicker.js" asp-append-version="true"></script>
    <script src="~/js/Pages/POS/POS.js" asp-append-version="true"></script>

    <!-- POS Navigation Scripts -->
    <script>
        // Real-time clock
        function updateClock() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour12: true,
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('current-time').textContent = timeString;
        }

        // Update clock every second
        setInterval(updateClock, 1000);
        updateClock(); // Initial call

        // Update notification badge
        function updateNotificationBadge() {
            $.get('/Notifications/GetUnreadCount', function(response) {
                if (response.success && response.count > 0) {
                    $('#notificationBadge').text(response.count).show();
                } else {
                    $('#notificationBadge').hide();
                }
            }).fail(function() {
                // Silently fail if notifications service is not available
            });
        }

        // Update notification badge every 30 seconds
        setInterval(updateNotificationBadge, 30000);
        updateNotificationBadge(); // Initial call

        // Scroll to cart function for mobile
        function scrollToCart() {
            document.querySelector('.cart-column').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // Update cart count in navigation
        function updateNavCartCount(count) {
            document.getElementById('nav-cart-count').textContent = count;
        }

        // Listen for cart updates (this will be called from POS.js)
        document.addEventListener('DOMContentLoaded', function() {
            // Override the cart update function to also update nav count
            const originalUpdateCartDisplay = window.updateCartDisplay;
            if (originalUpdateCartDisplay) {
                window.updateCartDisplay = function() {
                    originalUpdateCartDisplay();
                    // Update navigation cart count
                    const cartCount = document.getElementById('cart-count').textContent;
                    updateNavCartCount(cartCount);
                };
            }
        });

        // Add keyboard shortcuts for quick navigation
        document.addEventListener('keydown', function(e) {
            // Alt + D for Dashboard
            if (e.altKey && e.key === 'd') {
                e.preventDefault();
                window.location.href = '@Url.ActionWithCurrentLanguage("Index", "Dashboard")';
            }
            // Alt + I for Inventory
            else if (e.altKey && e.key === 'i') {
                e.preventDefault();
                window.location.href = '@Url.ActionWithCurrentLanguage("Index", "Inventory")';
            }
            // Alt + O for Orders
            else if (e.altKey && e.key === 'o') {
                e.preventDefault();
                window.location.href = '@Url.ActionWithCurrentLanguage("Index", "Orders")';
            }
            // Alt + P for Products
            else if (e.altKey && e.key === 'p') {
                e.preventDefault();
                window.location.href = '@Url.ActionWithCurrentLanguage("Index", "Products")';
            }
        });

        // Show keyboard shortcuts help
        function showKeyboardShortcuts() {
            Swal.fire({
                title: 'Keyboard Shortcuts',
                html: `
                    <div class="text-start">
                        <p><kbd>Alt</kbd> + <kbd>D</kbd> - Dashboard</p>
                        <p><kbd>Alt</kbd> + <kbd>I</kbd> - Inventory</p>
                        <p><kbd>Alt</kbd> + <kbd>O</kbd> - Orders</p>
                        <p><kbd>Alt</kbd> + <kbd>P</kbd> - Products</p>
                    </div>
                `,
                icon: 'info',
                confirmButtonText: 'Got it!'
            });
        }
    </script>
</body>
</html>

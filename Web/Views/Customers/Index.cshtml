@{
    ViewData["Title"] = Localizer["Customers"].Value;
    ViewData["Subtitle"] = Localizer["ManageCustomerDatabase"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/receipts.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-end flex-wrap gap-2 mb-4">
    <a href="@Url.Action("Create", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>@Localizer["AddCustomer"]
    </a>
</div>

<!-- Customers Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon customers-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0%</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="totalCustomers">0</div>
                <div class="stats-label">@Localizer["TotalCustomers"]</div>
                <div class="stats-change">@Localizer["Total"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon active-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0%</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="activeCustomers">0</div>
                <div class="stats-label">@Localizer["ActiveCustomers"]</div>
                <div class="stats-change">@Localizer["Active"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon categories-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="stats-trend neutral">
                    <i class="fas fa-minus"></i>
                    <span>0</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="companyCustomers">0</div>
                <div class="stats-label">@Localizer["CompanyCustomers"]</div>
                <div class="stats-change">@Localizer["Companies"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card modern-card">
            <div class="stats-header">
                <div class="stats-icon revenue-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stats-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>+0%</span>
                </div>
            </div>
            <div class="stats-content">
                <div class="stats-number" id="totalRevenue">$0</div>
                <div class="stats-label">@Localizer["TotalRevenue"]</div>
                <div class="stats-change">@Localizer["TotalSales"]</div>
            </div>
        </div>
    </div>
</div>

<!-- Customers Table -->
<div class="row">
    <div class="col-12">
        <div class="card modern-card">
            <div class="card-header modern-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>@Localizer["CustomersList"]</h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-light" id="refreshTable">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button type="button" class="btn btn-light" id="exportTable">
                            <i class="fas fa-download"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @await Component.InvokeAsync("DataTable", new Web.Models.Shared.DataTableModel
                {
                    Id = "customersTable",
                    Class = "table table-hover modern-table",
                    DataSource = Url.Action("GetCustomers", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" }),
                    ServerSide = true,
                    Processing = true,
                    Ordering = true,
                    Searching = true,
                    Paging = true,
                    PageLength = 25,
                    PageLengthMenu = new List<int> { 10, 25, 50, 100 },
                    Language = ViewBag.CurrentLanguage?.ToString() ?? "en",
                    Responsive = true,
                    Columns = new List<Web.Models.Shared.DataTableColumn>
                    {
                        new() { Data = "id", Title = Localizer["ID"].Value, Width = 50, ClassName = "text-center" },
                        new() { Data = "name", Title = Localizer["Name"].Value, Render = "function(data, type, row) { return '<strong>' + row.firstName + ' ' + row.lastName + '</strong>'; }" },
                        new() { Data = "email", Title = Localizer["Email"].Value },
                        new() { Data = "phoneNumber", Title = Localizer["Phone"].Value },
                        new() { Data = "address", Title = Localizer["Address"].Value, Render = "function(data, type, row) { return data || window.customersLocalizedStrings.noAddress; }" },
                        new() { Data = "ordersCount", Title = Localizer["Orders"].Value, ClassName = "text-center" },
                        new() { Data = "totalSpent", Title = Localizer["TotalSpent"].Value, ClassName = "text-end", Render = "function(data, type, row) { return data ? '$' + parseFloat(data).toFixed(2) : '$0.00'; }" },
                        new() { 
                            Data = "isActive", 
                            Title = Localizer["Status"].Value, 
                            ClassName = "text-center",
                            Render = "function(data, type, row) { var badgeClass = data ? 'bg-success' : 'bg-secondary'; var statusText = data ? window.customersLocalizedStrings.active : window.customersLocalizedStrings.inactive; return '<span class=\"badge ' + badgeClass + '\">' + statusText + '</span>'; }"
                        },
                        new() {
                            Data = "actions",
                            Title = Localizer["Actions"].Value,
                            Orderable = false,
                            Searchable = false,
                            ClassName = "text-center",
                            Width = 150
                        }
                    },
                    AdditionalOptions = new Dictionary<string, object>
                    {
                        ["order"] = "[[1, 'asc']]",
                        ["drawCallback"] = "function(settings) { updateCustomerStats(); }"
                    }
                })
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="erp-alert erp-alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="erp-alert erp-alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section Scripts {
    
    <script>
        // Pass localized strings and URLs to the external JS file
        window.customersLocalizedStrings = {
            noAddress: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NoAddress"].Value)),
            active: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Active"].Value)),
            inactive: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Inactive"].Value)),
            deleteConfirm: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AreYouSureYouWantToDeleteThisCustomerThisActionCannotBeUndoneAndWillRemoveAllAssociatedData"].Value)),
            deleteError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AnErrorOccurredWhileDeletingTheCustomer"].Value))
        };
        
        window.customersUrls = {
            getCustomersUrl: '@Url.Action("GetCustomers", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            exportUrl: '@Url.Action("ExportCustomers", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            detailsUrl: '@Url.Action("Details", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            editUrl: '@Url.Action("Edit", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            deleteUrl: '@Url.Action("Delete", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })',
            addDebtTransactionUrl: '@Url.Action("AddDebtTransaction", "Customers")'
        };
    </script>
    <script src="~/js/Pages/Customers/DebtDialog.js" asp-append-version="true"></script>
    <script src="~/js/Pages/Customers/Index.js" asp-append-version="true"></script>
}

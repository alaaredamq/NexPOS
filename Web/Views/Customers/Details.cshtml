@model Core.Entities.Users.Customer
@using Core.Enum
@using Core.Entities.Users

@{
    ViewData["Title"] = SharedLocalizer["Cust_DetailsTitle"].Value;
    ViewData["Subtitle"] = $"{Model.FirstName} {Model.LastName}";
    var netDebt = Model.Balance;
    var debtFromCustomer = netDebt > 0 ? netDebt : 0m;
    var debtToCustomer = netDebt < 0 ? -netDebt : 0m;
    var currencyNotation = ViewBag.DefaultCurrencyNotation ?? "$";
    var debtTransactions = ViewBag.DebtTransactions as List<CustomerDebtTransaction> ?? new List<CustomerDebtTransaction>();
}

@Html.AntiForgeryToken()

<!-- Customer Details Header -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="@Url.Action("Edit", "Customers", new { id = Model.Id, lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-teal">
        <i class="fas fa-edit me-2"></i>@SharedLocalizer["Cust_EditTitle"]
    </a>
    <a href="@Url.Action("Index", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>@SharedLocalizer["Cust_BackToCustomers"]
    </a>
</div>

<!-- Customer Details Content -->
<div class="row">
    <!-- Customer Information Card -->
    <div class="col-lg-8">
        <div class="products-table-card mb-4">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-id-card me-2"></i>
                    @SharedLocalizer["Cust_Information"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["First Name"]</label>
                        <p class="detail-value">@Model.FirstName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Last Name"]</label>
                        <p class="detail-value">@Model.LastName</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Email Address"]</label>
                        <p class="detail-value">
                            <a href="mailto:@Model.Email" class="text-teal">
                                <i class="fas fa-envelope me-2"></i>@Model.Email
                            </a>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Phone Number"]</label>
                        <p class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <a href="tel:@Model.PhoneNumber" class="text-teal">
                                    <i class="fas fa-phone me-2"></i>@Model.PhoneNumber
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">@SharedLocalizer["Cust_NotProvided"]</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="detail-label">@SharedLocalizer["Address"]</label>
                        <p class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <i class="fas fa-map-marker-alt me-2"></i>@Model.Address
                                @if (!string.IsNullOrEmpty(Model.City))
                                {
                                    <span>, @Model.City</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Country))
                                {
                                    <span>, @Model.Country</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.PostalCode))
                                {
                                    <span> - @Model.PostalCode</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">@SharedLocalizer["Cust_NoAddress"]</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Status"]</label>
                        <p class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>@SharedLocalizer["Active"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times-circle me-1"></i>@SharedLocalizer["Inactive"]
                                </span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Debt Information Card -->
        <div class="products-table-card mt-4 mb-4">
            <div class="products-card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-money-bill-wave me-2"></i>
                    @SharedLocalizer["Cust_DebtInformation"]
                </h5>
                <button type="button" class="btn btn-sm btn-teal" onclick="openAddDebtTransaction(@Model.Id)">
                    <i class="fas fa-plus me-1"></i>@SharedLocalizer["Cust_AddTransaction"]
                </button>
            </div>
            <div class="products-card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Cust_OwesMe"]</label>
                        <p class="detail-value">
                            <span class="text-success fw-bold">
                                <i class="fas fa-arrow-down me-2"></i>@FormatCurrency(debtFromCustomer, currencyNotation)
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@SharedLocalizer["Cust_IOwe"]</label>
                        <p class="detail-value">
                            <span class="text-danger fw-bold">
                                <i class="fas fa-arrow-up me-2"></i>@FormatCurrency(debtToCustomer, currencyNotation)
                            </span>
                        </p>
                    </div>
                </div>

                <hr>

                <div class="erp-alert @(netDebt > 0 ? "erp-alert-success" : netDebt < 0 ? "erp-alert-danger" : "erp-alert-info") mb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><strong>@SharedLocalizer["Cust_NetBalance"]</strong></h6>
                            <p class="mb-0">
                                @if (netDebt > 0)
                                {
                                    <span class="fw-bold">@SharedLocalizer["Cust_CustomerOwesMe", FormatCurrency(Math.Abs(netDebt), currencyNotation)]</span>
                                }
                                else if (netDebt < 0)
                                {
                                    <span class="fw-bold">@SharedLocalizer["Cust_IOweCustomer", FormatCurrency(Math.Abs(netDebt), currencyNotation)]</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@SharedLocalizer["Cust_BalancedNoDebt"]</span>
                                }
                            </p>
                        </div>
                        <div>
                            @if (netDebt > 0)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="fas fa-check-circle me-1"></i>@SharedLocalizer["Cust_Receivable"]
                                </span>
                            }
                            else if (netDebt < 0)
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-exclamation-triangle me-1"></i>@SharedLocalizer["Cust_Payable"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="fas fa-balance-scale me-1"></i>@SharedLocalizer["Cust_Balanced"]
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @if (debtTransactions.Any())
                {
                    <hr>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@SharedLocalizer["Date"]</th>
                                    <th>@SharedLocalizer["Type"]</th>
                                    <th>@SharedLocalizer["Cust_Note"]</th>
                                    <th class="text-end">@SharedLocalizer["Amount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in debtTransactions.Take(20))
                                {
                                    <tr>
                                        <td>@tx.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            @if (tx.Type == CustomerDebtTransactionType.Sale)
                                            {
                                                <span class="badge bg-info">@SharedLocalizer["Cust_TypeSale"]</span>
                                            }
                                            else if (tx.Type == CustomerDebtTransactionType.Payment)
                                            {
                                                <span class="badge bg-success">@SharedLocalizer["Cust_TypePayment"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@SharedLocalizer["Cust_TypeAdjustment"]</span>
                                            }
                                        </td>
                                        <td>@(tx.Note ?? (tx.OrderId.HasValue ? SharedLocalizer["Cust_OrderRef", tx.OrderId].Value : "-"))</td>
                                        <td class="text-end fw-bold @(tx.Amount > 0 ? "text-success" : "text-danger")">
                                            @(tx.Amount > 0 ? "+" : "")@FormatCurrency(tx.Amount, currencyNotation)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (debtTransactions.Count > 20)
                    {
                        <p class="text-muted text-center mt-2 mb-0"><small>@SharedLocalizer["Cust_ShowingRecent", debtTransactions.Count]</small></p>
                    }
                }
            </div>
        </div>

        <!-- Orders History Card -->
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>
                    @SharedLocalizer["Cust_OrderHistory"]
                </h5>
            </div>
            <div class="products-card-body">
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>@SharedLocalizer["Cust_OrderNumber"]</th>
                                    <th>@SharedLocalizer["Date"]</th>
                                    <th>@SharedLocalizer["Cust_TotalAmount"]</th>
                                    <th>@SharedLocalizer["Status"]</th>
                                    <th>@SharedLocalizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt).Take(10))
                                {
                                    <tr>
                                        <td><strong>#@order.Id</strong></td>
                                        <td>@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@FormatCurrency(order.TotalAmount, order.Currency?.Notation ?? currencyNotation)</td>
                                        <td>
                                            @{
                                                var orderStatus = (OrderStatus)order.Status;
                                                var statusClass = orderStatus switch
                                                {
                                                    OrderStatus.Pending => "bg-warning",
                                                    OrderStatus.Processing => "bg-info",
                                                    OrderStatus.Shipped => "bg-primary",
                                                    OrderStatus.Delivered => "bg-success",
                                                    OrderStatus.Cancelled => "bg-danger",
                                                    OrderStatus.Returned => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @statusClass">@SharedLocalizer["Cust_St_" + orderStatus.ToString()]</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Orders.Count > 10)
                    {
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Orders", new { customerId = Model.Id })" class="btn btn-outline-teal">
                                @SharedLocalizer["Cust_ViewAllOrders", Model.Orders.Count]
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                        <p class="text-muted">@SharedLocalizer["Cust_NoOrders"]</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Customer Summary Card -->
    <div class="col-lg-4">
        <div class="products-table-card mb-4">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>
                    @SharedLocalizer["Cust_Summary"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="text-center mb-4">
                    <div class="avatar-circle mx-auto" style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--teal-primary), var(--teal-darker)); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(10, 162, 162, 0.3);">
                        <span style="font-size: 32px; font-weight: 700; color: var(--primary-color);">@(Model.FirstName?.Substring(0, 1).ToUpper())@(Model.LastName?.Substring(0, 1).ToUpper())</span>
                    </div>
                    <h5 class="mt-3 mb-0">@Model.FirstName @Model.LastName</h5>
                </div>

                <hr>

                <div class="summary-stats">
                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@SharedLocalizer["Cust_TotalOrders"]</div>
                            <div class="stat-value">@(Model.Orders?.Count ?? 0)</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@SharedLocalizer["Cust_TotalSpent"]</div>
                            <div class="stat-value">@FormatCurrency(Model.Orders?.Sum(o => o.TotalAmount) ?? 0, currencyNotation)</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@SharedLocalizer["Cust_AverageOrder"]</div>
                            <div class="stat-value">
                                @{
                                    var avgOrder = Model.Orders != null && Model.Orders.Any() 
                                        ? Model.Orders.Average(o => o.TotalAmount) 
                                        : 0;
                                }
                                @FormatCurrency(avgOrder, currencyNotation)
                            </div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@SharedLocalizer["Cust_LastOrder"]</div>
                            <div class="stat-value">
                                @{
                                    var lastOrder = Model.Orders?.OrderByDescending(o => o.CreatedAt).FirstOrDefault();
                                }
                                @if (lastOrder != null)
                                {
                                    @lastOrder.CreatedAt.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">@SharedLocalizer["Cust_Never"]</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon @(netDebt > 0 ? "bg-success" : netDebt < 0 ? "bg-danger" : "bg-secondary")">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@SharedLocalizer["Cust_NetBalance"]</div>
                            <div class="stat-value @(netDebt > 0 ? "text-success" : netDebt < 0 ? "text-danger" : "text-muted")">
                                @if (netDebt > 0)
                                {
                                    <span>+@FormatCurrency(Math.Abs(netDebt), currencyNotation)</span>
                                }
                                else if (netDebt < 0)
                                {
                                    <span>-@FormatCurrency(Math.Abs(netDebt), currencyNotation)</span>
                                }
                                else
                                {
                                    <span>@FormatCurrency(netDebt, currencyNotation)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-bolt me-2"></i>
                    @SharedLocalizer["QuickActions"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "Customers", new { id = Model.Id })" class="btn btn-outline-teal">
                        <i class="fas fa-edit me-2"></i>@SharedLocalizer["Cust_EditTitle"]
                    </a>
                    <a href="@Url.Action("Index", "Orders", new { customerId = Model.Id })" class="btn btn-outline-primary">
                        <i class="fas fa-shopping-cart me-2"></i>@SharedLocalizer["Cust_ViewOrders"]
                    </a>
                    <a href="mailto:@Model.Email" class="btn btn-outline-info">
                        <i class="fas fa-envelope me-2"></i>@SharedLocalizer["Cust_SendEmail"]
                    </a>
                    <button type="button" class="btn btn-outline-danger" onclick="deleteCustomer(@Model.Id)">
                        <i class="fas fa-trash me-2"></i>@SharedLocalizer["Cust_DeleteCustomer"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Pages/Customers/DebtDialog.js" asp-append-version="true"></script>
    <script>
        function openAddDebtTransaction(customerId) {
            window.openDebtTransactionDialog(customerId, '@Url.Action("AddDebtTransaction", "Customers")',
                () => window.location.reload());
        }

        function deleteCustomer(id) {
            Swal.fire({
                title: @Json.Serialize(SharedLocalizer["Cust_AreYouSure"].Value),
                text: @Json.Serialize(SharedLocalizer["Cust_CannotUndo"].Value),
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: @Json.Serialize(SharedLocalizer["Cust_YesDelete"].Value),
                cancelButtonText: @Json.Serialize(SharedLocalizer["Cancel"].Value)
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Customers")',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    title: @Json.Serialize(SharedLocalizer["Cust_DeletedTitle"].Value),
                                    text: response.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.href = '@Url.Action("Index", "Customers")';
                                });
                            } else {
                                Swal.fire(@Json.Serialize(SharedLocalizer["Cust_ErrorTitle"].Value), response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire(@Json.Serialize(SharedLocalizer["Cust_ErrorTitle"].Value), @Json.Serialize(SharedLocalizer["Cust_DeleteError"].Value), 'error');
                        }
                    });
                }
            });
        }
    </script>

    <style>
        .detail-label {
            font-weight: 600;
            color: var(--gray-700);
            font-size: 14px;
            margin-bottom: 4px;
        }

        .detail-value {
            color: var(--gray-800);
            font-size: 16px;
            margin-bottom: 0;
        }

        .text-teal {
            color: var(--teal-primary) !important;
            text-decoration: none;
        }

        .text-teal:hover {
            text-decoration: underline;
        }

        .avatar-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--teal-primary), var(--teal-darker));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(10, 162, 162, 0.3);
        }

        .avatar-initials {
            font-size: 36px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
        }

        .summary-stats {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--teal-lighter);
            color: var(--teal-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .stat-icon.bg-success {
            background: var(--success, #28a745) !important;
            color: white !important;
        }

        .stat-icon.bg-danger {
            background: var(--danger, #dc3545) !important;
            color: white !important;
        }

        .stat-icon.bg-secondary {
            background: var(--secondary, #6c757d) !important;
            color: white !important;
        }

        .stat-content {
            flex: 1;
        }

        .stat-label {
            font-size: 12px;
            color: var(--gray-600);
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 18px;
            font-weight: 600;
            color: var(--gray-800);
        }
    </style>
}



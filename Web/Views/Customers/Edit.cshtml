@model Application.DTOs.Customers.UpdateCustomerRequest

@{
    ViewData["Title"] = SharedLocalizer["Cust_EditTitle"].Value;
    ViewData["Subtitle"] = SharedLocalizer["Cust_EditSubtitle"].Value;
}

<!-- Edit Customer Header -->
<div class="d-flex justify-content-end mb-4">
    <a href="@Url.Action("Index", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>@SharedLocalizer["Cust_BackToCustomers"]
    </a>
</div>

<!-- Edit Customer Form -->
<div class="row">
    <div class="col-lg-8">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit me-2"></i>
                    @SharedLocalizer["Cust_Information"]
                </h5>
            </div>
            <div class="products-card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">@SharedLocalizer["First Name"] *</label>
                            <input asp-for="FirstName" class="form-control" placeholder="@SharedLocalizer["Cust_PhFirstName"]" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">@SharedLocalizer["Last Name"] *</label>
                            <input asp-for="LastName" class="form-control" placeholder="@SharedLocalizer["Cust_PhLastName"]" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">@SharedLocalizer["Email Address"]</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="@SharedLocalizer["Cust_PhEmail"]" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">@SharedLocalizer["Phone Number"]</label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="@SharedLocalizer["Cust_PhPhone"]" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">@SharedLocalizer["Address"]</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="@SharedLocalizer["Cust_PhAddress"]"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label">@SharedLocalizer["Date of Birth"]</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label">@SharedLocalizer["Company Name"]</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="@SharedLocalizer["Cust_PhCompanyOptional"]" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TaxNumber" class="form-label">@SharedLocalizer["Tax Number"]</label>
                            <input asp-for="TaxNumber" class="form-control" placeholder="@SharedLocalizer["Cust_PhTaxOptional"]" />
                            <span asp-validation-for="TaxNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@SharedLocalizer["Customer Type"]</label>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="isCompany" @(string.IsNullOrEmpty(Model.CompanyName) ? "" : "checked") />
                                <label class="form-check-label" for="isCompany">
                                    @SharedLocalizer["Cust_IsCompany"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">@SharedLocalizer["Notes"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="@SharedLocalizer["Cust_PhNotes"]"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">
                                @SharedLocalizer["Cust_IsActive"]
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <a href="@Url.Action("Index", "Customers", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>@SharedLocalizer["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-teal">
                            <i class="fas fa-save me-2"></i>@SharedLocalizer["Cust_UpdateCustomer"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    @SharedLocalizer["Cust_Guidelines"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="guidelines">
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G1"]</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G2"]</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G3"]</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G4"]</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G5"]</span>
                    </div>
                    <div class="guideline-item">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span>@SharedLocalizer["Cust_G6"]</span>
                    </div>
                </div>

                <hr>

                <div class="customer-preview">
                    <h6 class="text-muted mb-3">@SharedLocalizer["Cust_Preview"]</h6>
                    <div class="preview-customer" id="customerPreview">
                        <div class="preview-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="preview-content">
                            <div class="preview-name" id="previewName">@Model.FirstName @Model.LastName</div>
                            <div class="preview-email" id="previewEmail">@Model.Email</div>
                            <div class="preview-phone" id="previewPhone">@(Model.PhoneNumber ?? SharedLocalizer["Cust_NoPhone"].Value)</div>
                            <div class="preview-type" id="previewType">@(string.IsNullOrEmpty(Model.CompanyName) ? SharedLocalizer["Cust_Individual"].Value : SharedLocalizer["Cust_Company"].Value)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Update customer preview in real-time
            function updateCustomerPreview() {
                const firstName = $('#FirstName').val() || @Json.Serialize(SharedLocalizer["Cust_PvFirst"].Value);
                const lastName = $('#LastName').val() || @Json.Serialize(SharedLocalizer["Cust_PvLast"].Value);
                const email = $('#Email').val() || 'email@example.com';
                const phone = $('#PhoneNumber').val() || @Json.Serialize(SharedLocalizer["Cust_PvPhone"].Value);
                const isCompany = $('#isCompany').is(':checked');

                $('#previewName').text(`${firstName} ${lastName}`);
                $('#previewEmail').text(email);
                $('#previewPhone').text(phone || @Json.Serialize(SharedLocalizer["Cust_NoPhone"].Value));
                $('#previewType').text(isCompany ? @Json.Serialize(SharedLocalizer["Cust_Company"].Value) : @Json.Serialize(SharedLocalizer["Cust_Individual"].Value));
            }

            $('#FirstName, #LastName, #Email, #PhoneNumber, #isCompany').on('input change', updateCustomerPreview);

            // Company checkbox functionality
            $('#isCompany').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#CompanyName').attr('placeholder', @Json.Serialize(SharedLocalizer["Cust_PhCompanyRequired"].Value));
                    $('#TaxNumber').attr('placeholder', @Json.Serialize(SharedLocalizer["Cust_PhTax"].Value));
                } else {
                    $('#CompanyName').attr('placeholder', @Json.Serialize(SharedLocalizer["Cust_PhCompanyOptional"].Value));
                    $('#TaxNumber').attr('placeholder', @Json.Serialize(SharedLocalizer["Cust_PhTaxOptional"].Value));
                }
                updateCustomerPreview();
            });

            // Form validation
            $('form').on('submit', function(e) {
                const firstName = $('#FirstName').val().trim();
                const lastName = $('#LastName').val().trim();

                if (!firstName || !lastName) {
                    e.preventDefault();
                    appAlert(@Json.Serialize(SharedLocalizer["Cust_FillRequired"].Value), 'warning');
                    if (!firstName) $('#FirstName').focus();
                    else $('#LastName').focus();
                }
            });
        });
    </script>

    <style>
        .guidelines {
            margin-bottom: 20px;
        }

        .guideline-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
            color: var(--gray-600);
        }

        .customer-preview {
            background: var(--teal-lighter);
            padding: 16px;
            border-radius: 8px;
        }

        .preview-customer {
            display: flex;
            align-items: center;
            background: white;
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .preview-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--teal-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 16px;
            font-size: 20px;
        }

        .preview-content {
            flex: 1;
        }

        .preview-name {
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 4px;
        }

        .preview-email {
            font-size: 14px;
            color: var(--gray-600);
            margin-bottom: 2px;
        }

        .preview-phone {
            font-size: 12px;
            color: var(--gray-500);
            margin-bottom: 4px;
        }

        .preview-type {
            font-size: 11px;
            color: var(--teal-primary);
            font-weight: 500;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal-primary);
            box-shadow: 0 0 0 0.2rem rgba(10, 162, 162, 0.25);
        }

        .form-label {
            font-weight: 600;
            color: var(--gray-700);
            margin-bottom: 8px;
        }

        .form-check-input:checked {
            background-color: var(--teal-primary);
            border-color: var(--teal-primary);
        }
    </style>
}



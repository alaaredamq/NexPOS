@{
    ViewData["Title"] = SharedLocalizer["Settings"].Value;
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title mb-0"><i class="fas fa-cog me-2"></i>@SharedLocalizer["Settings"]</h4>
            <p class="card-subtitle text-muted mb-0">@SharedLocalizer["Set_Subtitle"]</p>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-paint-brush me-2"></i>@SharedLocalizer["Set_Branding"]</h5>
                            <p class="card-text text-muted small">@SharedLocalizer["Set_BrandingCardDesc"]</p>
                            <a href="@Url.ActionWithCurrentLanguage("Branding", "Settings")" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit me-1"></i>@SharedLocalizer["Set_Configure"]</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-receipt me-2"></i>@SharedLocalizer["Set_StoreReceipts"]</h5>
                            <p class="card-text text-muted small">@SharedLocalizer["Set_StoreReceiptsDesc"]</p>
                            <a href="@Url.ActionWithCurrentLanguage("StoreSettings", "Settings")" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit me-1"></i>@SharedLocalizer["Set_Configure"]</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-print me-2"></i>@SharedLocalizer["Set_PrintersLabels"]</h5>
                            <p class="card-text text-muted small">@SharedLocalizer["Set_PrintersLabelsDesc"]</p>
                            <a href="@Url.ActionWithCurrentLanguage("AppSettings", "Settings")" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit me-1"></i>@SharedLocalizer["Set_Configure"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@model Application.DTOs.Settings.AppSettingsDTO

@{
    ViewData["Title"] = SharedLocalizer["Set_PrintersLabels"].Value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-print me-2"></i>
                        @SharedLocalizer["Set_PrintersLabels"]
                    </h4>
                    <p class="card-subtitle text-muted">@SharedLocalizer["Set_PrintersSubtitle"]</p>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="erp-alert erp-alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="erp-alert erp-alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="UpdateAppSettings" method="post">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>@SharedLocalizer["Set_ReceiptPrinter"]</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ReceiptPrinterName" class="form-label">@SharedLocalizer["Set_ReceiptPrinter"]</label>
                                            <div class="input-group">
                                                <select asp-for="ReceiptPrinterName" id="receiptPrinterSelect" class="form-select">
                                                    <option value="">@SharedLocalizer["Set_SelectPrinter"]</option>
                                                    @if (!string.IsNullOrEmpty(Model.ReceiptPrinterName))
                                                    {
                                                        <option value="@Model.ReceiptPrinterName">@Model.ReceiptPrinterName</option>
                                                    }
                                                </select>
                                                <button type="button" class="btn btn-outline-secondary" id="testPrinterBtn" title="@SharedLocalizer["Set_TestTooltip"]">
                                                    <i class="fas fa-print me-1"></i>@SharedLocalizer["Set_Test"]
                                                </button>
                                            </div>
                                            <div class="form-text">@SharedLocalizer["Set_ReceiptPrinterHelp"]</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="fas fa-barcode me-2"></i>@SharedLocalizer["Set_BarcodeStickers"]</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="stickerPrinterSelect" class="form-label">@SharedLocalizer["Set_StickerPrinter"]</label>
                                            @* No name attribute: this is a per-machine choice saved in this computer's
                                               browser storage on change, not a shared setting posted with the form. *@
                                            <select id="stickerPrinterSelect" class="form-select">
                                                <option value="">@SharedLocalizer["Set_SystemDefault"]</option>
                                            </select>
                                            <div class="form-text" id="stickerPrinterDesktopOnly" style="display:none">@SharedLocalizer["Set_StickerDesktopOnly"]</div>
                                            <div class="form-text">@SharedLocalizer["Set_StickerPrinterHelp"]</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="StickerWidthMm" class="form-label">@SharedLocalizer["Set_StickerWidth"]</label>
                                            <input asp-for="StickerWidthMm" type="number" class="form-control" min="15" max="150" step="1" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="StickerHeightMm" class="form-label">@SharedLocalizer["Set_StickerHeight"]</label>
                                            <input asp-for="StickerHeightMm" type="number" class="form-control" min="10" max="150" step="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.ActionWithCurrentLanguage("Index", "Settings")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>@SharedLocalizer["Set_BackToSettings"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>@SharedLocalizer["Set_SaveSettings"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_StickerLabelScripts" />
    <script>
        $(function () {
            loadAvailablePrinters();
            loadStickerPrinters();

            $('#testPrinterBtn').on('click', function () {
                var printerName = $('#receiptPrinterSelect').val();
                if (!printerName) {
                    toastr.warning(@Json.Serialize(SharedLocalizer["Set_SelectPrinterFirst"].Value));
                    return;
                }

                var $btn = $(this).prop('disabled', true);
                $.post('@Url.Action("TestPrinter", "Settings")', { printerName: printerName })
                    .done(function (res) {
                        if (res.success) toastr.success(res.message);
                        else toastr.error(res.message);
                    })
                    .fail(function () {
                        toastr.error(@Json.Serialize(SharedLocalizer["Set_TestFailed"].Value));
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });
        });

        function loadAvailablePrinters() {
            $.get('@Url.Action("GetAvailablePrinters", "Settings")', function (res) {
                if (!res.success) {
                    toastr.error(@Json.Serialize(SharedLocalizer["Set_LoadPrintersFailed"].Value) + ": " + res.message);
                    return;
                }

                var $select = $('#receiptPrinterSelect');
                var currentValue = $select.val();

                $select.empty();
                $select.append($('<option>', { value: '', text: @Json.Serialize(SharedLocalizer["Set_SelectPrinter"].Value) }));

                (res.data || []).forEach(function (printerName) {
                    $select.append($('<option>', { value: printerName, text: printerName }));
                });

                // If the currently configured printer wasn't detected on this machine
                // (e.g. unplugged), keep it selectable so the setting isn't silently lost.
                if (currentValue && $select.find('option[value="' + currentValue.replace(/"/g, '\\"') + '"]').length === 0) {
                    $select.append($('<option>', { value: currentValue, text: currentValue + " " + @Json.Serialize(SharedLocalizer["Set_NotDetected"].Value) }));
                }

                $select.val(currentValue);
            }).fail(function () {
                toastr.error(@Json.Serialize(SharedLocalizer["Set_LoadPrintersFailed"].Value));
            });
        }

        // Sticker printer: listed by the desktop app and remembered per computer (see sticker-label.js).
        function loadStickerPrinters() {
            var $select = $('#stickerPrinterSelect');
            if (!StickerLabel.isDesktop()) {
                $select.prop('disabled', true);
                $('#stickerPrinterDesktopOnly').show();
                return;
            }
            StickerLabel.fillPrinterSelect($select, @Json.Serialize(SharedLocalizer["Set_SystemDefault"].Value));
            $select.on('change', function () {
                StickerLabel.setPrinterName($(this).val());
                toastr.success(@Json.Serialize(SharedLocalizer["Set_StickerSaved"].Value));
            });
        }
    </script>
}

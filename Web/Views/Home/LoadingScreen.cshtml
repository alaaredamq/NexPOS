@using System.Globalization
@{
    ViewData["Title"] = "Loading...";
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/branding/favicon?v=@Brand.Version" />

    <!-- Bootstrap CSS -->
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="~/css/colors.css" rel="stylesheet" asp-append-version="true" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a7b85 0%, #101e20 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        .loading-container {
            background: white;
            border-radius: 14px;
            padding: 28px 32px 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            text-align: center;
            width: 320px;
            max-width: 90%;
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .loading-icon {
            margin-bottom: 14px;
            line-height: 0;
        }

        .loading-icon img {
            display: inline-block;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.06); opacity: 0.85; }
        }

        h1 {
            color: #333;
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .progress {
            height: 6px;
            border-radius: 6px;
            background-color: #e9ecef;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #0a7b85 0%, #101e20 100%);
            border-radius: 6px;
            transition: width 0.3s ease;
        }

        .loading-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 10px;
            font-size: 12px;
        }

        .loading-status {
            color: #888;
            text-align: start;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .progress-text {
            color: #0a7b85;
            font-weight: 600;
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <div class="loading-icon">
            @if (Brand.HasCustomLogo)
            {
                <img src="~/branding/logo?v=@Brand.Version" alt="@Brand.AppName" style="height: 40px; width: auto; max-width: 160px; object-fit: contain;" />
            }
            else
            {
                <img src="~/branding/logo?variant=mark&v=@Brand.Version" alt="@Brand.AppName" width="44" height="44" style="object-fit:contain;" />
            }
        </div>
        <h1>Loading @Brand.AppName</h1>

        <div class="progress">
            <div class="progress-bar" id="progressBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="loading-meta">
            <div class="loading-status" id="loadingStatus">Initializing...</div>
            <div class="progress-text" id="progressText">0%</div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>

    <script>
        class LoadingScreen {
            constructor() {
                this.totalSteps = 7;
                this.currentStep = 0;
                // Get current language from URL
                const pathParts = window.location.pathname.split('/').filter(p => p);
                this.currentLang = pathParts[0] && (pathParts[0] === 'en' || pathParts[0] === 'ar') ? pathParts[0] : 'en';
                this.baseUrl = `/${this.currentLang}`;

                this.steps = [
                    { name: 'Refreshing product cache...', endpoint: `${this.baseUrl}/POS/RefreshCache`, method: 'POST' },
                    { name: 'Loading currencies...', endpoint: `${this.baseUrl}/POS/GetCurrencies`, method: 'GET' },
                    { name: 'Loading products...', endpoint: `${this.baseUrl}/POS/GetAllProducts`, method: 'GET' },
                    { name: 'Loading customers...', endpoint: `${this.baseUrl}/POS/GetCustomers`, method: 'GET' },
                    { name: 'Loading payment methods...', endpoint: `${this.baseUrl}/POS/GetPaymentMethods`, method: 'GET' },
                    { name: 'Loading discounts...', endpoint: `${this.baseUrl}/POS/GetAvailableDiscounts`, method: 'GET' },
                    { name: 'Finalizing...', endpoint: null, method: null }
                ];

                this.init();
            }

            init() {
                this.updateProgress(0, 'Initializing...');
                this.startLoading();
            }

            async startLoading() {
                try {
                    // Load default currency first (needed for other operations)
                    await this.loadDefaultCurrency();

                    // Execute all caching steps
                    for (let i = 0; i < this.steps.length - 1; i++) {
                        await this.executeStep(i);
                    }

                    // Final step - just a delay for smooth transition
                    await this.finalize();

                    // Redirect to POS
                    this.redirectToPOS();
                } catch (error) {
                    console.error('Error during loading:', error);
                    this.handleError(error);
                }
            }

            async loadDefaultCurrency() {
                try {
                    this.updateStatus('Loading default currency...');
                    const response = await $.ajax({
                        url: `${this.baseUrl}/POS/GetDefaultCurrency`,
                        method: 'GET',
                        timeout: 30000
                    });

                    if (response && response.success) {
                        console.log('Default currency loaded:', response.data);
                    }
                } catch (error) {
                    console.warn('Failed to load default currency:', error);
                    // Continue anyway - not critical for initial load
                }
            }

            async executeStep(stepIndex) {
                const step = this.steps[stepIndex];
                this.updateStatus(step.name);

                try {
                    if (step.endpoint) {
                        const response = await $.ajax({
                            url: step.endpoint,
                            method: step.method,
                            timeout: 60000, // 60 second timeout for cache operations
                            error: function(xhr, status, error) {
                                console.warn(`Request failed for ${step.name}:`, status, error);
                            }
                        });

                        if (response && response.success !== false) {
                            console.log(`✅ ${step.name} completed`);
                        } else {
                            console.warn(`⚠️ ${step.name} returned warning:`, response?.message || 'Unknown error');
                        }
                    }

                    this.currentStep++;
                    const progress = Math.round((this.currentStep / this.totalSteps) * 100);
                    this.updateProgress(progress, `${progress}%`);

                    // Small delay for visual feedback
                    await this.delay(200);
                } catch (error) {
                    console.error(`❌ Error in ${step.name}:`, error);
                    // Continue anyway - don't block on errors
                    this.currentStep++;
                    const progress = Math.round((this.currentStep / this.totalSteps) * 100);
                    this.updateProgress(progress, `${progress}%`);
                }
            }

            async finalize() {
                this.updateStatus('Finalizing...');
                this.currentStep++;
                const progress = Math.round((this.currentStep / this.totalSteps) * 100);
                this.updateProgress(progress, `${progress}%`);

                await this.delay(300);
                this.updateProgress(100, '100%');
                this.updateStatus('Ready!');
            }

            updateProgress(percentage, text) {
                $('#progressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
                $('#progressText').text(text);
            }

            updateStatus(message) {
                $('#loadingStatus').text(message);
            }

            redirectToPOS() {
                setTimeout(() => {
                    window.location.href = `${this.baseUrl}/POS`;
                }, 500);
            }

            handleError(error) {
                this.updateStatus('An error occurred. Redirecting anyway...');
                setTimeout(() => {
                    window.location.href = `${this.baseUrl}/POS`;
                }, 2000);
            }

            delay(ms) {
                return new Promise(resolve => setTimeout(resolve, ms));
            }
        }

        // Start loading when document is ready
        $(document).ready(function() {
            window.loadingScreen = new LoadingScreen();
        });
    </script>
</body>
</html>

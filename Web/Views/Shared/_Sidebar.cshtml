@{
    var noSidebar = ViewBag.NoSidebar as bool? ?? false;
    if (!noSidebar && Context.Request.Query.ContainsKey("noSidebar"))
    {
        noSidebar = Context.Request.Query["noSidebar"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
    }
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

    // The links come from NavCatalog (shared with the Ctrl+K palette), filtered to what the signed-in user's role
    // grants, so a custom role sees exactly the pages it was given instead of links that bounce to "access denied".
    var visiblePages = NavCatalog.VisibleTo(User);
}
@if (!noSidebar)
{
    <nav id="sidebar" class="sidebar" aria-label="@SharedLocalizer["Navigation"]">
        <div class="sidebar-sticky">
            @* Brand: the square mark always, the name beside it when the rail is open. An uploaded logo is used
               as-is for every variant (see BrandingController), so it sits on a white tile to stay readable on the
               dark rail. *@
            <a class="rail-brand" href="@Url.ActionWithCurrentLanguage("Index", "Dashboard")" title="@Brand.AppName">
                <span class="rail-brand-icon">
                    <span class="rail-brand-mark @(Brand.HasCustomLogo ? "is-custom" : "")">
                        <img src="~/branding/logo?variant=mark&v=@Brand.Version" alt="" />
                    </span>
                </span>
                <span class="rail-brand-name">@Brand.AppName</span>
            </a>

            <!-- Navigation Menu -->
            <div class="rail-scroll">
            <ul class="nav flex-column">
                @foreach (var section in NavCatalog.Sections)
                {
                    var entries = visiblePages.Where(p => p.Section == section).ToList();
                    if (entries.Count == 0) { continue; }

                    <li class="nav-section-label">@SharedLocalizer[NavCatalog.SectionLabelKey(section)]</li>
                    foreach (var entry in entries)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(entry.IsActiveFor(currentController) ? "active" : "")"
                               href="@(SpaMigration.IsMigrated(entry.Controller) ? SpaMigration.PlannedPath(entry.Controller) : Url.ActionWithCurrentLanguage(entry.Action, entry.Controller))">
                                <i class="fas @entry.Icon"></i>
                                <span class="nav-text">@SharedLocalizer[entry.LabelKey]</span>
                            </a>
                        </li>
                    }
                }
            </ul>
            </div>

            @* Collapse to an icon rail / expand again. State lives on <html data-rail> (site.js); the drawer
               layout below 992px has its own menu button, so this is hidden there. *@
            <button type="button" class="rail-toggle" data-rail-toggle aria-expanded="true">
                <span class="rail-toggle-icon"><i class="fas fa-angles-left"></i></span>
                <span class="nav-text rail-toggle-collapse">@SharedLocalizer["CollapseMenu"]</span>
                <span class="nav-text rail-toggle-expand">@SharedLocalizer["ExpandMenu"]</span>
            </button>
        </div>
    </nav>
    <div class="sidebar-scrim" data-sidebar-close></div>
}

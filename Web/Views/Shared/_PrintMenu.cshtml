@model Web.Models.Shared.PrintMenuModel

<div class="btn-group">
    <button type="button" class="@Model.ButtonClass dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-print me-1"></i>@(Model.Label ?? SharedLocalizer["Print_Menu"].Value)
    </button>
    <ul class="dropdown-menu">
        <li>
            <button type="button" class="dropdown-item" data-nexprint-url="@Model.PrintUrl">
                <i class="fas fa-receipt me-2"></i>@SharedLocalizer["Print_ReceiptPaper"]
            </button>
        </li>
        <li>
            <a class="dropdown-item" href="@Model.PdfUrl" download>
                <i class="fas fa-file-pdf me-2"></i>@SharedLocalizer["Print_DownloadPdf"]
            </a>
        </li>
    </ul>
</div>

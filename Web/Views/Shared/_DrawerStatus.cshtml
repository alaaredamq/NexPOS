@* Whether the signed-in user's cash drawer is open - Boussi Cell's "till chip". Red "Drawer not opened" or green
   "Drawer open - $100.00" (the opening cash), and it links to the Drawer page either way. Only shown to people who
   can use the drawer (the same Sales.View permission that guards the CashDrawer pages and its sidebar link), because
   telling someone who can't open one that it isn't open is noise.
   Rendered on the server so there is no flash on page load; site.js keeps it fresh afterwards (every minute, and when
   the window is shown again), so opening or closing the drawer in another window is picked up. *@
@using System.Globalization
@using System.Security.Claims
@inject global::Application.IServices.Sales.ICashDrawerService CashDrawerService
@if (PermissionHelper.HasPermission(User, PermissionHelper.Permissions.Sales_View))
{
    bool? isOpen = null;   // null = couldn't tell; the chip stays hidden until the script has an answer
    decimal openingCash = 0;
    if (int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId))
    {
        try
        {
            var session = await CashDrawerService.GetOpenSessionByUserIdAsync(userId);
            isOpen = session != null;
            openingCash = session?.OpeningCash ?? 0;
        }
        catch
        {
            isOpen = null;
        }
    }

    var openTemplate = SharedLocalizer["DrawerOpenWithAmount"].Value;     // "Drawer open · {0}"
    var closedLabel = SharedLocalizer["DrawerNotOpened"].Value;
    var openParts = openTemplate.Split("{0}", 2);
    var amountText = "$" + openingCash.ToString("N2", CultureInfo.InvariantCulture);

    <a class="drawer-chip" data-drawer-status
       data-open="@(isOpen == true ? "true" : "false")"
       data-status-url="@Url.Action("GetOpenSession", "CashDrawer")"
       data-label-open="@openTemplate"
       data-label-closed="@closedLabel"
       href="@Url.ActionWithCurrentLanguage("Index", "CashDrawer")"
       title="@(isOpen == true ? string.Format(CultureInfo.InvariantCulture, openTemplate, amountText) : closedLabel)"
       @(isOpen == null ? "hidden" : "")>
        <span class="drawer-dot" aria-hidden="true"></span>
        @* the amount stays left-to-right inside Arabic text, so "$100.00" never turns into "100.00$" *@
        <span class="drawer-label">
            @if (isOpen == true)
            {
                @openParts[0]<bdi dir="ltr">@amountText</bdi>@(openParts.Length > 1 ? openParts[1] : "")
            }
            else
            {
                @closedLabel
            }
        </span>
    </a>
}

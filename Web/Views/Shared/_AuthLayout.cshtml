@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.AppName</title>
    <link rel="icon" href="~/branding/favicon?v=@Brand.Version" />

    <!-- Bootstrap 5 CSS -->
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="/lib/font-awesome/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Toastr -->
    <link href="/lib/toastr/toastr.min.css" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link href="/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet">
    
    <!-- Auth Pages CSS -->
    <link href="~/css/colors.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Floating Background Shapes -->
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    @RenderBody()

    @{ ViewData["LicenseBannerFloating"] = true; }
    @await Html.PartialAsync("_LicenseBanner")

    <!-- Minimal JavaScript for login page only -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Toastr -->
    <script src="/lib/toastr/toastr.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="/lib/sweetalert2/sweetalert2.min.js"></script>
    
    <!-- Localization -->
    <script src="~/js/localization.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
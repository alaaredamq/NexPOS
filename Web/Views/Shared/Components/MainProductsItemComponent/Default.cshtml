@using Microsoft.EntityFrameworkCore
@using System.Globalization
@model List<Core.DTOs.ProductDTO>
@* Amounts and quantities use the invariant format so they read the same ("$ 3.50", "14.5") as the cart and
   totals, which JS formats as en-US, instead of "3,50" under the Arabic culture. *@
@foreach (var product in Model) {
    var currencyNotation = product.Currency?.Notation ?? "LBP";
    var currencyCode = product.Currency?.Code ?? "LBP";
    var hasDiscount = product.HasSupplierDiscount;
    var effectivePrice = product.EffectivePrice;
    <div class="product-card add-to-cart-btn"
         data-tone="@Common.Helpers.CategoryPalette.ToneFor(product.Category?.Name)"
         data-category="@product.CategoryId"
         data-product-id="@product.Id"
         data-product-name="@product.Name"
         data-product-price="@Convert.ToString(effectivePrice, System.Globalization.CultureInfo.InvariantCulture)"
         data-original-price="@Convert.ToString(product.SellingPrice, System.Globalization.CultureInfo.InvariantCulture)"
         data-supplier-discount="@Convert.ToString(product.SupplierDiscountRate, System.Globalization.CultureInfo.InvariantCulture)"
         data-product-sku="@product.Barcode"
         data-currency-id="@product.CurrencyId"
         data-currency-code="@currencyCode"
         data-currency-notation="@currencyNotation"
         data-is-pack="@(product.IsPack ? "true" : "false")"
         data-pack-size="@(product.PackSize ?? 0)"
         data-single-product-id="@(product.SingleProductId ?? 0)"
         data-product-unit="@(product.Unit ?? "piece")">
        
        @* Compact keycap: name over a dashed rule, price and stock underneath. No product picture on purpose -
           the register is scanned by name and price, and without images the grid fits far more keys on screen.
           data-tone gives each category its own muted key colour (see "product tiles" in pos.css). *@
        <div class="product-name">
            @product.Name
            @if (product.IsPack)
            {
                <span class="badge bg-info ms-1">@SharedLocalizer["PackOf", product.PackSize ?? 0]</span>
            }
        </div>
        <div class="product-foot">
            <div class="product-money">
                @if (hasDiscount)
                {
                    <div class="product-price">@currencyNotation @effectivePrice.ToString("N2", CultureInfo.InvariantCulture)</div>
                    <div class="product-original-price">@currencyNotation @product.SellingPrice.ToString("N2", CultureInfo.InvariantCulture)</div>
                }
                else
                {
                    <div class="product-price">@currencyNotation @product.SellingPrice.ToString("N2", CultureInfo.InvariantCulture)</div>
                }
            </div>
            <div class="product-stock @(product.StockQuantity <= 0 ? "out-of-stock" : product.StockQuantity <= (product.MinimumStock ?? 5) ? "low-stock" : "")">
                @if (product.StockQuantity <= 0)
                {
                    @:<i class="fas fa-times-circle"></i> @SharedLocalizer["OutOfStock"]
                }
                else if (product.StockQuantity <= (product.MinimumStock ?? 5))
                {
                    @:<i class="fas fa-exclamation-triangle"></i> @SharedLocalizer["LowStock"]
                }
                else
                {
                    @:<i class="fas fa-circle"></i> @product.StockQuantity.ToString("0.##", CultureInfo.InvariantCulture) <span class="stock-unit">@SharedLocalizer["Units"]</span>
                }
            </div>
        </div>
    </div>
}
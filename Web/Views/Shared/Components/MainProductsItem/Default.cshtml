@model IEnumerable<Core.DTOs.ProductDTO>

@if (Model != null && Model.Any())
{
    <div class="products-grid">
        @foreach (var product in Model)
        {
            <div class="product-card-compact" data-product-id="@product.Id" data-category="@product.Category?.Name?.ToLower()">
                <div class="product-header">
                    <div class="product-icon">
                        @if (!string.IsNullOrEmpty(product.Barcode))
                        {
                            <i class="fas fa-barcode"></i>
                        }
                        else
                        {
                            <i class="fas fa-box"></i>
                        }
                    </div>
                    <div class="product-info">
                        <div class="product-name">@product.Name</div>
                        <div class="product-price">@product.SellingPrice.ToString("N0") @(product.Currency?.Notation ?? "LBP")</div>
                    </div>
                </div>
                <button type="button" class="btn btn-teal btn-sm add-to-cart-btn w-100" 
                        data-product-id="@product.Id" 
                        data-product-name="@product.Name" 
                        data-product-price="@product.SellingPrice" 
                        data-product-sku="@product.Barcode"
                        data-currency-id="@product.CurrencyId"
                        data-currency-notation="@(product.Currency?.Notation ?? "LBP")"
                        data-category="@product.Category?.Name?.ToLower()">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        }
    </div>
}
else
{
    <div class="empty-products-state">
        <i class="fas fa-box-open"></i>
        <h6>No Products Available</h6>
        <p>Add products to your inventory to start selling</p>
    </div>
}

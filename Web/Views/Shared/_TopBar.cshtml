@{
    var noSidebar = ViewBag.NoSidebar as bool? ?? false;
    if (!noSidebar && Context.Request.Query.ContainsKey("noSidebar"))
    {
        noSidebar = Context.Request.Query["noSidebar"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
    }
}
@if (!noSidebar)
{
    <div class="topbar d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center gap-2 border-bottom">
        <div class="topbar-title d-flex align-items-center gap-3">
            @* Below 992px the sidebar is a drawer; this opens it (site.js). *@
            <button class="btn btn-header-action sidebar-toggle d-lg-none" type="button"
                    data-sidebar-toggle aria-controls="sidebar" aria-expanded="false"
                    aria-label="@SharedLocalizer["Menu"]" title="@SharedLocalizer["Menu"]">
                <i class="fas fa-bars"></i>
            </button>
            <div class="min-w-0">
                <h1 class="h2">@(ViewData["Title"] ?? "")</h1>
                <p class="text-muted mb-0">@(ViewData["Subtitle"] ?? "")</p>
            </div>
        </div>

        <div class="topbar-actions d-flex align-items-center gap-2">
            @* Opens the jump-to-page palette (command-palette.js); Ctrl/Cmd+K does the same from anywhere. *@
            <button type="button" class="btn btn-header-action cmdk-trigger" data-cmdk-open
                    aria-haspopup="dialog" aria-label="@SharedLocalizer["JumpTo"]" title="@SharedLocalizer["JumpTo"]">
                <i class="fas fa-search"></i>
                <span class="cmdk-trigger-text">@SharedLocalizer["JumpTo"]</span>
                <kbd class="cmdk-trigger-kbd" data-cmdk-key>Ctrl K</kbd>
            </button>

            <a href="@Url.ActionWithCurrentLanguage("Index", "POS")"
               class="btn btn-pos-action"
               title="@SharedLocalizer["GoToPointOfSale"]">
                <i class="fas fa-cash-register me-2"></i>
                <span>@SharedLocalizer["POS"]</span>
            </a>

            @* Cash drawer status (red until it is opened, green with the opening cash after) *@
            <partial name="_DrawerStatus" />

            @* English / Arabic toggle *@
            <partial name="_LanguageToggle" />

            <!-- Notifications -->
            @* Items, badge and toasts are filled in from /Notifications/GetFeed by notifications.js. *@
            <div class="dropdown" id="notificationBell">
                <button class="btn btn-header-action position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="@SharedLocalizer["Notifications"]" title="@SharedLocalizer["Notifications"]">
                    <i class="fas fa-bell"></i>
                    <span class="notif-badge" id="managementNotificationBadge" hidden>0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end notif-panel">
                    <div class="notif-panel-head">
                        <h6 class="mb-0">@SharedLocalizer["Notifications"]</h6>
                        <button type="button" class="notif-mark-all" id="notificationMarkAllRead" hidden></button>
                    </div>
                    <div class="notif-list" id="notificationList"></div>
                    <a class="notif-view-all" href="@Url.PageWithCurrentLanguage("Notifications")">@SharedLocalizer["ViewAll"]</a>
                </div>
            </div>

            <!-- User Menu -->
            <div class="dropdown">
                @{
                    var userName = User.Identity?.Name ?? "User";
                    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                }
                <button class="btn btn-header-action user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar" aria-hidden="true">@(userName.Length > 0 ? char.ToUpperInvariant(userName[0]) : '?')</span>
                    <span class="user-text">
                        <span class="user-name">@userName</span>
                        @if (!string.IsNullOrWhiteSpace(userRole))
                        {
                            <span class="user-role">@userRole</span>
                        }
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">@SharedLocalizer["Account"]</h6></li>
                    <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("Profile", "Account")"><i class="fas fa-user me-2"></i>@SharedLocalizer["Profile"]</a></li>
                    <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("ChangePassword", "Account")"><i class="fas fa-key me-2"></i>@SharedLocalizer["ChangePassword"]</a></li>
                    <li><a class="dropdown-item" href="@Url.PageWithCurrentLanguage("Settings")"><i class="fas fa-cog me-2"></i>@SharedLocalizer["Settings"]</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-sign-out-alt me-2"></i>@SharedLocalizer["Logout"]
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}
else
{
    <div class="mb-4">
        <h1 class="h2">@(ViewData["Title"]?.ToString() ?? "")</h1>
        @if (!string.IsNullOrEmpty(ViewData["Subtitle"]?.ToString()))
        {
            <p class="text-muted mb-0">@ViewData["Subtitle"]</p>
        }
    </div>
}

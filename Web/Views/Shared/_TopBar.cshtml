@{
    var noSidebar = ViewBag.NoSidebar as bool? ?? false;
    if (!noSidebar && Context.Request.Query.ContainsKey("noSidebar"))
    {
        noSidebar = Context.Request.Query["noSidebar"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
    }
    var currentLang = (ViewBag.CurrentLanguage as string) ?? "en";
    var routeController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var routeAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
@if (!noSidebar)
{
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom px-3 px-md-4">
        <div>
            <h1 class="h2">@(ViewData["Title"] ?? "")</h1>
            <p class="text-muted mb-0">@(ViewData["Subtitle"] ?? "")</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.ActionWithCurrentLanguage("Index", "POS")"
               class="btn btn-pos-action"
               title="@SharedLocalizer["GoToPointOfSale"]">
                <i class="fas fa-cash-register me-2"></i>
                <span>@SharedLocalizer["POS"]</span>
            </a>

            <!-- Language Switcher -->
            <div class="dropdown">
                <button class="btn btn-header-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-globe me-1"></i>
                    <span>@currentLang.ToUpper()</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item language-switcher-link @(currentLang == "en" ? "active" : "")"
                           data-lang="en"
                           href="@(ViewBag.EnglishUrl ?? $"/en/{routeController}/{routeAction}")">
                            <i class="fas fa-flag-usa me-2"></i>English
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item language-switcher-link @(currentLang == "ar" ? "active" : "")"
                           data-lang="ar"
                           href="@(ViewBag.ArabicUrl ?? $"/ar/{routeController}/{routeAction}")">
                            <i class="fas fa-flag me-2"></i>العربية
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Notifications -->
            <div class="dropdown">
                <button class="btn btn-header-action position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-bell"></i>
                    <span class="position-absolute top-0 end-0 translate-middle badge rounded-pill bg-danger" id="managementNotificationBadge" style="display: none;">0</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width: 300px;">
                    <li><h6 class="dropdown-header">@SharedLocalizer["Notifications"]</h6></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-exclamation-triangle text-warning me-2"></i>@SharedLocalizer["LowStockAlert"]</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-info-circle text-info me-2"></i>@SharedLocalizer["NewOrderReceived"]</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-check-circle text-success me-2"></i>@SharedLocalizer["BackupCompleted"]</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-center" href="@Url.ActionWithCurrentLanguage("Index", "Notifications")">@SharedLocalizer["ViewAll"]</a></li>
                </ul>
            </div>

            <!-- User Menu -->
            <div class="dropdown">
                <button class="btn btn-header-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user-circle me-1"></i>
                    <span>@(User.Identity?.Name ?? "User")</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">@SharedLocalizer["Account"]</h6></li>
                    <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("Profile", "Account")"><i class="fas fa-user me-2"></i>@SharedLocalizer["Profile"]</a></li>
                    <li><a class="dropdown-item" href="@Url.ActionWithCurrentLanguage("ChangePassword", "Account")"><i class="fas fa-key me-2"></i>@SharedLocalizer["ChangePassword"]</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>@SharedLocalizer["Settings"]</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-sign-out-alt me-2"></i>@SharedLocalizer["Logout"]
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}
else
{
    <div class="mb-4">
        <h1 class="h2">@(ViewData["Title"]?.ToString() ?? "")</h1>
        @if (!string.IsNullOrEmpty(ViewData["Subtitle"]?.ToString()))
        {
            <p class="text-muted mb-0">@ViewData["Subtitle"]</p>
        }
    </div>
}

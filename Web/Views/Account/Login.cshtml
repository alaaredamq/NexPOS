@model Web.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = Localizer["Login"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var currentCulture = ViewBag.CurrentCulture ?? System.Globalization.CultureInfo.CurrentUICulture.Name;
    var hasError = !ViewData.ModelState.IsValid;
    var selected = Model.Users.FirstOrDefault(u => string.Equals(u.Username, Model.Username, StringComparison.OrdinalIgnoreCase));
    var hasUser = selected != null;
}

<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">
        <!-- Left Side - Branding/Info -->
        <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center position-relative">
            <div class="text-center text-white slide-in-left">
                <!-- Main Logo/Icon -->
                <div class="mb-5">
                    @if (Brand.HasCustomLogo)
                    {
                        @* An uploaded logo can be any shape (often a wide wordmark), so show it as-is with no tile behind it. *@
                        <div class="mb-4">
                            <img src="~/branding/logo?v=@Brand.Version" alt="@Brand.AppName" style="height: 96px; width: auto; max-width: 320px; object-fit: contain;" />
                        </div>
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-4 bg-white bg-opacity-20 p-4 mb-4" style="width: 120px; height: 120px; backdrop-filter: blur(10px);">
                            <img src="~/branding/logo?variant=mark&v=@Brand.Version" alt="@Brand.AppName" width="84" height="84" style="object-fit:contain;" />
                        </div>
                    }
                </div>

                <!-- Main Heading -->
                <h1 class="display-5 fw-bold mb-3 text-white">@Brand.AppName</h1>
                <p class="fs-5 mb-3 opacity-90">@Localizer["PointOfSaleSystem"]</p>
                <p class="lead mb-5 opacity-90">@Localizer["SystemDescription"]</p>

                <!-- Debug Info (Development Only) -->
                @if (ViewBag.IsDevelopment == true)
                {
                    <div class="erp-alert erp-alert-info small mb-4">
                        <strong>Debug:</strong> Current Culture: @currentCulture
                    </div>
                }

                <!-- Feature Cards -->
                <div class="row g-3 mb-5">
                    <div class="col-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-boxes"></i>
                            </div>
                            <div class="feature-text">@Localizer["Inventory"]</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="feature-text">@Localizer["Customers"]</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <div class="feature-text">@Localizer["Reports"]</div>
                        </div>
                    </div>
                </div>

                <!-- Language Switcher -->
                <div class="language-switcher">
                    <a href="@(ViewBag.EnglishUrl ?? "/en/Account/Login")" class="language-btn @(currentCulture.StartsWith("en") ? "active" : "")">
                        <i class="fas fa-globe me-2"></i>English
                    </a>
                    <a href="@(ViewBag.ArabicUrl ?? "/ar/Account/Login")" class="language-btn @(currentCulture.StartsWith("ar") ? "active" : "")">
                        <i class="fas fa-globe me-2"></i>العربية
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Side - Pick your name, then enter your PIN -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center p-3 p-lg-4">
            <div class="w-100 fade-in my-3" style="max-width: 420px;">
                <div class="card p-4">
                    <form asp-action="Login" method="post" id="loginForm">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="Username" type="hidden" id="usernameInput" />
                        <input asp-for="Pin" type="hidden" id="pinInput" />

                        @* A remembered user goes straight to their PIN pad; otherwise the page opens on the name picker. *@
                        <div id="viewPin" class="signin-view @(hasUser ? "" : "d-none")">
                            <div class="signin-avatar" id="selectedInitials">@selected?.Initials</div>
                            <div class="signin-welcome">@Localizer["WelcomeBack"]</div>
                            <div class="signin-uname" id="selectedUserName">@selected?.DisplayName</div>

                            <div class="pin-dots @(hasError ? "pin-shake" : "")" id="pinDots" aria-label="@Localizer["PIN"]">
                                <span class="pin-dot"></span>
                                <span class="pin-dot"></span>
                                <span class="pin-dot"></span>
                                <span class="pin-dot"></span>
                            </div>
                            <div class="pin-keypad">
                                @for (var d = 1; d <= 9; d++)
                                {
                                    <button type="button" class="pin-key" data-digit="@d">@d</button>
                                }
                                <button type="button" class="pin-key pin-key-action" id="pinClear">@Localizer["Clear"]</button>
                                <button type="button" class="pin-key" data-digit="0">0</button>
                                <button type="button" class="pin-key pin-key-action" id="pinBackspace" aria-label="Backspace">
                                    <i class="fas fa-backspace"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Pin" class="text-danger small d-block text-center mt-2"></span>
                            <div class="text-center small text-primary mt-2 d-none" id="signingIn">
                                <i class="fas fa-spinner fa-spin me-2"></i>@(ViewBag.Language == "ar" ? "جاري تسجيل الدخول..." : "Signing in...")
                            </div>

                            <!-- Error Messages -->
                            @if (hasError)
                            {
                                <div class="erp-alert erp-alert-danger mt-3 mb-0" role="alert">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            }

                            @if (Model.Users.Count > 1)
                            {
                                <div class="text-center mt-2">
                                    <button type="button" class="signin-link" id="switchUser">@Localizer["NotYouSwitchUser"]</button>
                                </div>
                            }
                        </div>

                        <div id="viewPick" class="signin-view @(hasUser ? "d-none" : "")">
                            <h3 class="signin-title">@Localizer["WhoIsSigningIn"]</h3>
                            @if (Model.Users.Count == 0)
                            {
                                <div class="signin-empty">@Localizer["NoUsersToSignIn"]</div>
                            }
                            else
                            {
                                <div class="signin-user-list">
                                    @foreach (var u in Model.Users)
                                    {
                                        var active = string.Equals(u.Username, Model.Username, StringComparison.OrdinalIgnoreCase);
                                        <button type="button" class="signin-user @(active ? "is-active" : "")" data-username="@u.Username" data-name="@u.DisplayName" data-initials="@u.Initials">
                                            <span class="signin-initials">@u.Initials</span>
                                            <span class="signin-name">@u.DisplayName</span>
                                        </button>
                                    }
                                </div>
                            }
                            <div class="text-center mt-2 @(hasUser ? "" : "d-none")" id="pickCancelWrap">
                                <button type="button" class="signin-link" id="pickCancel">@Localizer["Cancel"]</button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div class="text-center mt-4">
                    <small class="text-muted opacity-75">&copy; @DateTime.Now.Year @Brand.AppName. @Localizer["Copyright"]</small>
                </div>

                <!-- Mobile Language Switcher -->
                <div class="d-lg-none text-center mt-3">
                    <div class="language-switcher">
                        <a href="@(ViewBag.EnglishUrl ?? "/en/Account/Login")" class="language-btn @(currentCulture.StartsWith("en") ? "active" : "")">
                            <i class="fas fa-globe me-2"></i>English
                        </a>
                        <a href="@(ViewBag.ArabicUrl ?? "/ar/Account/Login")" class="language-btn @(currentCulture.StartsWith("ar") ? "active" : "")">
                            <i class="fas fa-globe me-2"></i>العربية
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var maxPinLength = 4;
            var $pin = $('#pinInput');
            var $form = $('#loginForm');
            var pinDots = $('#pinDots .pin-dot');
            var submitting = false;

            function pinViewVisible() {
                return !$('#viewPin').hasClass('d-none');
            }

            function renderPin() {
                var value = $pin.val();
                pinDots.each(function(index) {
                    $(this).toggleClass('pin-dot-filled', index < value.length);
                });
            }

            // The PIN submits itself on the fourth digit, like the register's sign-in screen.
            function addDigit(digit) {
                if (submitting || !pinViewVisible() || !$('#usernameInput').val()) return;
                var value = $pin.val();
                if (value.length >= maxPinLength) return;
                $pin.val(value + digit);
                renderPin();
                if ($pin.val().length === maxPinLength) submit();
            }

            function submit() {
                if (submitting) return;
                submitting = true;
                $('#signingIn').removeClass('d-none');
                $form.get(0).submit();
            }

            $('.pin-key[data-digit]').on('click', function() {
                addDigit($(this).data('digit').toString());
            });

            $('#pinBackspace').on('click', function() {
                if (submitting) return;
                $pin.val($pin.val().slice(0, -1));
                renderPin();
            });

            $('#pinClear').on('click', function() {
                if (submitting) return;
                $pin.val('');
                renderPin();
            });

            // Physical keyboard works too (faster for daily use)
            $(document).on('keydown', function(e) {
                if (e.metaKey || e.ctrlKey || e.altKey || !pinViewVisible()) return;
                if (e.key >= '0' && e.key <= '9') {
                    e.preventDefault();
                    addDigit(e.key);
                } else if (e.key === 'Backspace') {
                    e.preventDefault();
                    $('#pinBackspace').trigger('click');
                } else if (e.key === 'Delete' || e.key === 'Escape') {
                    e.preventDefault();
                    $('#pinClear').trigger('click');
                } else if (e.key === 'Enter') {
                    // Enter belongs to the PIN pad, not to whichever button last got focus.
                    e.preventDefault();
                    if ($pin.val().length === maxPinLength) submit();
                }
            });

            function showPinView() {
                $('#viewPick').addClass('d-none');
                $('#viewPin').removeClass('d-none');
            }

            function showPicker() {
                $pin.val('');
                renderPin();
                $('#viewPin').addClass('d-none');
                $('#viewPick').removeClass('d-none');
            }

            $('#switchUser').on('click', showPicker);
            $('#pickCancel').on('click', showPinView);

            // Choosing a different name starts the PIN over; choosing the same one just goes back to the pad.
            $('.signin-user').on('click', function() {
                var $row = $(this);
                if (!$row.hasClass('is-active')) {
                    $('.signin-user').removeClass('is-active');
                    $row.addClass('is-active');
                    $('#usernameInput').val($row.data('username'));
                    $('#selectedUserName').text($row.data('name'));
                    $('#selectedInitials').text($row.data('initials'));
                    $pin.val('');
                    renderPin();
                    $('#pinDots').removeClass('pin-shake');
                    $('.erp-alert-danger, [data-valmsg-for="Pin"]').addClass('d-none');
                }
                $('#pickCancelWrap').removeClass('d-none');
                showPinView();
            });

            // Never keep a PIN across a page reload/reset (e.g. after a failed attempt or back navigation)
            $pin.val('');
            renderPin();
        });

        // Inline RTL/LTR direction handling for immediate effect
        var currentLang = '@ViewBag.Language' || 'en';
        if (currentLang === 'ar') {
            document.documentElement.setAttribute('dir', 'rtl');
            document.documentElement.setAttribute('lang', 'ar');
            document.body.classList.add('rtl');
        }
    </script>

    <style>
        .signin-avatar {
            width: 84px;
            height: 84px;
            margin: 4px auto 10px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: var(--teal-primary, #0a7b85);
            color: #fff;
            font-size: 1.6rem;
            font-weight: 700;
        }

        .signin-welcome {
            text-align: center;
            font-size: 0.85rem;
            color: #6c757d;
        }

        .signin-uname {
            text-align: center;
            font-size: 1.4rem;
            font-weight: 800;
            color: #212529;
            margin-bottom: 2px;
        }

        .signin-title {
            text-align: center;
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .signin-link {
            background: none;
            border: 0;
            padding: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--teal-primary, #0a7b85);
            cursor: pointer;
        }

        .signin-link:hover {
            text-decoration: underline;
        }

        .signin-link:focus-visible {
            outline: 2px solid var(--teal-primary, #0a7b85);
            outline-offset: 2px;
        }

        /* Staff lists grow; the picker scrolls rather than pushing the card off screen. */
        .signin-user-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 340px;
            overflow-y: auto;
            padding: 2px;
        }

        .signin-user {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid #dee2e6;
            border-radius: 12px;
            background: #fff;
            font: inherit;
            text-align: start;
            cursor: pointer;
            transition: border-color 0.14s ease, box-shadow 0.14s ease;
        }

        .signin-user:hover {
            border-color: var(--teal-primary, #0a7b85);
        }

        .signin-user:focus-visible {
            outline: 2px solid var(--teal-primary, #0a7b85);
            outline-offset: 1px;
        }

        .signin-user.is-active {
            border-color: var(--teal-primary, #0a7b85);
            box-shadow: 0 0 0 3px rgba(10, 123, 133, 0.15);
        }

        .signin-initials {
            width: 40px;
            height: 40px;
            flex: none;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #495057;
            color: #fff;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .signin-user.is-active .signin-initials {
            background: var(--teal-primary, #0a7b85);
        }

        .signin-name {
            font-weight: 700;
            font-size: 0.95rem;
            color: #212529;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .signin-empty {
            padding: 16px;
            text-align: center;
            font-size: 0.85rem;
            color: #6c757d;
            border: 1px dashed #dee2e6;
            border-radius: 12px;
        }

        .pin-dots {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin: 10px 0 16px;
            outline: none;
        }

        .pin-dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 2px solid var(--teal-primary, #0a7b85);
            background: transparent;
            transition: background-color 0.15s ease;
        }

        .pin-dot-filled {
            background: var(--teal-primary, #0a7b85);
        }

        .pin-shake {
            animation: pin-shake 0.4s ease;
        }

        @@keyframes pin-shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        .pin-keypad {
            display: grid;
            direction: ltr; /* keep 1-2-3 order in RTL */
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            max-width: 280px;
            margin: 0 auto;
        }

        .pin-key {
            padding: 12px 0;
            font-size: 1.25rem;
            font-weight: 600;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background: #fff;
            color: #212529;
            transition: background-color 0.15s ease;
        }

        .pin-key:focus-visible {
            outline: 2px solid var(--teal-primary, #0a7b85);
            outline-offset: 1px;
        }

        .pin-key:hover {
            background: #f1f3f5;
        }

        .pin-key:active {
            background: #e9ecef;
        }

        .pin-key-action {
            font-size: 0.95rem;
            color: #6c757d;
        }

        /* Short windows (a 1366x768 laptop's browser leaves ~650px): keep the whole pad on screen. */
        @@media (max-height: 820px) {
            .card { padding: 1.25rem !important; }
            .signin-avatar { width: 64px; height: 64px; font-size: 1.3rem; margin-bottom: 6px; }
            .signin-uname { font-size: 1.2rem; }
            .pin-dots { margin: 6px 0 10px; }
            .pin-key { padding: 8px 0; }
            .signin-user-list { max-height: 260px; }
        }
    </style>
}

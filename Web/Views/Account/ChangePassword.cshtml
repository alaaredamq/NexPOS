@model Web.Models.Auth.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change PIN";
    ViewData["Subtitle"] = "Update your login PIN";
}

<!-- Change PIN Header -->
<div class="d-flex justify-content-end mb-4">
    <a href="@Url.Action("Profile", "Account", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Profile
    </a>
</div>

<!-- Change PIN Form -->
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-lock me-2"></i>
                    PIN Update
                </h5>
            </div>
            <div class="products-card-body">
                <form asp-action="ChangePassword" method="post" class="pinpad-wrap"
                      data-pinpad data-pin-length="4" data-clear-label="@Localizer["Clear"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="pinpad-field is-active" data-pinpad-field>
                        <label asp-for="CurrentPin" class="form-label d-block">Current PIN</label>
                        <input asp-for="CurrentPin" type="hidden" data-pinpad-input autocomplete="off" />
                        <div class="pin-dots-row" data-pinpad-dots></div>
                        <span asp-validation-for="CurrentPin" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="pinpad-field" data-pinpad-field>
                        <label asp-for="NewPin" class="form-label d-block">New PIN</label>
                        <input asp-for="NewPin" type="hidden" data-pinpad-input autocomplete="off" />
                        <div class="pin-dots-row" data-pinpad-dots></div>
                        <span asp-validation-for="NewPin" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="pinpad-field" data-pinpad-field>
                        <label asp-for="ConfirmPin" class="form-label d-block">Confirm New PIN</label>
                        <input asp-for="ConfirmPin" type="hidden" data-pinpad-input autocomplete="off" />
                        <div class="pin-dots-row" data-pinpad-dots></div>
                        <span asp-validation-for="ConfirmPin" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="pin-keypad" data-pinpad-keys></div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <a href="@Url.Action("Profile", "Account", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-teal">
                            <i class="fas fa-save me-2"></i>Update PIN
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- PIN Guidance -->
        <div class="products-table-card mt-4">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    About your PIN
                </h5>
            </div>
            <div class="products-card-body">
                <ul class="pin-guidance">
                    <li><i class="fas fa-check text-success me-2"></i><span>Must be exactly 4 digits</span></li>
                    <li><i class="fas fa-check text-success me-2"></i><span>Must be different from your current PIN</span></li>
                    <li><i class="fas fa-check text-success me-2"></i><span>Avoid obvious sequences like 1234 or 0000</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_PinPad" />

    <style>
        .pin-guidance {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .pin-guidance li {
            display: flex;
            align-items: center;
            padding: 4px 0;
            font-size: 14px;
        }
    </style>
}

            runNow: '@Html.Raw(Localizer["RunNow"].Value)',
            backupStartedFromSchedule: '@Html.Raw(Localizer["BackupStartedFromSchedule"].Value)',
            failedToRunSchedule: '@Html.Raw(Localizer["FailedToRunSchedule"].Value)'

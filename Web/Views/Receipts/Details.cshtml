@using Core.Entities.Sales
@using System.Globalization
@model Core.Entities.Sales.Receipt

@{
    ViewData["Title"] = Localizer["ReceiptDetails"];
    ViewData["Subtitle"] = Localizer["Receipt"] + " #" + Model.ReceiptNumber;
}

<div class="container-fluid">
    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index", "Receipts")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToReceipts"]
                </a>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" onclick="printReceipt()">
                        <i class="fas fa-print me-2"></i>@Localizer["PrintReceipt"]
                    </button>
                    <button class="btn btn-success" onclick="downloadPdf()">
                        <i class="fas fa-download me-2"></i>@Localizer["DownloadPDF"]
                    </button>
                    <button class="btn btn-info" onclick="emailReceipt()">
                        <i class="fas fa-envelope me-2"></i>@Localizer["Email"]
                    </button>
                    @if (!Model.IsVoid)
                    {
                        <button class="btn btn-danger" onclick="voidReceipt()">
                            <i class="fas fa-ban me-2"></i>@Localizer["VoidReceipt"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Receipt Status Badge -->
    @if (Model.IsVoid)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="erp-alert erp-alert-danger">
                    <i class="fas fa-ban me-2"></i>
                    <strong>@Localizer["ThisReceiptHasBeenVoided"]</strong>
                    @if (!string.IsNullOrEmpty(Model.VoidReason))
                    {
                        <br />
                        <span>@Localizer["ReasonLabel"] @Model.VoidReason</span>
                    }
                    @if (Model.VoidDate.HasValue)
                    {
                        <br />
                        <span>@Localizer["VoidedOnLabel"] @Model.VoidDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Receipt Details Card -->
        <div class="col-lg-8">
            <div class="card modern-card mb-4">
                <div class="card-header modern-header">
                    <h5 class="mb-0">
                        <i class="fas fa-receipt me-2"></i>@Localizer["ReceiptInformation"]
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Receipt Header Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <table class="table table-borderless table-sm">
                                <tr>
                                    <td class="text-muted" width="40%">@Localizer["ReceiptNumber"]</td>
                                    <td><strong>@Model.ReceiptNumber</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">@Localizer["ReceiptDate"]</td>
                                    <td>@Model.ReceiptDate.ToString("MMMM dd, yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">@Localizer["OrderID"]</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Orders", new { id = Model.OrderId })">
                                            #@Model.OrderId
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless table-sm">
                                <tr>
                                    <td class="text-muted" width="40%">@Localizer["Customer"]</td>
                                    <td>
                                        @if (Model.Customer != null)
                                        {
                                            <span>@Model.Customer.FirstName @Model.Customer.LastName</span>
                                        }
                                        else if (!string.IsNullOrEmpty(Model.CustomerName))
                                        {
                                            <span>@Model.CustomerName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Localizer["WalkInCustomer"]</span>
                                        }
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                                {
                                    <tr>
                                        <td class="text-muted">@Localizer["Phone"]</td>
                                        <td>@Model.CustomerPhone</td>
                                    </tr>
                                }
                                <tr>
                                    <td class="text-muted">@Localizer["Cashier"]</td>
                                    <td>@Model.Cashier?.FirstName @Model.Cashier?.LastName</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Receipt Items -->
                    <div class="table-responsive">
                        <table class="table table-hover modern-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Item"]</th>
                                    <th class="text-center">@Localizer["Quantity"]</th>
                                    <th class="text-end">@Localizer["UnitPrice"]</th>
                                    <th class="text-end">@Localizer["Discount"]</th>
                                    <th class="text-end">@Localizer["Tax"]</th>
                                    <th class="text-end">@Localizer["Total"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in (Model.ReceiptItems ?? Enumerable.Empty<ReceiptItem>()).Where(i => !i.IsDeleted))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.ProductName</div>
                                            @if (!string.IsNullOrEmpty(item.ProductBarcode))
                                            {
                                                <small class="text-muted">@Localizer["Barcode"] @item.ProductBarcode</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @item.Quantity.ToString("N3", CultureInfo.InvariantCulture)@(!string.IsNullOrEmpty(item.Unit) && item.Unit != "piece" ? $" {item.Unit}" : "")
                                        </td>
                                        <td class="text-end">@Model.Currency.Notation@item.UnitPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td class="text-end">
                                            @if (item.DiscountAmount > 0)
                                            {
                                                <span class="text-danger">-@Model.Currency.Notation@item.DiscountAmount.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end">@Model.Currency.Notation@item.TaxAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td class="text-end fw-bold">@Model.Currency.Notation@item.LineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals -->
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <td class="text-muted">@Localizer["Subtotal"]</td>
                                    <td class="text-end">@Model.Currency.Notation@Model.SubTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr>
                                        <td class="text-muted">@Localizer["DiscountLabel"]</td>
                                        <td class="text-end text-danger">-@Model.Currency.Notation@Model.DiscountAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                                <tr>
                                    <td class="text-muted">@Localizer["TaxLabel"]</td>
                                    <td class="text-end">@Model.Currency.Notation@Model.TaxAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                                <tr class="table-active">
                                    <td class="fw-bold">@Localizer["TotalAmount"]</td>
                                    <td class="text-end fw-bold fs-5">@Model.Currency.Notation@Model.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">@Localizer["AmountPaid"]</td>
                                    <td class="text-end text-success">@Model.Currency.Notation@Model.AmountPaid.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                                @if (Model.ChangeAmount > 0)
                                {
                                    <tr>
                                        <td class="text-muted">@Localizer["Change"]</td>
                                        <td class="text-end">@Model.Currency.Notation@Model.ChangeAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Details -->
            @if (Model.ReceiptPayments != null && Model.ReceiptPayments.Any())
            {
                <div class="card modern-card">
                    <div class="card-header modern-header">
                        <h5 class="mb-0">
                            <i class="fas fa-credit-card me-2"></i>@Localizer["PaymentDetails"]
                        </h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover modern-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["PaymentMethod"]</th>
                                    <th>@Localizer["ReferenceNumber"]</th>
                                    <th class="text-end">@Localizer["Amount"]</th>
                                    <th>@Localizer["Date"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in (Model.ReceiptPayments ?? Enumerable.Empty<ReceiptPayment>()).Where(p => !p.IsDeleted))
                                {
                                    <tr>
                                        <td>@payment.PaymentMethod.Name</td>
                                        <td>@(payment.ReferenceNumber ?? "-")</td>
                                        <td class="text-end fw-bold">@Model.Currency.Notation@payment.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td>@payment.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Payment Summary -->
            <div class="card modern-card mb-4">
                <div class="card-header modern-header">
                    <h5 class="mb-0">
                        <i class="fas fa-money-bill-wave me-2"></i>@Localizer["PaymentSummary"]
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">@Localizer["PaymentMethodLabel"]</span>
                        <span class="fw-bold">@Model.PaymentMethod?.Name</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">@Localizer["Currency"]</span>
                        <span class="fw-bold">@Model.Currency?.Code (@Model.Currency?.Notation)</span>
                    </div>
                    @if (Model.ExchangeRate != 1.0m)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">@Localizer["ExchangeRate"]</span>
                            <span class="fw-bold">@Model.ExchangeRate.ToString("N4", CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">@Localizer["Status"]</span>
                        @if (Model.IsVoid)
                        {
                            <span class="badge bg-danger">@Localizer["Void"]</span>
                        }
                        else if (Model.IsFullyPaid())
                        {
                            <span class="badge bg-success">@Localizer["Paid"]</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">@Localizer["Partial"]</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Receipt History -->
            <div class="card modern-card">
                <div class="card-header modern-header">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>@Localizer["ReceiptHistory"]
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <div class="text-muted small">@Localizer["ReceiptCreated"]</div>
                                <div class="fw-bold">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        </div>
                        @if (Model.PrintedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <div class="text-muted small">@Localizer["Printed"]</div>
                                    <div class="fw-bold">@Model.PrintedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                    @if (!string.IsNullOrEmpty(Model.PrintedBy))
                                    {
                                        <div class="small">@Localizer["By"] @Model.PrintedBy</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.EmailSentAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <div class="text-muted small">@Localizer["Emailed"]</div>
                                    <div class="fw-bold">@Model.EmailSentAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                    @if (!string.IsNullOrEmpty(Model.EmailSentTo))
                                    {
                                        <div class="small">@Localizer["To"] @Model.EmailSentTo</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.IsVoid && Model.VoidDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-danger"></div>
                                <div class="timeline-content">
                                    <div class="text-muted small">@Localizer["Voided"]</div>
                                    <div class="fw-bold">@Model.VoidDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                    @if (Model.VoidedByUser != null)
                                    {
                                        <div class="small">@Localizer["By"] @Model.VoidedByUser.FirstName @Model.VoidedByUser.LastName</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Notes -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="card modern-card mt-4">
                    <div class="card-header modern-header">
                        <h5 class="mb-0">
                            <i class="fas fa-sticky-note me-2"></i>@Localizer["Notes"]
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Email Receipt Modal -->
<div class="modal fade" id="emailReceiptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["EmailReceipt"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">@Localizer["EmailAddress"]</label>
                    <input type="email" class="form-control" id="emailAddress" 
                           placeholder="customer@example.com"
                           value="@Model.Customer?.Email">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" onclick="confirmEmailReceipt()">@Localizer["SendEmail"]</button>
            </div>
        </div>
    </div>
</div>

<!-- Void Receipt Modal -->
<div class="modal fade" id="voidReceiptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["VoidReceipt"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">@Localizer["ReasonForVoiding"]</label>
                    <textarea class="form-control" id="voidReason" rows="3" 
                              placeholder="@Localizer["EnterReasonForVoiding"]"></textarea>
                </div>
                <div class="erp-alert erp-alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @Localizer["VoidWarning"]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" onclick="confirmVoidReceipt()">@Localizer["VoidReceipt"]</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .modern-card {
            border: none;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            border-radius: 8px;
        }

        .modern-header {
            background-color: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
            padding: 1rem 1.5rem;
        }

        .modern-table {
            margin-bottom: 0;
        }

        .modern-table thead th {
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
            color: #495057;
        }

        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }

        .timeline-item:not(:last-child):before {
            content: '';
            position: absolute;
            left: -21px;
            top: 20px;
            height: calc(100% - 10px);
            width: 2px;
            background-color: #dee2e6;
        }

        .timeline-marker {
            position: absolute;
            left: -26px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid white;
        }

        .timeline-content {
            padding-left: 10px;
        }

        .table-active {
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    <script>
        // Localized strings for JavaScript
        window.receiptDetailsLocalizedStrings = {
            pleaseEnterEmailAddress: '@Html.Raw(Localizer["PleaseEnterEmailAddress"].Value)',
            receiptSentSuccessfully: '@Html.Raw(Localizer["ReceiptSentSuccessfully"].Value)',
            failedToSendReceipt: '@Html.Raw(Localizer["FailedToSendReceipt"].Value)',
            pleaseEnterReasonForVoiding: '@Html.Raw(Localizer["PleaseEnterReasonForVoiding"].Value)',
            receiptVoidedSuccessfully: '@Html.Raw(Localizer["ReceiptVoidedSuccessfully"].Value)',
            failedToVoidReceipt: '@Html.Raw(Localizer["FailedToVoidReceipt"].Value)'
        };

        function printReceipt() {
            window.print();
        }

        function downloadPdf() {
            window.location.href = '@Url.Action("DownloadPdf", "Receipts", new { id = Model.Id })';
        }

        function emailReceipt() {
            $('#emailReceiptModal').modal('show');
        }

        function confirmEmailReceipt() {
            const email = $('#emailAddress').val();
            if (!email.trim()) {
                toastr.warning(window.receiptDetailsLocalizedStrings.pleaseEnterEmailAddress);
                return;
            }

            $.ajax({
                url: '@Url.Action("SendEmail", "Receipts", new { id = Model.Id })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ emailAddress: email }),
                success: function(response) {
                    if (response.success) {
                        toastr.success(window.receiptDetailsLocalizedStrings.receiptSentSuccessfully);
                        $('#emailReceiptModal').modal('hide');
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    toastr.error(window.receiptDetailsLocalizedStrings.failedToSendReceipt);
                }
            });
        }

        function voidReceipt() {
            $('#voidReceiptModal').modal('show');
        }

        function confirmVoidReceipt() {
            const reason = $('#voidReason').val();
            if (!reason.trim()) {
                toastr.warning(window.receiptDetailsLocalizedStrings.pleaseEnterReasonForVoiding);
                return;
            }

            $.ajax({
                url: '@Url.Action("VoidReceipt", "Receipts", new { id = Model.Id })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ reason: reason }),
                success: function(response) {
                    if (response.success) {
                        toastr.success(window.receiptDetailsLocalizedStrings.receiptVoidedSuccessfully);
                        location.reload();
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    toastr.error(window.receiptDetailsLocalizedStrings.failedToVoidReceipt);
                }
            });
        }
    </script>
}

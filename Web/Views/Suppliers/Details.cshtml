@model Core.Entities.Products.Supplier
@using Core.Enum
@using Core.Entities.Products

@{
    ViewData["Title"] = Localizer["SupplierDetails"];
    ViewData["Subtitle"] = Model.Name;
    var netDebt = Model.Balance;
    var debtToSupplier = netDebt > 0 ? netDebt : 0m;
    var debtFromSupplier = netDebt < 0 ? -netDebt : 0m;
    var currencyNotation = Model.Currency?.Notation;
    var debtTransactions = ViewBag.DebtTransactions as List<SupplierDebtTransaction> ?? new List<SupplierDebtTransaction>();
}

@Html.AntiForgeryToken()

<!-- Supplier Details Header -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="@Url.Action("Edit", "Suppliers", new { id = Model.Id, lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-teal">
        <i class="fas fa-edit me-2"></i>@Localizer["EditSupplier"]
    </a>
    <a href="@Url.Action("Index", "Suppliers", new { lang = ViewBag.CurrentLanguage ?? "en" })" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToSuppliers"]
    </a>
</div>

<!-- Supplier Details Content -->
<div class="row">
    <div class="col-lg-8">
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-id-card me-2"></i>
                    @Localizer["SupplierInformation"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["SupplierName"]</label>
                        <p class="detail-value">@Model.Name</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["Status"]</label>
                        <p class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@Localizer["Inactive"]</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["EmailAddress"]</label>
                        <p class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-teal">@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["NotProvided"]</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["PhoneNumber"]</label>
                        <p class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-teal">@Model.Phone</a>
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["NotProvided"]</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="detail-label">@Localizer["Address"]</label>
                        <p class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                @Model.Address
                                @if (!string.IsNullOrEmpty(Model.City))
                                {
                                    <span>, @Model.City</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Country))
                                {
                                    <span>, @Model.Country</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.PostalCode))
                                {
                                    <span> - @Model.PostalCode</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["NoAddressProvided"]</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["DiscountRate"]</label>
                        <p class="detail-value">@Model.DiscountRate.ToString("F2")%</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["Currency"]</label>
                        <p class="detail-value">@(Model.Currency?.Name ?? "N/A")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Debt Information Card -->
        <div class="products-table-card mt-4">
            <div class="products-card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-money-bill-wave me-2"></i>
                    @Localizer["DebtInformation"]
                </h5>
                <button type="button" class="btn btn-sm btn-teal" onclick="openAddDebtTransaction(@Model.Id)">
                    <i class="fas fa-plus me-1"></i>@Localizer["AddTransaction"]
                </button>
            </div>
            <div class="products-card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["DebtToSupplier"]</label>
                        <p class="detail-value">
                            <span class="text-danger fw-bold">
                                <i class="fas fa-arrow-up me-2"></i>@FormatCurrency(debtToSupplier, currencyNotation)
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="detail-label">@Localizer["DebtFromSupplier"]</label>
                        <p class="detail-value">
                            <span class="text-success fw-bold">
                                <i class="fas fa-arrow-down me-2"></i>@FormatCurrency(debtFromSupplier, currencyNotation)
                            </span>
                        </p>
                    </div>
                </div>

                <hr>

                <div class="erp-alert @(netDebt > 0 ? "erp-alert-danger" : netDebt < 0 ? "erp-alert-success" : "erp-alert-info") mb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><strong>@Localizer["NetDebt"]</strong></h6>
                            <p class="mb-0">
                                @if (netDebt > 0)
                                {
                                    <span class="fw-bold">@Localizer["YouOwe"]: @FormatCurrency(Math.Abs(netDebt), Model.Currency?.Notation)</span>
                                }
                                else if (netDebt < 0)
                                {
                                    <span class="fw-bold">@Localizer["TheyOweYouAmount"]: @FormatCurrency(Math.Abs(netDebt), Model.Currency?.Notation)</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@Localizer["BalancedNoDebt"]</span>
                                }
                            </p>
                        </div>
                        <div>
                            @if (netDebt > 0)
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-exclamation-triangle me-1"></i>@Localizer["PaymentDue"]
                                </span>
                            }
                            else if (netDebt < 0)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="fas fa-check-circle me-1"></i>@Localizer["Receivable"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="fas fa-balance-scale me-1"></i>@Localizer["Balanced"]
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @if (debtTransactions.Any())
                {
                    <hr>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@Localizer["Date"]</th>
                                    <th>@Localizer["Type"]</th>
                                    <th>@Localizer["Note"]</th>
                                    <th class="text-end">@Localizer["Amount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in debtTransactions.Take(20))
                                {
                                    <tr>
                                        <td>@tx.CreatedAt.UtcToLocal().ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            @if (tx.Type == SupplierDebtTransactionType.Purchase)
                                            {
                                                <span class="badge bg-info">@Localizer["TypePurchase"]</span>
                                            }
                                            else if (tx.Type == SupplierDebtTransactionType.Payment)
                                            {
                                                <span class="badge bg-success">@Localizer["TypePayment"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Localizer["TypeAdjustment"]</span>
                                            }
                                        </td>
                                        <td>@(tx.Note ?? "-")</td>
                                        @* A positive amount raises what I owe, so it is the "bad" direction (red). *@
                                        <td class="text-end fw-bold @(tx.Amount > 0 ? "text-danger" : "text-success")">
                                            @(tx.Amount > 0 ? "+" : "")@FormatCurrency(tx.Amount, currencyNotation)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (debtTransactions.Count > 20)
                    {
                        <p class="text-muted text-center mt-2 mb-0"><small>@Localizer["ShowingRecent", debtTransactions.Count]</small></p>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Supplier Summary Card -->
    <div class="col-lg-4">
        <div class="products-table-card mb-4">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>
                    @Localizer["SupplierSummary"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="supplier-avatar text-center mb-4">
                    <div class="avatar-circle mx-auto">
                        <span class="avatar-initials" style="color: var(--primary-color)">
                            @Model.Name.Substring(0, Math.Min(2, Model.Name.Length)).ToUpper()
                        </span>
                    </div>
                    <h5 class="mt-3 mb-1">@Model.Name</h5>
                    <p class="text-muted small">@Localizer["Supplier"] #@Model.Id</p>
                </div>

                <hr>

                <div class="summary-stats">
                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-box"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@Localizer["TotalProducts"]</div>
                            <div class="stat-value">@(Model.Products?.Count ?? 0)</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">
                            <i class="fas fa-percent"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@Localizer["DiscountRate"]</div>
                            <div class="stat-value">@Model.DiscountRate.ToString("F2")%</div>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon @(netDebt > 0 ? "bg-danger" : netDebt < 0 ? "bg-success" : "bg-secondary")">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">@Localizer["NetDebt"]</div>
                            <div class="stat-value @(netDebt > 0 ? "text-danger" : netDebt < 0 ? "text-success" : "text-muted")">
                                @if (netDebt > 0)
                                {
                                    <span>-@FormatCurrency(Math.Abs(netDebt), Model.Currency?.Notation)</span>
                                }
                                else if (netDebt < 0)
                                {
                                    <span>+@FormatCurrency(Math.Abs(netDebt), Model.Currency?.Notation)</span>
                                }
                                else
                                {
                                    <span>@FormatCurrency(netDebt, Model.Currency?.Notation)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="products-table-card">
            <div class="products-card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-bolt me-2"></i>
                    @Localizer["QuickActions"]
                </h5>
            </div>
            <div class="products-card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "Suppliers", new { id = Model.Id })" class="btn btn-outline-teal">
                        <i class="fas fa-edit me-2"></i>@Localizer["EditSupplier"]
                    </a>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="btn btn-outline-info">
                            <i class="fas fa-envelope me-2"></i>@Localizer["SendEmail"]
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <a href="tel:@Model.Phone" class="btn btn-outline-info">
                            <i class="fas fa-phone me-2"></i>@Localizer["CallSupplier"]
                        </a>
                    }
                    <button type="button" class="btn btn-outline-danger" onclick="deleteSupplier(@Model.Id)">
                        <i class="fas fa-trash me-2"></i>@Localizer["DeleteSupplier"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="erp-alert erp-alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="erp-alert erp-alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section Scripts {
    <script src="~/js/Pages/Customers/DebtDialog.js" asp-append-version="true"></script>
    <script>
        function openAddDebtTransaction(supplierId) {
            window.openDebtTransactionDialog(supplierId, '@Url.Action("AddDebtTransaction", "Suppliers")',
                () => window.location.reload(), {
                    idField: 'SupplierId',
                    directionField: 'IOweMore',
                    plusTitle: @Json.Serialize(Localizer["DebtDialogPlusTitle"].Value),
                    plusSub: @Json.Serialize(Localizer["DebtDialogPlusSub"].Value),
                    minusTitle: @Json.Serialize(Localizer["DebtDialogMinusTitle"].Value),
                    minusSub: @Json.Serialize(Localizer["DebtDialogMinusSub"].Value),
                    increaseText: @Json.Serialize(Localizer["DebtDialogIncrease"].Value),
                    decreaseText: @Json.Serialize(Localizer["DebtDialogDecrease"].Value)
                });
        }

        function deleteSupplier(id) {
            var confirmMsg = @Json.Serialize(Localizer["DeleteConfirmText"].Value);

            Swal.fire({
                title: @Json.Serialize(Localizer["ConfirmTitle"].Value),
                text: confirmMsg,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: @Json.Serialize(Localizer["YesDelete"].Value),
                cancelButtonText: @Json.Serialize(Localizer["Cancel"].Value)
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Suppliers")',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    title: @Json.Serialize(Localizer["DeletedTitle"].Value),
                                    text: response.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.href = '@Url.Action("Index", "Suppliers")';
                                });
                            } else {
                                Swal.fire(
                                    @Json.Serialize(Localizer["ErrorTitle"].Value), 
                                    response.message, 
                                    'error'
                                );
                            }
                        },
                        error: function() {
                            Swal.fire(
                                @Json.Serialize(Localizer["ErrorTitle"].Value), 
                                @Json.Serialize(Localizer["DeleteError"].Value), 
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>

    <style>
    .detail-label {
        font-weight: 600;
        color: var(--gray-700);
        font-size: 14px;
        margin-bottom: 4px;
    }

    .detail-value {
        color: var(--gray-800);
        font-size: 16px;
        margin-bottom: 0;
    }

    .text-teal {
        color: var(--teal-primary) !important;
        text-decoration: none;
    }

    .text-teal:hover {
        text-decoration: underline;
    }

    .avatar-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--teal-primary), var(--teal-darker));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(10, 123, 133, 0.3);
    }

    .avatar-initials {
        font-size: 36px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
    }

    .summary-stats {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--teal-lighter);
        color: var(--teal-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-content {
        flex: 1;
    }

    .stat-label {
        font-size: 12px;
        color: var(--gray-600);
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 18px;
        font-weight: 600;
        color: var(--gray-800);
    }
</style>

}
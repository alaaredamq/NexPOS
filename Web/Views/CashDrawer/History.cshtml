@{
    ViewData["Title"] = "Cash Drawer History";
    // shown by the top bar - repeating it in the page body printed the heading twice
    ViewData["Subtitle"] = "View past cash drawer sessions and Z-Reports";
}

<div class="container-fluid">
    <!-- Actions -->
    <div class="d-flex justify-content-end align-items-center mb-4">
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" id="startDate">
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control" id="endDate">
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <button type="button" class="btn btn-primary d-block w-100" onclick="loadHistory()">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- History Table -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Session History</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="historyTable">
                    <thead>
                        <tr>
                            <th>Session ID</th>
                            <th>Opened At</th>
                            <th>Closed At</th>
                            <th class="text-end">Opening Cash</th>
                            <th class="text-end">Total Sales</th>
                            <th class="text-center">Transactions</th>
                            <th class="text-end">Cash Difference</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="fas fa-spinner fa-spin me-2"></i>Loading history...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set default dates (last 30 days)
            const endDate = new Date();
            const startDate = new Date();
            startDate.setDate(startDate.getDate() - 30);
            
            $('#startDate').val(localDateString(startDate));
            $('#endDate').val(localDateString(endDate));
            
            loadHistory();
        });

        function loadHistory() {
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();
            
            $.ajax({
                url: '@Url.Action("GetHistory")',
                data: { startDate: startDate, endDate: endDate },
                success: function(response) {
                    if (response.success && response.data.length > 0) {
                        let html = '';
                        response.data.forEach(function(session) {
                            const statusBadge = session.isOpen 
                                ? '<span class="badge bg-success">Open</span>'
                                : '<span class="badge bg-secondary">Closed</span>';
                            
                            const diffClass = !session.cashDifference ? '' : 
                                session.cashDifference > 0 ? 'text-success' : 'text-danger';
                            
                            const diffText = !session.cashDifference ? '-' :
                                (session.cashDifference > 0 ? '+' : '') + '$' + session.cashDifference.toFixed(2);
                            
                            html += `
                                <tr>
                                    <td>#${session.id}</td>
                                    <td>${new Date(session.openedAt).toLocaleString()}</td>
                                    <td>${session.closedAt ? new Date(session.closedAt).toLocaleString() : '-'}</td>
                                    <td class="text-end">$${session.openingCash.toFixed(2)}</td>
                                    <td class="text-end">${session.totalSales ? '$' + session.totalSales.toFixed(2) : '-'}</td>
                                    <td class="text-center">${session.totalTransactions || '-'}</td>
                                    <td class="text-end ${diffClass}">${diffText}</td>
                                    <td>${statusBadge}</td>
                                    <td class="text-center">
                                        ${session.isOpen 
                                            ? `<a href="@Url.Action("Close")/${session.id}" class="btn btn-sm btn-warning" title="Close Session">
                                                <i class="fas fa-check-circle"></i>
                                               </a>`
                                            : `<a href="@Url.Action("ZReport")/${session.id}" class="btn btn-sm btn-primary" title="View Z-Report">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                               </a>`
                                        }
                                    </td>
                                </tr>
                            `;
                        });
                        $('#historyTableBody').html(html);
                    } else {
                        $('#historyTableBody').html(`
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle me-2"></i>No sessions found for the selected date range
                                </td>
                            </tr>
                        `);
                    }
                },
                error: function() {
                    $('#historyTableBody').html(`
                        <tr>
                            <td colspan="9" class="text-center text-danger py-4">
                                <i class="fas fa-exclamation-triangle me-2"></i>Failed to load history
                            </td>
                        </tr>
                    `);
                }
            });
        }
    </script>
}


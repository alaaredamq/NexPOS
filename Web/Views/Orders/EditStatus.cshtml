@model Application.DTOs.Orders.UpdateOrderStatusRequest

@{
    ViewData["Title"] = Localizer["UpdateOrderStatus"].Value;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
            <p class="text-muted">@ViewData["Subtitle"]</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Orders")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToOrders"]
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["UpdateOrderStatus"]</h6>
                </div>
                <div class="card-body">
                    <form asp-action="EditStatus" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input asp-for="OrderId" type="hidden" />
                        
                        <div class="mb-4">
                            <label class="form-label">@Localizer["CurrentOrderInformation"]</label>
                            <div class="bg-light p-3 rounded">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>@Localizer["OrderID"]:</strong> @Model.OrderId
                                    </div>
                                    <div class="col-md-6">
                                        <strong>@Localizer["CurrentStatus"]:</strong> 
                                        @switch (Model.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-warning">@Localizer["Pending"]</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-info">@Localizer["Processing"]</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-primary">@Localizer["Shipped"]</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-success">@Localizer["Delivered"]</span>
                                                break;
                                            case 4:
                                                <span class="badge bg-danger">@Localizer["Cancelled"]</span>
                                                break;
                                            case 5:
                                                <span class="badge bg-secondary">@Localizer["Returned"]</span>
                                                break;
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">@Localizer["NewStatus"]</label>
                            @await Component.InvokeAsync("Select2", new Web.Models.Shared.Select2Model
                            {
                                Id = "Status",
                                Name = "Status",
                                Placeholder = Localizer["SelectStatus"].Value,
                                Required = true,
                                Value = Model.Status,
                                Items = new List<Web.Models.Shared.Select2Item>
                                {
                                    new() { Id = "0", Text = Localizer["Pending"].Value, Selected = Model.Status == 0 },
                                    new() { Id = "1", Text = Localizer["Processing"].Value, Selected = Model.Status == 1 },
                                    new() { Id = "2", Text = Localizer["Shipped"].Value, Selected = Model.Status == 2 },
                                    new() { Id = "3", Text = Localizer["Delivered"].Value, Selected = Model.Status == 3 },
                                    new() { Id = "4", Text = Localizer["Cancelled"].Value, Selected = Model.Status == 4 },
                                    new() { Id = "5", Text = Localizer["Returned"].Value, Selected = Model.Status == 5 }
                                }
                            })
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["StatusDescription"]</label>
                            <div class="erp-alert erp-alert-info">
                                <div id="statusDescription">
                                    <!-- Status descriptions will be populated by JavaScript -->
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["AdditionalNotesOptional"]</label>
                            <textarea class="form-control" rows="3" placeholder="@Localizer["AddAnyNotesAboutThisStatusChange"]"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Orders")" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i>@Localizer["Cancel"]
                            </a>
                            <button type="submit" class="btn btn-teal">
                                <i class="fas fa-save me-1"></i>@Localizer["UpdateStatus"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Information Panel -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["OrderStatusInformation"]</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>@Localizer["StatusFlow"]</h6>
                            <div class="status-flow">
                                <div class="status-step @(Model.Status >= 0 ? "completed" : "")">
                                    <div class="status-icon">1</div>
                                    <div class="status-text">@Localizer["Pending"]</div>
                                </div>
                                <div class="status-step @(Model.Status >= 1 ? "completed" : "")">
                                    <div class="status-icon">2</div>
                                    <div class="status-text">@Localizer["Processing"]</div>
                                </div>
                                <div class="status-step @(Model.Status >= 2 ? "completed" : "")">
                                    <div class="status-icon">3</div>
                                    <div class="status-text">@Localizer["Shipped"]</div>
                                </div>
                                <div class="status-step @(Model.Status >= 3 ? "completed" : "")">
                                    <div class="status-icon">4</div>
                                    <div class="status-text">@Localizer["Delivered"]</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>@Localizer["StatusMeanings"]</h6>
                            <ul class="list-unstyled">
                                <li><span class="badge bg-warning me-2">@Localizer["Pending"]</span> @Localizer["PendingDescription"]</li>
                                <li><span class="badge bg-info me-2">@Localizer["Processing"]</span> @Localizer["ProcessingDescription"]</li>
                                <li><span class="badge bg-primary me-2">@Localizer["Shipped"]</span> @Localizer["ShippedDescription"]</li>
                                <li><span class="badge bg-success me-2">@Localizer["Delivered"]</span> @Localizer["DeliveredDescription"]</li>
                                <li><span class="badge bg-danger me-2">@Localizer["Cancelled"]</span> @Localizer["CancelledDescription"]</li>
                                <li><span class="badge bg-secondary me-2">@Localizer["Returned"]</span> @Localizer["ReturnedDescription"]</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pass localized strings to JavaScript
        window.editStatusLocalizedStrings = {
            pendingFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PendingFullDescription"].Value)),
            processingFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProcessingFullDescription"].Value)),
            shippedFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ShippedFullDescription"].Value)),
            deliveredFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["DeliveredFullDescription"].Value)),
            cancelledFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["CancelledFullDescription"].Value)),
            returnedFullDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ReturnedFullDescription"].Value))
        };
        
        $(document).ready(function() {
            updateStatusDescription();
            $('#Status').change(function() {
                updateStatusDescription();
            });
        });

        function updateStatusDescription() {
            var status = parseInt($('#Status').val());
            var descriptions = {
                0: window.editStatusLocalizedStrings.pendingFullDescription,
                1: window.editStatusLocalizedStrings.processingFullDescription,
                2: window.editStatusLocalizedStrings.shippedFullDescription,
                3: window.editStatusLocalizedStrings.deliveredFullDescription,
                4: window.editStatusLocalizedStrings.cancelledFullDescription,
                5: window.editStatusLocalizedStrings.returnedFullDescription
            };

            $('#statusDescription').text(descriptions[status] || '');
        }
    </script>
}

<style>
    .status-flow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 20px 0;
    }

    .status-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        position: relative;
    }

    .status-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 15px;
        left: 60%;
        width: 80%;
        height: 2px;
        background-color: #e9ecef;
        z-index: 1;
    }

    .status-step.completed:not(:last-child)::after {
        background-color: #20c997;
    }

    .status-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
        z-index: 2;
        position: relative;
    }

    .status-step.completed .status-icon {
        background-color: #20c997;
        color: white;
    }

    .status-text {
        margin-top: 8px;
        font-size: 12px;
        text-align: center;
        color: #6c757d;
    }

    .status-step.completed .status-text {
        color: #20c997;
        font-weight: 600;
    }
</style>

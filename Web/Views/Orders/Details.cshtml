@model Application.DTOs.Orders.OrderResponse

@{
    ViewData["Title"] = Localizer["OrderDetails"].Value;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
            <p class="text-muted">@ViewData["Subtitle"]</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("Index", "Orders")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>@Localizer["BackToOrders"]
            </a>
            <button type="button" class="btn btn-outline-teal" onclick="updateOrderStatus(@Model.Id)">
                <i class="fas fa-edit me-1"></i>@Localizer["UpdateStatus"]
            </button>
            <button type="button" class="btn btn-success" onclick="printReceipt(@Model.Id)">
                <i class="fas fa-receipt me-1"></i>@Localizer["PrintReceipt"]
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Order Information -->
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["OrderInformation"]</h6>
                    @switch (Model.Status)
                    {
                        case Core.Enum.OrderStatus.Delivered:
                            <span class="badge bg-success">@Localizer["Completed"]</span>
                            break;
                        case Core.Enum.OrderStatus.Cancelled:
                            <span class="badge bg-danger">@Localizer["Cancelled"]</span>
                            break;
                        case Core.Enum.OrderStatus.Returned:
                            <span class="badge bg-secondary">@Localizer["Returned"]</span>
                            break;
                        default:
                            <span class="badge bg-info">@Model.Status.ToString()</span>
                            break;
                    }
                </div>
                <div class="card-body py-3">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <small class="text-muted d-block">@Localizer["OrderNumber"]</small>
                            <strong>ORD-@Model.Id.ToString("D6")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">@Localizer["OrderDate"]</small>
                            <strong>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">@Localizer["Customer"]</small>
                            <strong>@Model.CustomerName</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">@Localizer["TotalAmount"]</small>
                            <strong class="text-success fs-5">@FormatCurrency(Model.TotalAmount, Model.CurrencyNotation)</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="card shadow mb-4">
                <div class="card-header py-2">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["OrderItems"]</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">@Localizer["Product"]</th>
                                    <th class="text-center" width="80">@Localizer["Qty"]</th>
                                    <th class="text-end" width="120">@Localizer["UnitPrice"]</th>
                                    <th class="text-end pe-3" width="120">@Localizer["Total"]</th>
                                </tr>
                            </thead>
                            <tbody id="orderItemsTableBody">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="fas fa-spinner fa-spin me-2"></i>@Localizer["LoadingOrderItems"]
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["OrderSummary"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @{
                            var subtotal = Model.CartSubtotal;
                            var discountAmount = Model.CartDiscountAmount;
                            var cartTotal = subtotal - discountAmount;
                            var adjustment = Model.TotalAmount - cartTotal;
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span>@Localizer["Subtotal"]:</span>
                            <span>$@subtotal.ToString("F2")</span>
                        </div>
                        @if (discountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>@Localizer["Discount"]:</span>
                                <span>-$@discountAmount.ToString("F2")</span>
                            </div>
                        }
                        @if (adjustment != 0)
                        {
                            <div class="d-flex justify-content-between mb-2 @(adjustment > 0 ? "text-danger" : "text-success")">
                                <span>@(adjustment > 0 ? Localizer["Surcharge"].Value : Localizer["Adjustment"].Value):</span>
                                <span>@(adjustment > 0 ? "+" : "")$@adjustment.ToString("F2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <span>@Localizer["Tax"]:</span>
                            <span>$0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <strong>@Localizer["Total"]:</strong>
                            <strong class="text-success">@FormatCurrency(Model.TotalAmount, Model.CurrencyNotation)</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6>@Localizer["OrderTimeline"]</h6>
                        <div class="timeline">
                            <div class="timeline-item">
                                <div class="timeline-marker bg-primary"></div>
                                <div class="timeline-content">
                                    <h6 class="timeline-title">@Localizer["OrderPlaced"]</h6>
                                    <p class="timeline-text">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                                </div>
                            </div>
                            @if (Model.Status != Core.Enum.OrderStatus.Pending)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker bg-info"></div>
                                    <div class="timeline-content">
                                        <h6 class="timeline-title">@Localizer["StatusUpdated"]</h6>
                                        <p class="timeline-text">@Model.Status.ToString()</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6>@Localizer["QuickActions"]</h6>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="viewCustomer(@Model.CustomerId)">
                                <i class="fas fa-user me-1"></i>@Localizer["ViewCustomer"]
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="duplicateOrder(@Model.Id)">
                                <i class="fas fa-copy me-1"></i>@Localizer["DuplicateOrder"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Notes -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["OrderNotes"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="orderNotes" class="form-label">@Localizer["AddNote"]</label>
                        <textarea class="form-control" id="orderNotes" rows="3" placeholder="@Localizer["AddNoteAboutThisOrder"]"></textarea>
                    </div>
                    <button type="button" class="btn btn-teal btn-sm" onclick="saveOrderNote(@Model.Id)">
                        <i class="fas fa-save me-1"></i>@Localizer["SaveNote"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pass localized strings to JavaScript
        window.orderDetailsLocalizedStrings = {
            noItemsFoundInThisOrder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NoItemsFoundInThisOrder"].Value)),
            failedToLoadOrderItems: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["FailedToLoadOrderItems"].Value)),
            areYouSureYouWantToDuplicateThisOrder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AreYouSureYouWantToDuplicateThisOrder"].Value)),
            orderDuplicationFeatureWillBeImplementedSoon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["OrderDuplicationFeatureWillBeImplementedSoon"].Value)),
            noteSaved: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NoteSaved"].Value))
        };
        
        $(document).ready(function() {
            loadOrderItems(@Model.Id);
        });

        function loadOrderItems(orderId) {
            $.ajax({
                url: '@Url.Action("GetOrderItems", "Orders")',
                type: 'GET',
                data: { orderId: orderId },
                success: function(response) {
                    if (response.success && response.data.length > 0) {
                        var html = '';
                        response.data.forEach(function(item) {
                            html += `
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold">${item.productName}</div>
                                        ${item.barcode ? `<small class="text-muted">SKU: ${item.barcode}</small>` : ''}
                                    </td>
                                    <td class="text-center">${item.quantity}</td>
                                    <td class="text-end">$${item.unitPrice.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                                    <td class="text-end pe-3 fw-bold">$${item.totalPrice.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                                </tr>
                            `;
                        });
                        $('#orderItemsTableBody').html(html);
                    } else {
                        $('#orderItemsTableBody').html(`
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle me-2"></i>${window.orderDetailsLocalizedStrings.noItemsFoundInThisOrder}
                                </td>
                            </tr>
                        `);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading order items:', error);
                    $('#orderItemsTableBody').html(`
                        <tr>
                            <td colspan="4" class="text-center text-danger py-4">
                                <i class="fas fa-exclamation-triangle me-2"></i>${window.orderDetailsLocalizedStrings.failedToLoadOrderItems}
                            </td>
                        </tr>
                    `);
                }
            });
        }

        function updateOrderStatus(orderId) {
            window.location.href = '@Url.Action("EditStatus", "Orders")' + '/' + orderId;
        }

        function printReceipt(orderId) {
            // Open receipt in new window for preview before printing
            window.open('@Url.Action("Receipt", "Orders")' + '/' + orderId, '_blank', 'width=400,height=800');
        }

        function viewCustomer(customerId) {
            window.location.href = '@Url.Action("Details", "Customers")' + '/' + customerId;
        }

        function duplicateOrder(orderId) {
            if (confirm(window.orderDetailsLocalizedStrings.areYouSureYouWantToDuplicateThisOrder)) {
                // This would create a duplicate order
                alert(window.orderDetailsLocalizedStrings.orderDuplicationFeatureWillBeImplementedSoon);
            }
        }

        function saveOrderNote(orderId) {
            var note = $('#orderNotes').val();
            if (note.trim()) {
                // This would save the note via AJAX
                alert(window.orderDetailsLocalizedStrings.noteSaved + ': ' + note);
                $('#orderNotes').val('');
            }
        }
    </script>
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -25px;
        top: 5px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .timeline-content {
        padding-left: 10px;
    }

    .timeline-title {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .timeline-text {
        font-size: 12px;
        color: #6c757d;
        margin: 0;
    }
</style>

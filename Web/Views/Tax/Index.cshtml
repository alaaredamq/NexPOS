@{
    ViewData["Title"] = "Tax Management";
    ViewData["Subtitle"] = "Manage tax rates and VAT settings";
}

<div class="row">
    <div class="col-12">
        <div class="card modern-card">
            <div class="card-header modern-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-percentage me-2 text-primary"></i>
                    Tax Management
                </h5>
                <div class="card-actions">
                    <button id="addTax" class="btn btn-sm btn-primary me-2">
                        <i class="fas fa-plus me-1"></i> Add Tax
                    </button>
                    <button id="exportTaxes" class="btn btn-sm btn-outline-success me-2">
                        <i class="fas fa-download me-1"></i> Export
                    </button>
                    <button id="refreshTaxes" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-sync-alt me-1"></i> Refresh
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div id="taxesTableContainer">
                    @await Component.InvokeAsync("DataTable", new
                    {
                        id = "taxesTable",
                        ajaxUrl = Url.Action("GetAllTaxes", "Tax", new { area = "" }),
                        columns = new List<object>
                        {
                            new { data = "name", title = "Name" },
                            new { data = "rate", title = "Rate (%)", render = "formatTaxRate" },
                            new { data = "type", title = "Type", render = "formatTaxType" },
                            new { data = "isDefault", title = "Default", render = "formatBoolean" },
                            new { data = "isActive", title = "Active", render = "formatBoolean" },
                            new { data = "effectiveFrom", title = "Effective From", render = "formatDate" },
                            new { data = "effectiveTo", title = "Effective To", render = "formatDate" },
                            new { data = "category", title = "Category" },
                            new
                            {
                                data = "id",
                                title = "Actions",
                                orderable = false,
                                searchable = false,
                                render = "renderTaxActions"
                            }
                        },
                        columnDefs = new List<object>
                        {
                            new { targets = new[] { 0, 1, 2, 3, 4, 5, 6, 7, 8 }, className = "text-center" }
                        }
                    })
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Tax Modal -->
<div class="modal fade" id="taxModal" tabindex="-1" aria-labelledby="taxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taxModalLabel">Add Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="taxForm">
                    <input type="hidden" id="taxId" name="Id"/>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="taxName" class="form-label">Tax Name *</label>
                                <input type="text" class="form-control" id="taxName" name="Name" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="taxRate" class="form-label">Tax Rate (%) *</label>
                                <input type="number" class="form-control" id="taxRate" name="Rate" step="0.01" min="0"
                                       max="100" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="taxType" class="form-label">Tax Type *</label>
                                <select class="form-control" id="taxType" name="Type" required>
                                    <option value="0">VAT</option>
                                    <option value="1">Sales Tax</option>
                                    <option value="2">Service Tax</option>
                                    <option value="3">Excise Tax</option>
                                    <option value="4">Custom Tax</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="taxCode" class="form-label">Tax Code</label>
                                <input type="text" class="form-control" id="taxCode" name="TaxCode">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="taxDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="taxDescription" name="Description" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="effectiveFrom" class="form-label">Effective From</label>
                                <input type="date" class="form-control" id="effectiveFrom" name="EffectiveFrom">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="effectiveTo" class="form-label">Effective To</label>
                                <input type="date" class="form-control" id="effectiveTo" name="EffectiveTo">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="categoryId" class="form-label">Apply to Category</label>
                                @await Component.InvokeAsync("Select2", new
                                {
                                    id = "categoryId",
                                    name = "CategoryId",
                                    placeholder = "Select category (optional)",
                                    allowClear = true,
                                    ajaxUrl = Url.Action("GetCategories", "Categories", new { area = "" }),
                                    valueField = "id",
                                    textField = "name"
                                })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Options</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isDefault" name="IsDefault">
                                    <label class="form-check-label" for="isDefault">
                                        Set as Default Tax
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isActive" name="IsActive"
                                           checked>
                                    <label class="form-check-label" for="isActive">
                                        Active
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isInclusive" name="IsInclusive">
                                    <label class="form-check-label" for="isInclusive">
                                        Tax Inclusive (included in price)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="applyToAllProducts"
                                           name="ApplyToAllProducts" checked>
                                    <label class="form-check-label" for="applyToAllProducts">
                                        Apply to All Products
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveTax">Save Tax</button>
            </div>
        </div>
    </div>
</div>

<!-- Tax Calculator Modal -->
<div class="modal fade" id="taxCalculatorModal" tabindex="-1" aria-labelledby="taxCalculatorModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taxCalculatorModalLabel">Tax Calculator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="calcBaseAmount" class="form-label">Base Amount</label>
                    <input type="number" class="form-control" id="calcBaseAmount" step="0.01" min="0">
                </div>
                <div class="mb-3">
                    <label for="calcTaxType" class="form-label">Tax Type</label>
                    <select class="form-control" id="calcTaxType">
                        <option value="">Select Tax Type</option>
                        <option value="0">VAT</option>
                        <option value="1">Sales Tax</option>
                        <option value="2">Service Tax</option>
                        <option value="3">Excise Tax</option>
                        <option value="4">Custom Tax</option>
                    </select>
                </div>
                <div class="text-center">
                    <button type="button" class="btn btn-primary" id="calculateTax">Calculate</button>
                </div>
                <div id="taxCalculationResult" class="mt-3" style="display: none;">
                    <div class="erp-alert erp-alert-info">
                        <h6>Tax Calculation Result:</h6>
                        <p><strong>Base Amount:</strong> $<span id="resultBaseAmount">0.00</span></p>
                        <p><strong>Tax Amount:</strong> $<span id="resultTaxAmount">0.00</span></p>
                        <p><strong>Total Amount:</strong> $<span id="resultTotalAmount">0.00</span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function formatTaxRate(data, type, row) {
        if (type === 'display' || type === 'filter') {
            return parseFloat(data).toFixed(2) + '%';
        }
        return data;
    }

    function formatTaxType(data, type, row) {
        if (type === 'display' || type === 'filter') {
            const types = ['VAT', 'Sales Tax', 'Service Tax', 'Excise Tax', 'Custom Tax'];
            return types[data] || 'Unknown';
        }
        return data;
    }

    function formatBoolean(data, type, row) {
        if (type === 'display' || type === 'filter') {
            return data ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';
        }
        return data;
    }

    function formatDate(data, type, row) {
        if (type === 'display' || type === 'filter') {
            return data ? moment(data).format('MMM DD, YYYY') : '-';
        }
        return data;
    }

    function renderTaxActions(data, type, row) {
        return `
                <button class="btn btn-sm btn-outline-primary edit-tax-btn" data-id="${data}" title="Edit Tax">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-success set-default-btn" data-id="${data}" title="Set as Default" ${row.isDefault ? 'disabled' : ''}>
                    <i class="fas fa-star"></i>
                </button>
                <button class="btn btn-sm btn-outline-warning deactivate-tax-btn" data-id="${data}" title="Deactivate" ${!row.isActive ? 'disabled' : ''}>
                    <i class="fas fa-pause"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger delete-tax-btn" data-id="${data}" title="Delete Tax">
                    <i class="fas fa-trash"></i>
                </button>
            `;
    }

    $(document).ready(function () {
            // Add Tax button
            $('#addTax').on('click', function () {
                $('#taxModalLabel').text('Add Tax');
                $('#taxForm')[0].reset();
                $('#taxId').val('');
                $('#isActive').prop('checked', true);
                $('#applyToAllProducts').prop('checked', true);
                $('#taxModal').modal('show');
            });

            // Edit Tax button
            $('#taxesTableContainer').on('click', '.edit-tax-btn', function () {
                var taxId = $(this).data('id');
                // Load tax data and populate form
                $.ajax({
                    url: `@Url.Action("GetTaxById", "Tax", new { area = "" })}/${taxId}`,
                    type: 'GET',
                    success: function (tax) {
                        $('#taxModalLabel').text('Edit Tax');
                        $('#taxId').val(tax.id);
                        $('#taxName').val(tax.name);
                        $('#taxRate').val(tax.rate);
                        $('#taxType').val(tax.type);
                        $('#taxCode').val(tax.taxCode || '');
                        $('#taxDescription').val(tax.description || '');
                        $('#effectiveFrom').val(tax.effectiveFrom ? moment(tax.effectiveFrom).format('YYYY-MM-DD') : '');
                        $('#effectiveTo').val(tax.effectiveTo ? moment(tax.effectiveTo).format('YYYY-MM-DD') : '');
                        $('#categoryId').val(tax.categoryId || '').trigger('change');
                        $('#isDefault').prop('checked', tax.isDefault);
                        $('#isActive').prop('checked', tax.isActive);
                        $('#isInclusive').prop('checked', tax.isInclusive);
                        $('#applyToAllProducts').prop('checked', tax.applyToAllProducts);
                        $('#taxModal').modal('show');
                    },
                    error: function () {
                        toastr.error('Failed to load tax data');
                    }
                });
            });

            // Save Tax
        $('#saveTax').on('click', function () {
            var taxId = $('#taxId').val();
            var url = taxId ? `@Url.Action("UpdateTax", "Tax", new { area = "" })}/${taxId}` : '@Url.Action("CreateTax", "Tax", new { area = "" })';
            var method = taxId ? 'PUT' : 'POST';

            var formData = {
                name: $('#taxName').val(),
                rate: parseFloat($('#taxRate').val()),
                type: parseInt($('#taxType').val()),
                taxCode: $('#taxCode').val(),
                description: $('#taxDescription').val(),
                effectiveFrom: $('#effectiveFrom').val() || null,
                effectiveTo: $('#effectiveTo').val() || null,
                categoryId: $('#categoryId').val() || null,
                isDefault: $('#isDefault').is(':checked'),
                isActive: $('#isActive').is(':checked'),
                isInclusive: $('#isInclusive').is(':checked'),
                applyToAllProducts: $('#applyToAllProducts').is(':checked')
            };

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $('#taxModal').modal('hide');
                        $('#taxesTable').DataTable().ajax.reload();
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error('Error saving tax: ' + xhr.responseText);
                }
            });
            }

            );

                // Set Default Tax
                $('#taxesTableContainer').on('click', '.set-default-btn', function () {
                    var taxId = $(this).data('id');
                    Swal.fire({
                        title: 'Set as Default Tax?',
                        text: "This will remove the default flag from other taxes.",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, set as default!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: `@Url.Action("SetDefaultTax", "Tax", new { area = "" })}/${taxId}`,
                                type: 'POST',
                                success: function (response) {
                                    if (response.success) {
                                        toastr.success(response.message);
                                        $('#taxesTable').DataTable().ajax.reload();
                                    } else {
                                        toastr.error(response.message);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    toastr.error('Error setting default tax: ' + xhr.responseText);
                                }
                            });
                        }
                    });
                });

                // Deactivate Tax
                $('#taxesTableContainer').on('click', '.deactivate-tax-btn', function () {
                    var taxId = $(this).data('id');
                    Swal.fire({
                        title: 'Deactivate Tax?',
                        text: "This will deactivate the tax and set an end date.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, deactivate!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: `@Url.Action("DeactivateTax", "Tax", new { area = "" })}/${taxId}`,
                                type: 'POST',
                                success: function (response) {
                                    if (response.success) {
                                        toastr.success(response.message);
                                        $('#taxesTable').DataTable().ajax.reload();
                                    } else {
                                        toastr.error(response.message);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    toastr.error('Error deactivating tax: ' + xhr.responseText);
                                }
                            });
                        }
                    });
                });

                // Delete Tax
                $('#taxesTableContainer').on('click', '.delete-tax-btn', function () {
                    var taxId = $(this).data('id');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: `@Url.Action("DeleteTax", "Tax", new { area = "" })}/${taxId}`,
                                type: 'DELETE',
                                success: function (response) {
                                    if (response.success) {
                                        toastr.success(response.message);
                                        $('#taxesTable').DataTable().ajax.reload();
                                    } else {
                                        toastr.error(response.message);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    toastr.error('Error deleting tax: ' + xhr.responseText);
                                }
                            });
                        }
                    });
                });

                // Tax Calculator
                $('#calculateTax').on('click', function () {
                    var baseAmount = parseFloat($('#calcBaseAmount').val());
                    var taxType = $('#calcTaxType').val();

                    if (!baseAmount || baseAmount <= 0) {
                        toastr.error('Please enter a valid base amount');
                        return;
                    }

                    if (!taxType) {
                        toastr.error('Please select a tax type');
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("CalculateTax", "Tax", new { area = "" })',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            baseAmount: baseAmount,
                            taxType: parseInt(taxType)
                        }),
                        success: function (response) {
                            if (response.success) {
                                $('#resultBaseAmount').text(response.baseAmount.toFixed(2));
                                $('#resultTaxAmount').text(response.taxAmount.toFixed(2));
                                $('#resultTotalAmount').text(response.totalAmount.toFixed(2));
                                $('#taxCalculationResult').show();
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function (xhr, status, error) {
                            toastr.error('Error calculating tax: ' + xhr.responseText);
                        }
                    });
                });

                // Export Taxes
                $('#exportTaxes').on('click', function () {
                    toastr.info('Exporting taxes...');
                    // Implement export logic here
                });

                // Refresh Taxes
                $('#refreshTaxes').on('click', function () {
                    $('#taxesTable').DataTable().ajax.reload();
                    toastr.success('Taxes table refreshed!');
                });
            });
        });
</script>
}


{
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",  
  "Urls": "http://localhost:5000",
  "Jwt": {
    "_comment": "SecretKey intentionally omitted - it's a secret and must not be committed. Set it via 'dotnet user-secrets set \"Jwt:SecretKey\" \"<value>\"' in development, or the Jwt__SecretKey environment variable in production/Electron packaging. Must be at least 32 characters. The app throws at startup if it's missing.",
    "Issuer": "NexPos",
    "Audience": "NexPos-Users",
    "ExpirationMinutes": 60
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "IpRateLimitPolicies": {
    "ClientRules": [
      {
        "ClientId": "admin",
        "Rules": [
          {
            "Endpoint": "*",
            "Period": "1m",
            "Limit": 500
          }
        ]
      }
    ]
  }
}

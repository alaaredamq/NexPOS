<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
      <UserSecretsId>707edb39-2b26-4e6c-ad8b-bf4c47c1dc7b</UserSecretsId>
      <!-- The UI ships in English and Arabic only; skip the other satellite resource folders
           (cs, de, ja, zh-Hans, ...) that NuGet packages would otherwise copy into publish. -->
      <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
      <!-- XML comments feed the OpenAPI document (Web/Api/Infrastructure/ApiSwagger.cs); the rest of the app is not documented, so CS1591 stays quiet. -->
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Release builds: let tiered PGO optimise hot paths. ReadyToRun (needs a RID) is passed
       on the publish command line in build-electron.ps1. Views compile into the assembly on publish. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Serilog" Version="4.3.1-dev-02387" />
      <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
      <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.6" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
      <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
      <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="logs\" />
      <Folder Include="Views\Shared\Components\" />
    </ItemGroup>

    <!-- Stamps the compile date into the assembly. A perpetual license only runs builds released
         on or before its "updates until" date (see LicenseService), so this has to be a compiled-in
         constant rather than a file timestamp that an installer or a copy could change. -->
    <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
      <PropertyGroup>
        <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
        <BuildInfoDate>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</BuildInfoDate>
      </PropertyGroup>
      <WriteLinesToFile File="$(BuildInfoFile)" Lines="namespace Web { internal static class BuildInfo { public const string BuildDate = &quot;$(BuildInfoDate)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
      <ItemGroup>
        <Compile Include="$(BuildInfoFile)" />
        <FileWrites Include="$(BuildInfoFile)" />
      </ItemGroup>
    </Target>

    <!-- The Metronic theme ships a ~225 MB demo site under wwwroot/Metronics/html that
         nothing references. Keep it out of build/publish output (and the Electron installer). -->
    <ItemGroup>
      <Content Remove="wwwroot\Metronics\html\**" />
      <None Include="wwwroot\Metronics\html\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <!-- React client (../client): Release builds compile it into wwwroot/app (Vite outDir) so publish ships the SPA.
         Debug builds never touch npm (use `npm run dev` in client/). Skip it for a fast C# build with
         -p:SkipClientBuild=true; build-electron.ps1 builds the client itself and passes that. -->
    <PropertyGroup>
      <ClientDir>$(MSBuildProjectDirectory)\..\client\</ClientDir>
      <BuildClient Condition="'$(BuildClient)' == '' And '$(Configuration)' == 'Release' And '$(SkipClientBuild)' != 'true' And Exists('$(ClientDir)package.json')">true</BuildClient>
    </PropertyGroup>

    <Target Name="BuildClient" BeforeTargets="BeforeBuild" Condition="'$(BuildClient)' == 'true'">
      <Message Importance="high" Text="Building React client in $(ClientDir) (skip with -p:SkipClientBuild=true)..." />
      <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" Condition="!Exists('$(ClientDir)node_modules')" />
      <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />
    </Target>

    <!-- wwwroot is globbed when the project is evaluated, i.e. before BuildClient has written wwwroot/app on a clean
         checkout, so add whatever it produced to the publish list explicitly. No-op when the files were already there. -->
    <Target Name="PublishClientOutput" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\app\index.html')">
      <ItemGroup>
        <_SpaFile Include="$(MSBuildProjectDirectory)\wwwroot\app\**" />
        <ResolvedFileToPublish Include="@(_SpaFile->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
          <RelativePath>wwwroot\app\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </ResolvedFileToPublish>
      </ItemGroup>
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\Application\Application.csproj" />
      <ProjectReference Include="..\Core\Core.csproj" />
      <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
      <ProjectReference Include="..\Sync\Sync.csproj" />
    </ItemGroup>

</Project>
